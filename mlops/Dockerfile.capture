FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /app
RUN pip install --no-cache-dir --only-binary :all: "kafka-python==2.3.2" "python-snappy==0.7.3"
COPY capture_orders.py ./

USER 65532:65532

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["python", "-c", "import os; os.kill(1, 0)"]

ENTRYPOINT ["python", "/app/capture_orders.py", "--engine", "python"]
