FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH="/usr/lib/jvm/java-17-openjdk-amd64/bin:${PATH}" \
    GIT_PYTHON_REFRESH=quiet \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && printf 'mlops:x:10001:10001:MLops:/tmp:/usr/sbin/nologin\n' >> /etc/passwd \
    && printf 'mlops:x:10001:\n' >> /etc/group

WORKDIR /app
# Batch training exits after the run; container/job completion is its health signal.
#checkov:skip=CKV_DOCKER_2: Batch workload health is reported by Kubernetes Job completion status.
COPY requirements.container.txt ./requirements.txt
RUN pip install --no-cache-dir --only-binary :all: --no-binary pyspark -r requirements.txt
COPY patch_spark_jars.py ./
RUN python patch_spark_jars.py && rm patch_spark_jars.py

COPY train_demand_model.py generate_sample_sales.py capture_orders.py model_invariants.py data_contracts.py feature_engineering.py ./
COPY container_train.sh ./
RUN chmod 0555 /app/container_train.sh

USER mlops:mlops

ENTRYPOINT ["/app/container_train.sh"]
