FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH="/usr/lib/jvm/java-17-openjdk-amd64/bin:${PATH}" \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

RUN printf 'mlops:x:10001:10001:MLops:/tmp:/usr/sbin/nologin\n' >> /etc/passwd \
    && printf 'mlops:x:10001:\n' >> /etc/group

WORKDIR /app
COPY requirements.container.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY train_demand_model.py generate_sample_sales.py capture_orders.py ./
COPY container_train.sh ./
RUN chmod 0555 /app/container_train.sh

ENTRYPOINT ["/app/container_train.sh"]
