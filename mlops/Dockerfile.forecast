FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir --only-binary :all: \
    "fastapi==0.160.0" \
    "mlflow==3.17.2" \
    "pandas==2.3.3" \
    "prometheus-client==0.22.1" \
    "pyarrow==25.0.1" \
    "pydantic==2.14.0" \
    "pyjwt[crypto]==2.15.0" \
    "scikit-learn==1.9.1" \
    "skops==0.16.0" \
    "uvicorn==0.54.0"

COPY forecast_api.py model_invariants.py data_contracts.py feature_engineering.py ./

USER 65532:65532

EXPOSE 8005

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8005/health', timeout=3).read()"]

CMD ["uvicorn", "forecast_api:app", "--host", "0.0.0.0", "--port", "8005"]
