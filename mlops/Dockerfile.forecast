FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi==0.143.0" \
    "uvicorn==0.54.0" \
    "mlflow==3.17.0" \
    "scikit-learn==1.9.1" \
    "pandas==3.0.6" \
    "pyarrow==25.0.1" \
    "skops==0.16.0" \
    "PyJWT[crypto]==2.10.1" \
    "prometheus-client==0.22.1"

COPY forecast_api.py ./forecast_api.py

USER 65532:65532

EXPOSE 8005

CMD ["uvicorn", "forecast_api:app", "--host", "0.0.0.0", "--port", "8005"]
