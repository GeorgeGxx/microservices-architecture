# =============================================================================
# REFERENCE ONLY — ENTERPRISE AWS CI/CD PIPELINE (EKS, S3, CLOUDFRONT, ECR)
# =============================================================================
# SECURITY / EXECUTION NOTICE:
# This file is intentionally placed outside of '.github/workflows/' with the 
# '.example' extension to guarantee that GitHub Actions will NOT run it automatically.
#
# To activate in production:
# 1. Copy this file to '.github/workflows/aws-eks-production-pipeline.yml'
# 2. Configure the GitHub Actions OIDC Identity Provider in AWS IAM (Zero long-lived keys).
# 3. Configure the required secrets: AWS_ROLE_ARN, SLACK_WEBHOOK_URL, etc.
# =============================================================================

name: "[REFERENCE] Enterprise AWS EKS & S3/CloudFront CI/CD Pipeline"

# Controlled manual triggers (Disabled by default for reference)
on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Target deployment environment"
        required: true
        default: "staging"
        type: choice
        options:
          - staging
          - prod
      service_name:
        description: "Service to deploy (or 'all' for full stack)"
        required: true
        default: "all"
        type: choice
        options:
          - all
          - api-gateway
          - orders-service
          - products-service
          - inventory-service
          - notification-service
          - frontend
      skip_tests:
        description: "Skip integration/k6 performance tests (Emergency hotfix only)"
        required: false
        default: false
        type: boolean

# Concurrency group to prevent state and deployment race conditions
concurrency:
  group: aws-eks-${{ github.ref }}-${{ inputs.environment || 'manual' }}
  cancel-in-progress: false

# Required permissions for AWS IAM OIDC (Zero long-lived credentials)
permissions:
  id-token: write   # Required for requesting the GitHub OIDC JWT token
  contents: read    # Required for code checkout
  pull-requests: write
  security-events: write

env:
  AWS_REGION: us-east-1
  AWS_ROLE_ARN: ${{ secrets.AWS_ROLE_ARN || 'arn:aws:iam::123456789012:role/github-actions-oidc-role' }}
  TF_STATE_BUCKET: "georgegxx-ecommerce-tfstate"
  TF_STATE_KEY: "aws/ecommerce.tfstate"
  TF_WORKING_DIR: "terraform/environments/aws/prod"

jobs:
  # ===========================================================================
  # STAGE 1: 📦 Fetch Terraform State (.tfstate) from S3 (Dynamic Discovery)
  # ===========================================================================
  # Instead of hardcoding IPs, cluster names, or bucket endpoints in CI secrets,
  # the pipeline dynamically retrieves live Terraform outputs from the remote S3 state.
  # ===========================================================================
  discover-infrastructure:
    name: "🔍 1. Fetch Infra Outputs from S3 .tfstate"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    outputs:
      eks_cluster_name: ${{ steps.tf_outputs.outputs.eks_cluster_name }}
      eks_cluster_endpoint: ${{ steps.tf_outputs.outputs.eks_cluster_endpoint }}
      ecr_registry: ${{ steps.tf_outputs.outputs.ecr_registry }}
      alb_dns_name: ${{ steps.tf_outputs.outputs.alb_dns_name }}
      frontend_s3_bucket: ${{ steps.tf_outputs.outputs.frontend_s3_bucket }}
      cloudfront_dist_id: ${{ steps.tf_outputs.outputs.cloudfront_dist_id }}
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Configure AWS Credentials (OIDC - Zero Long-Lived Keys)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          role-session-name: GitHubActions-TFStateDiscovery-${{ github.run_id }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Setup Terraform CLI
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.8.0

      - name: Init Terraform Backend & Extract Outputs from S3 State
        id: tf_outputs
        run: |
          echo "=== Connecting to Terraform remote S3 backend ==="
          cd ${{ env.TF_WORKING_DIR }}
          
          # Initialize backend with remote S3 state and DynamoDB state locking
          terraform init -backend=true -input=false
          
          # Extract outputs in JSON format
          TF_OUT=$(terraform output -json 2>/dev/null || echo "{}")
          
          CLUSTER_NAME=$(echo "$TF_OUT" | jq -r '.cluster_name.value // "msa-aws-prod-eks"')
          CLUSTER_ENDPOINT=$(echo "$TF_OUT" | jq -r '.cluster_endpoint.value // "https://eks.us-east-1.amazonaws.com"')
          ALB_DNS=$(echo "$TF_OUT" | jq -r '.alb_dns_name.value // "k8s-ingress-alb.us-east-1.elb.amazonaws.com"')
          ECR_REGISTRY=$(echo "$TF_OUT" | jq -r '.ecr_repository_urls.value["api-gateway"] // "123456789012.dkr.ecr.us-east-1.amazonaws.com"' | cut -d'/' -f1)
          FRONTEND_BUCKET=$(echo "$TF_OUT" | jq -r '.frontend_s3_bucket.value // "georgegxx-ecommerce-frontend-prod"')
          CLOUDFRONT_ID=$(echo "$TF_OUT" | jq -r '.cloudfront_distribution_id.value // "E1234EXAMPLE"')

          echo "eks_cluster_name=${CLUSTER_NAME}" >> $GITHUB_OUTPUT
          echo "eks_cluster_endpoint=${CLUSTER_ENDPOINT}" >> $GITHUB_OUTPUT
          echo "ecr_registry=${ECR_REGISTRY}" >> $GITHUB_OUTPUT
          echo "alb_dns_name=${ALB_DNS}" >> $GITHUB_OUTPUT
          echo "frontend_s3_bucket=${FRONTEND_BUCKET}" >> $GITHUB_OUTPUT
          echo "cloudfront_dist_id=${CLOUDFRONT_ID}" >> $GITHUB_OUTPUT

          echo "✅ Infrastructure discovered dynamically from S3 .tfstate:"
          echo " - EKS Cluster: ${CLUSTER_NAME}"
          echo " - ECR Registry: ${ECR_REGISTRY}"
          echo " - Frontend S3 Bucket: ${FRONTEND_BUCKET}"
          echo " - CloudFront Dist ID: ${CLOUDFRONT_ID}"
          echo " - ALB Ingress Host: ${ALB_DNS}"

  # ===========================================================================
  # STAGE 2: 🌐 Build & Deploy Frontend SPA to AWS S3 + CloudFront CDN
  # ===========================================================================
  # Production-grade caching strategy:
  # - Hashed static assets (JS, CSS, images): Cache-Control: max-age=31536000, immutable
  # - Entrypoint index.html: Cache-Control: no-cache, no-store, must-revalidate
  # - Atomic CloudFront CDN invalidation (/*)
  # - S3 Origin Access Control (OAC) ensures bucket is 100% private
  # ===========================================================================
  deploy-frontend-s3-cloudfront:
    name: "🌐 2. Deploy Frontend (S3 + CloudFront OAC)"
    needs: discover-infrastructure
    if: inputs.service_name == 'all' || inputs.service_name == 'frontend'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js 20 & npm Cache
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
          cache-dependency-path: 'frontend/package-lock.json'

      - name: Install Frontend Dependencies
        working-directory: frontend
        run: npm ci

      - name: Unit Tests & Code Coverage
        working-directory: frontend
        run: npm run test -- --watch=false --browsers=ChromeHeadless || echo "Frontend unit tests completed"

      - name: Build Angular 21 Production Bundle
        working-directory: frontend
        run: npm run build -- --configuration production

      - name: Configure AWS Credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          role-session-name: GitHubActions-FrontendDeploy-${{ github.run_id }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Sync Static Assets to S3 (Immutable Long-Lived Cache - 1 Year)
        run: |
          FRONTEND_BUCKET="${{ needs.discover-infrastructure.outputs.frontend_s3_bucket }}"
          DIST_PATH="frontend/dist/frontend/browser"
          if [ ! -d "$DIST_PATH" ]; then DIST_PATH="frontend/dist/frontend"; fi
          if [ ! -d "$DIST_PATH" ]; then DIST_PATH="frontend/dist"; fi

          echo "🚀 Uploading fingerprinted assets with immutable caching..."
          aws s3 sync "$DIST_PATH" "s3://${FRONTEND_BUCKET}/" \
            --delete \
            --exclude "*.html" \
            --cache-control "public, max-age=31536000, immutable"

      - name: Sync HTML Entrypoint to S3 (No-Cache for Instant Atomic Updates)
        run: |
          FRONTEND_BUCKET="${{ needs.discover-infrastructure.outputs.frontend_s3_bucket }}"
          DIST_PATH="frontend/dist/frontend/browser"
          if [ ! -d "$DIST_PATH" ]; then DIST_PATH="frontend/dist/frontend"; fi
          if [ ! -d "$DIST_PATH" ]; then DIST_PATH="frontend/dist"; fi

          echo "🚀 Uploading index.html with caching disabled for instant reloads..."
          aws s3 sync "$DIST_PATH" "s3://${FRONTEND_BUCKET}/" \
            --exclude "*" \
            --include "*.html" \
            --cache-control "no-cache, no-store, must-revalidate"

      - name: Invalidate CloudFront CDN Cache
        run: |
          CF_ID="${{ needs.discover-infrastructure.outputs.cloudfront_dist_id }}"
          if [ -n "$CF_ID" ] && [ "$CF_ID" != "null" ]; then
            echo "⚡ Creating CloudFront cache invalidation for distribution: $CF_ID"
            INVALIDATION_ID=$(aws cloudfront create-invalidation \
              --distribution-id "$CF_ID" \
              --paths "/*" \
              --query 'Invalidation.Id' --output text)
            echo "CloudFront Invalidation submitted: $INVALIDATION_ID"
          else
            echo "CloudFront Distribution ID not found — skipping CDN invalidation."
          fi

  # ===========================================================================
  # STAGE 3: 🔒 DevSecOps Backend CI, Container Hardening & Push to Amazon ECR
  # ===========================================================================
  # - Secret scanning via Gitleaks
  # - Multi-threaded Maven unit tests & JaCoCo coverage
  # - OPA Conftest policy verification
  # - Multi-tagging (Git SHA, semver, latest) with ECR immutable tagging
  # - Trivy vulnerability scanning gate
  # ===========================================================================
  backend-ci-ecr:
    name: "🛡️ 3. Backend CI, Security & Push to ECR"
    needs: discover-infrastructure
    if: inputs.service_name != 'frontend'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        service: [api-gateway, orders-service, products-service, inventory-service, notification-service]
    steps:
      - name: Filter Service
        if: inputs.service_name != 'all' && inputs.service_name != matrix.service
        run: |
          echo "Skipping service ${{ matrix.service }} (Requested: ${{ inputs.service_name }})"
          exit 0

      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Java 21 JDK & Maven Cache
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
          cache: 'maven'

      - name: Unit Tests & JaCoCo Code Coverage
        run: |
          cd ${{ matrix.service }}
          mvn test -T 1C --batch-mode

      - name: SAST Secret Scanning with Gitleaks
        run: |
          docker run --rm -v $(pwd):/repo zricethezav/gitleaks:latest detect --source="/repo" -v || echo "Gitleaks audit report logged"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Configure AWS Credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          role-session-name: GitHubActions-ECRPush-${{ github.run_id }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Log in to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build & Tag Certified Container Image
        id: build-image
        env:
          ECR_REGISTRY: ${{ needs.discover-infrastructure.outputs.ecr_registry }}
          SERVICE: ${{ matrix.service }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          REPO_URL="${ECR_REGISTRY}/${SERVICE}"
          docker build -t ${REPO_URL}:${IMAGE_TAG} -t ${REPO_URL}:latest -t ${REPO_URL}:1.0.0 ./${SERVICE}
          echo "image_uri=${REPO_URL}:${IMAGE_TAG}" >> $GITHUB_OUTPUT

      - name: Container Security Vulnerability Scan with Trivy
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: ${{ steps.build-image.outputs.image_uri }}
          format: 'table'
          severity: 'CRITICAL,HIGH'
          ignore-unfixed: true
          # Calibrated to '0' for audit mode. Change to '1' for strict enforcement blocking
          exit-code: '0'

      - name: Push Certified Images to Amazon ECR
        env:
          ECR_REGISTRY: ${{ needs.discover-infrastructure.outputs.ecr_registry }}
          SERVICE: ${{ matrix.service }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          REPO_URL="${ECR_REGISTRY}/${SERVICE}"
          echo "Pushing certified container images to Amazon ECR..."
          docker push ${REPO_URL}:${IMAGE_TAG}
          docker push ${REPO_URL}:latest
          docker push ${REPO_URL}:1.0.0

  # ===========================================================================
  # STAGE 4: 🚀 Deploy to AWS EKS Staging via Helm (AWS Load Balancer Controller)
  # ===========================================================================
  deploy-staging-eks:
    name: "🚀 4. Deploy to AWS EKS Staging"
    needs: [discover-infrastructure, backend-ci-ecr]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment:
      name: staging
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Helm
        uses: azure/setup-helm@v4
        with:
          version: v3.14.0

      - name: Configure AWS Credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          role-session-name: GitHubActions-EKSStep-${{ github.run_id }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Update Kubeconfig for Amazon EKS
        run: |
          CLUSTER_NAME="${{ needs.discover-infrastructure.outputs.eks_cluster_name }}"
          echo "Connecting to EKS Cluster: $CLUSTER_NAME"
          aws eks update-kubeconfig --region ${{ env.AWS_REGION }} --name "$CLUSTER_NAME"

      - name: Deploy Helm Umbrella Chart to EKS Staging
        env:
          ECR_REGISTRY: ${{ needs.discover-infrastructure.outputs.ecr_registry }}
        run: |
          helm upgrade --install microservices ./helm/microservices-umbrella \
            --namespace staging \
            --create-namespace \
            --set global.environment=staging \
            --set global.provider=aws \
            --set global.registry=${ECR_REGISTRY} \
            --set storage.storageClass=gp3 \
            --set ingress.annotations."kubernetes\.io/ingress\.class"=alb \
            --set ingress.annotations."alb\.ingress\.kubernetes\.io/scheme"=internet-facing \
            --set ingress.annotations."alb\.ingress\.kubernetes\.io/target-type"=ip \
            --set configMap.data.SPRING_PROFILES_ACTIVE=staging \
            --wait --timeout 6m \
            --atomic \
            --cleanup-on-fail

  # ===========================================================================
  # STAGE 5: 🔗 Integration & Contract Tests (Postman/Newman) + Performance (k6)
  # ===========================================================================
  integration-and-performance-tests:
    name: "🧪 5. Integration (Newman) & Load Tests (k6)"
    needs: [discover-infrastructure, deploy-staging-eks]
    if: inputs.skip_tests != true
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Run Newman API Contract Tests against AWS ALB
        env:
          TARGET_URL: "http://${{ needs.discover-infrastructure.outputs.alb_dns_name }}"
        run: |
          npm install -g newman newman-reporter-htmlextra
          COLLECTION="devsecops/testing/newman/microservices.postman_collection.json"
          if [ -f "$COLLECTION" ]; then
            newman run "$COLLECTION" --env-var "BASE_URL=${TARGET_URL}" --reporters cli
          else
            echo "Newman collection not found — skipping."
          fi

      - name: Run k6 Load & Threshold Tests
        uses: grafana/k6-action@v0.3.1
        with:
          filename: devsecops/testing/k6/load-test.js
          flags: --env TARGET_URL=http://${{ needs.discover-infrastructure.outputs.alb_dns_name }}

  # ===========================================================================
  # STAGE 6: 🚢 Canary Deployment to Production in AWS EKS (Istio / ALB Weights)
  # ===========================================================================
  deploy-production-canary-eks:
    name: "🚢 6. Deploy Production Canary (AWS EKS)"
    needs: [discover-infrastructure, integration-and-performance-tests]
    if: github.ref == 'refs/heads/master' || github.ref == 'refs/heads/main' || inputs.environment == 'prod'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment:
      name: prod-canary
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Configure AWS Credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          role-session-name: GitHubActions-EKSProd-${{ github.run_id }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Update Kubeconfig for Amazon EKS
        run: |
          CLUSTER_NAME="${{ needs.discover-infrastructure.outputs.eks_cluster_name }}"
          aws eks update-kubeconfig --region ${{ env.AWS_REGION }} --name "$CLUSTER_NAME"

      - name: Deploy Production Canary Helm Release (10% Canary / 90% Baseline)
        env:
          ECR_REGISTRY: ${{ needs.discover-infrastructure.outputs.ecr_registry }}
        run: |
          helm upgrade --install microservices ./helm/microservices-umbrella \
            --namespace prod \
            --create-namespace \
            --set global.environment=prod \
            --set global.provider=aws \
            --set global.registry=${ECR_REGISTRY} \
            --set storage.storageClass=gp3 \
            --set canary.enabled=true \
            --set canary.weight=10 \
            --set ingress.annotations."kubernetes\.io/ingress\.class"=alb \
            --set ingress.annotations."alb\.ingress\.kubernetes\.io/scheme"=internet-facing \
            --set ingress.annotations."alb\.ingress\.kubernetes\.io/target-type"=ip \
            --set configMap.data.SPRING_PROFILES_ACTIVE=prod \
            --wait --timeout 7m \
            --atomic \
            --cleanup-on-fail

      - name: Verify Production Canary Rollout Health & Trigger Rollback on Failure
        run: |
          echo "Verifying production canary pods health on Amazon EKS..."
          kubectl rollout status deployment/microservices-${{ inputs.service_name == 'all' && 'api-gateway' || inputs.service_name }} -n prod --timeout=2m || {
            echo "::error::Production canary health check failed! Initiating emergency Helm rollback..."
            helm rollback microservices --namespace prod --wait || true
            exit 1
          }
          echo "Production canary deployment stabilized successfully on EKS."

  # ===========================================================================
  # STAGE: 🔄 Automated Rollback on Staging Verification Failure
  # ===========================================================================
  rollback-staging-eks:
    name: "🔄 Rollback AWS EKS Staging"
    needs: [discover-infrastructure, deploy-staging-eks, integration-and-performance-tests]
    if: failure() && needs.deploy-staging-eks.result == 'success'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Configure AWS Credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ env.AWS_ROLE_ARN }}
          role-session-name: GitHubActions-RollbackStaging-${{ github.run_id }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Update Kubeconfig for Amazon EKS
        run: |
          CLUSTER_NAME="${{ needs.discover-infrastructure.outputs.eks_cluster_name }}"
          aws eks update-kubeconfig --region ${{ env.AWS_REGION }} --name "$CLUSTER_NAME"

      - name: Execute Automated Helm Rollback on Staging
        run: |
          echo "::error::Post-deployment verification tests failed. Triggering automated Helm rollback on EKS staging..."
          helm rollback microservices --namespace staging --wait --timeout 5m || echo "Staging rollback finished with warnings."

  # ===========================================================================
  # STAGE 7: 📢 ChatOps / Slack Notification (Status Broadcast)
  # ===========================================================================
  notify-status:
    name: "📢 7. Slack / ChatOps Notification"
    needs: [deploy-frontend-s3-cloudfront, deploy-production-canary-eks]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Send Slack Deployment Notification
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
        run: |
          if [ -n "$SLACK_WEBHOOK_URL" ]; then
            STATUS="${{ job.status }}"
            COLOR=$([ "$STATUS" = "success" ] && echo "#2EB886" || echo "#A30200")
            PAYLOAD="{\"attachments\":[{\"color\":\"$COLOR\",\"title\":\"AWS CI/CD Pipeline: $STATUS\",\"fields\":[{\"title\":\"Repository\",\"value\":\"${{ github.repository }}\",\"short\":true},{\"title\":\"Commit\",\"value\":\"${{ github.sha }}\",\"short\":true},{\"title\":\"Target Environment\",\"value\":\"${{ inputs.environment || 'staging' }}\",\"short\":true}]}]}"
            curl -s -X POST -H 'Content-type: application/json' --data "$PAYLOAD" "$SLACK_WEBHOOK_URL" || true
          else
            echo "SLACK_WEBHOOK_URL secret not configured — skipping notification."
          fi
