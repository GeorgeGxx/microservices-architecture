	"item": [
		{
			"name": "Orders",
			"item": [
				{
					"name": "List Orders",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200, 401 (auth) or 404\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 401, 404]);",
									"});",
									"pm.test(\"Response time is acceptable (< 1500ms)\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(1500);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/api/order",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"order"
							]
						}
					},
					"response": []
				},
				{
					"name": "Place Order (with Idempotency)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order placement status is 200, 201, 400 or 401\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Idempotency-Key",
								"value": "{{$guid}}",
								"type": "text",
								"description": "UUID v4 for distributed idempotency"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderItems\": [\n    {\n      \"sku\": \"SKU-IPHONE-15\",\n      \"price\": 999.99,\n      \"quantity\": 1\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/api/order",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"order"
							]
						}
					},
					"response": []
				},
				{
					"name": "Cancel Order (Saga Compensation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Saga cancel response code is valid\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 204, 400, 401, 404]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/api/order/1/cancel",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"order",
								"1",
								"cancel"
							]
						},
						"description": "Cancels an existing order, triggers inventory stock restoration via Saga compensation, and publishes a CANCELLED event to Kafka."
					},
					"response": []
				}
			]
		},
