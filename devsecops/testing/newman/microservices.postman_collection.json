        {
          "name": "Place Order (with Idempotency)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Optional UUID v4 for distributed idempotency",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Admin User\",\n  \"customerEmail\": \"admin_user@example.com\",\n  \"shippingAddress\": \"100 Enterprise Boulevard, Suite 500\",\n  \"city\": \"Austin\",\n  \"postalCode\": \"78701\",\n  \"phone\": \"+1 555-019-2834\",\n  \"deliveryMethod\": \"STANDARD\",\n  \"shippingFee\": 0,\n  \"taxAmount\": 5.6,\n  \"totalAmount\": 75.59,\n  \"paymentMethod\": \"CARD_VISA\",\n  \"orderItems\": [\n    {\n      \"sku\": \"000001\",\n      \"price\": 69.99,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/order",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "order"
              ]
            },
            "description": "Creates a purchase order using the default seeded SKU 000001 with full customer details, payment method, and itemized lines. Demonstrates distributed idempotency via X-Idempotency-Key header."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.id) {",
                  "    pm.collectionVariables.set(\"order_id\", res.id.toString());",
                  "    console.log(\"✅ Dynamic order_id updated to: \" + res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
