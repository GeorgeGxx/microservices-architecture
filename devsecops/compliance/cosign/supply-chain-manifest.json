{
  "schemaVersion": "1.0.0",
  "platform": "microservices-architecture",
  "attestationType": "https://slsa.dev/provenance/v1",
  "signingSpec": {
    "tool": "sigstore-cosign",
    "algorithm": "ecdsa-sha2-256-nistp256",
    "publicKeyPath": "devsecops/compliance/cosign/cosign.pub",
    "transparencyLog": "https://rekor.sigstore.dev"
  },
  "trustedRegistries": [
    "georgegxx/",
    "docker.io/georgegxx/",
    "ghcr.io/wundergraph/cosmo/",
    "ghcr.io/georgegxx/",
    "gcr.io/distroless",
    "quay.io/",
    "localhost"
  ],
  "components": [
    {
      "name": "cosmo-router",
      "runtime": "ghcr.io/wundergraph/cosmo/router:0.362.0",
      "image": "ghcr.io/wundergraph/cosmo/router:0.362.0"
    },
    {
      "name": "products-service",
      "runtime": "eclipse-temurin:21-jre-alpine",
      "image": "georgegxx/products-service:1.0.0"
    },
    {
      "name": "orders-service",
      "runtime": "eclipse-temurin:21-jre-alpine",
      "image": "georgegxx/orders-service:1.0.0"
    },
    {
      "name": "inventory-service",
      "runtime": "eclipse-temurin:21-jre-alpine",
      "image": "georgegxx/inventory-service:1.0.0"
    },
    {
      "name": "notification-service",
      "runtime": "eclipse-temurin:21-jre-alpine",
      "image": "georgegxx/notification-service:1.0.0"
    },
    {
      "name": "frontend",
      "runtime": "nginxinc/nginx-unprivileged:1.27-alpine",
      "image": "georgegxx/frontend:1.0.0"
    },
    {
      "name": "demand-forecast-service",
      "runtime": "python:3.12-slim",
      "image": "georgegxx/demand-forecast-service:1.0.0"
    },
    {
      "name": "demand-sales-capture",
      "runtime": "python:3.12-slim",
      "image": "georgegxx/demand-sales-capture:1.0.0"
    },
    {
      "name": "demand-model-training",
      "runtime": "python:3.12-slim",
      "image": "georgegxx/demand-model-training:1.0.0"
    },
    {
      "name": "mlflow",
      "runtime": "ghcr.io/mlflow/mlflow:v3.17.2",
      "image": "georgegxx/mlflow:1.0.0"
    }
  ]
