{
  "name": "fulfillment-service",
  "version": "1.0.0",
  "description": "Fulfillment and Logistics Microservice with TypeScript, NestJS v12.2.0, TypeORM 1.1.2 and PostgreSQL 18",
  "author": "GeorgeGxx Architecture",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "node ./scripts/patch-kafkajs-request-queue.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx watch --inspect=0.0.0.0:9229 src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.0",
    "@nestjs/typeorm": "12.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "1.1.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "js-yaml": "^5.5.0",
    "minimatch": "^11.0.1",
    "test-exclude": "^8.0.0",
    "multer": "^2.5.0",
    "path-to-regexp": "^8.4.2",
    "uuid": "^11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2022"
          },
          "module": {
            "type": "es6"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!@nestjs/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.orm-entity.ts",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
