# ==============================================================================
# 🚀 ENTERPRISE MICROSERVICES ARCHITECTURE - ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Minikube (Local), AWS (EKS), Azure (AKS), GCP (GKE)
# Copy this file to '.env' and adjust credentials for your environment.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & ROUTING LAYER
# ==============================================================================
NODE_ENV=development
API_VERSION=v2
LOG_LEVEL=info

# Cosmo Router Supergraph Gateway (Go / Apollo Federation v2)
GATEWAY_SERVICE_NAME=api-gateway
GATEWAY_PORT=8080

# React 19 Frontend SPA (Vite / Nginx)
FRONTEND_PORT=5173
FRONTEND_INTERNAL_PORT=8080

# Service Discovery & Internal Routing (Direct Container / K8s ClusterIP DNS)
INVENTORY_SERVICE_NAME=inventory-service
INVENTORY_SERVICE_URI=http://inventory-service:8001

NOTIFICATION_SERVICE_NAME=notification-service
NOTIFICATION_SERVICE_URI=http://notification-service:8002

ORDERS_SERVICE_NAME=orders-service
ORDERS_SERVICE_URI=http://orders-service:8003

PRODUCTS_SERVICE_NAME=products-service
PRODUCTS_SERVICE_URI=http://products-service:8004

# JVM Performance & Memory Tuning (Tiered Compilation & explicit container heap limits)
JAVA_TOOL_OPTIONS=-XX:+ExitOnOutOfMemoryError -Xms256m -Xmx512m -XX:+TieredCompilation -XX:TieredStopAtLevel=1

# ==============================================================================
# 2. SECURITY & IDENTITY MANAGEMENT (IAM / Keycloak 26 & Vault)
# ==============================================================================
KEYCLOAK_VERSION=26.7.4
KEYCLOAK_PORT=8181
KC_HTTP_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-change-me
KEYCLOAK_ISSUER_URI=http://keycloak:8181/realms/microservices-realm
KEYCLOAK_JWT_URI=http://keycloak:8181/realms/microservices-realm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_SECRET=change-me-client-secret-uuid

# HashiCorp Vault (Zero-Trust Secret Engine KV-v2)
VAULT_VERSION=2.0.4
VAULT_PORT=8200
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root-token-change-me
VAULT_ENABLED=false
VAULT_BACKEND=secret

# Application Security & Token Verification
JWT_SECRET=replace-with-a-secure-256-bit-secret-key-for-local-fallback
SESSION_SECRET=replace-with-cryptographically-secure-session-key
COOKIE_SECRET=replace-with-cryptographically-secure-cookie-key

# ==============================================================================
# 3. STATEFUL DATA LAYER (Database-per-Service, Redis & Kafka KRaft)
# ==============================================================================
POSTGRES_VERSION=18-alpine
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database-password

# Independent PostgreSQL Databases (Isolated Bounded Contexts)
KEYCLOAK_POSTGRES_DB=db_keycloak
INVENTORY_POSTGRES_DB=ms_inventory
INVENTORY_SPRING_DATASOURCE_JDBC_URL=jdbc:postgresql://db-inventory:5432/ms_inventory

ORDERS_POSTGRES_DB=ms_orders
ORDERS_SPRING_DATASOURCE_JDBC_URL=jdbc:postgresql://db-orders:5432/ms_orders

PRODUCTS_POSTGRES_DB=ms_products
PRODUCTS_SPRING_DATASOURCE_JDBC_URL=jdbc:postgresql://db-products:5432/ms_products

# Redis Distributed Cache & Idempotency Store (Redis 8.8)
REDIS_VERSION=8.8.1-alpine
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_MAX_CONNECTIONS=50

# Apache Kafka in KRaft Mode (ZooKeeper-less Event Streaming)
KAFKA_VERSION=7.8.0
KAFKA_CLUSTER_ID=GKDx6mu6RsOTU1ErbSukuQ
KAFKA_BOOTSTRAP_SERVERS=kafka:9094
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,SASL_PLAINTEXT://0.0.0.0:9094,PLAINTEXT_HOST://0.0.0.0:29092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,SASL_PLAINTEXT://kafka:9094,PLAINTEXT_HOST://localhost:29092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SASL_PLAINTEXT:SASL_PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka SASL Authentication Credentials
KAFKA_APP_USER=app
KAFKA_APP_PASSWORD=change-me-kafka-app-secret
KAFKA_ADMIN_USER=admin
KAFKA_ADMIN_PASSWORD=change-me-kafka-admin-secret
KAFKA_BROKER_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="admin" password="change-me-kafka-admin-secret" user_admin="change-me-kafka-admin-secret" user_app="change-me-kafka-app-secret";
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="app" password="change-me-kafka-app-secret";
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=PLAIN
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="app" password="change-me-kafka-app-secret";
KAFKA_OPTS=-Djava.security.auth.login.config=/dev/null

# ==============================================================================
# 4. EXTERNAL SERVICES & PAYMENT / NOTIFICATION GATEWAYS
# ==============================================================================
# Payment Processing (Stripe Integration / Mock)
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret

# Email & Transactional Alerts (SendGrid / SMTP Gateway)
SENDGRID_API_KEY=SG.replace_with_valid_sendgrid_key
MAIL_FROM_ADDRESS=notifications@microservices.example.com

# ==============================================================================
# 5. EDGE NETWORKING & ZERO-TRUST INGRESS
# ==============================================================================
# Cloudflare Zero-Trust Anycast Tunnels
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_TUNNEL_NAME=microservices-local-tunnel
CLOUDFLARE_STOREFRONT_HOSTNAME=storefront.example.com
CLOUDFLARE_KEYCLOAK_HOSTNAME=auth.example.com

# Edge CDN & Asset Acceleration
CDN_URL=https://d2k8jh47f8kl3.cloudfront.net

# API Protection & Ingress Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ==============================================================================
# 6. CLOUD PLATFORM & GITOPS GOVERNANCE
# ==============================================================================
# AWS Configuration (EKS Provisioning)
AWS_ACCESS_KEY_ID=AKIA_REPLACE_WITH_AWS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET
AWS_REGION=us-east-1

# ArgoCD GitOps Engine
ARGOCD_VERSION=3.5.3
ARGOCD_HELM_CHART_VERSION=10.9.2

# Open Policy Agent (OPA Gatekeeper Admission Controller)
GATEKEEPER_VERSION=3.23.0

# ==============================================================================
# 7. OBSERVABILITY, APM & TELEMETRY (LGTM + OpenTelemetry)
# ==============================================================================
PROM_VERSION=v3.14.0
GRAFANA_VERSION=13.2.1
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin-grafana-change-me
LOKI_VERSION=3.7.4
TEMPO_VERSION=3.0.3
TEMPO_PORT=3200
ALLOY_VERSION=v1.19.1
KUBE_PROMETHEUS_STACK_VERSION=89.2.2

# OpenTelemetry Protocol (OTLP Collector)
OTEL_COLLECTOR_VERSION=0.159.0
OTEL_GRCP_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES=service.namespace=microservices

# Prometheus Infrastructure Exporters
REDIS_EXPORTER_VERSION=v1.82.0
KAFKA_EXPORTER_VERSION=v1.9.0
POSTGRES_EXPORTER_VERSION=v0.20.1
