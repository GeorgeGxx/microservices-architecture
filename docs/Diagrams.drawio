        </mxCell>
        <mxCell id="c_canary" parent="1" value="&lt;b&gt;🌐 ISTIO CANARY TRAFFIC MANAGEMENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="960" y="90" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="n_vs" parent="1" value="&lt;b&gt;VirtualService: products-service-vs&lt;/b&gt;&lt;br&gt;• Header Match: x-canary: true ➔ 100% v2&lt;br&gt;• Weight Split: 90% Subset v1 / 10% Subset v2&lt;br&gt;• Retries: 2 attempts (5xx, connect-failure)&lt;br&gt;• Timeout: 5s per try" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="140" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_dr" parent="1" value="&lt;b&gt;DestinationRule: products-service-dr&lt;/b&gt;&lt;br&gt;• Host: products-service.staging.svc&lt;br&gt;• Subset v1 (version=v1)&lt;br&gt;• Subset v2 (version=v2)&lt;br&gt;• TrafficPolicy: ISTIO_MUTUAL (mTLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="240" width="380" height="80" as="geometry" />
        </mxCell>
