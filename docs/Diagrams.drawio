          <mxGeometry x="60" y="110" width="280" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k_vault_pod" parent="1" value="&lt;b&gt;Deployment: vault&lt;/b&gt;&lt;br&gt;hashicorp/vault:2.2.0&lt;br&gt;disable_mlock = true&lt;br&gt;Port 8200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="160" width="240" height="70" as="geometry" />
