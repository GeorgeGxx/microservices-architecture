        <mxCell id="n_store" parent="1" value="&lt;b&gt;SecretStore: vault-secret-store&lt;/b&gt;&lt;br&gt;• API: external-secrets.io/v1&lt;br&gt;• Auth: Kubernetes Token SecretRef&lt;br&gt;• Target Server: http://vault.vault.svc:8200&lt;br&gt;• Status: Valid (ReadWrite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
