        </mxCell>
        <mxCell id="app_gw" parent="1" value="&lt;b&gt;🚀 Cosmo Router v2&lt;/b&gt;&lt;br&gt;Port 8080 (/graphql)&lt;br&gt;Sandbox: http://localhost:8080&lt;br&gt;Apollo Federation 2.3 Supergraph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
