        </mxCell>
        <mxCell id="c_canary" parent="1" value="&lt;b&gt;🌐 ISTIO CANARY TRAFFIC MANAGEMENT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="960" y="90" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="n_vs" parent="1" value="&lt;b&gt;VirtualService: products-service-canary-vs&lt;/b&gt;&lt;br&gt;• Initial split: 90% stable / 10% canary&lt;br&gt;• Guarded stages: 10 → 25 → 50 → 75 → 100% v2&lt;br&gt;• x-canary: true routes 100% to v2&lt;br&gt;• Declined/failed gate restores last accepted split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="140" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_dr" parent="1" value="&lt;b&gt;DestinationRule: products-service-dr&lt;/b&gt;&lt;br&gt;• Host: products-service.staging.svc&lt;br&gt;• Subset v1 (version=v1)&lt;br&gt;• Subset v2 (version=v2)&lt;br&gt;• TrafficPolicy: ISTIO_MUTUAL (mTLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="240" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_v1" parent="1" value="&lt;b&gt;products-service stable v1&lt;/b&gt;&lt;br&gt;Traffic decreases to 0% as v2 passes gates&lt;br&gt;Kept Ready for immediate rollback until promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="340" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_v2" parent="1" value="&lt;b&gt;products-service candidate v2&lt;/b&gt;&lt;br&gt;Distinct immutable image tag&lt;br&gt;After 100% approval, promote same tag through GitOps; retire canary after stable rollout is Ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="430" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_vs_dr" parent="1" value="Routes to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="n_vs" target="n_dr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dr_v1" parent="1" value="Decreases to 0%" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;" edge="1" source="n_dr" target="n_v1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dr_v2" parent="1" value="Increases to 100%" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=1.5;" edge="1" source="n_dr" target="n_v2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_alerts" parent="1" value="&lt;b&gt;🚨 ALERTING &amp; INCIDENT ROUTING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1410" y="90" width="430" height="470" as="geometry" />
        </mxCell>
        <mxCell id="n_prule" parent="1" value="&lt;b&gt;PrometheusRule (monitoring.coreos.com)&lt;/b&gt;&lt;br&gt;• ServiceDown, HighErrorRate, HighLatency&lt;br&gt;• 99.5% availability SLO error-budget burn&lt;br&gt;• HighHeapUsage • RedisExporterDown&lt;br&gt;• AlloyCollectorDown (target absent or failing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;" vertex="1">
          <mxGeometry x="1430" y="140" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_amc" parent="1" value="&lt;b&gt;AlertmanagerConfig: microservices-alerts&lt;/b&gt;&lt;br&gt;• API: monitoring.coreos.com/v1alpha1&lt;br&gt;• Namespace: staging (Matches Staging Alerts)&lt;br&gt;• GroupBy: alertname, job, severity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;" vertex="1">
          <mxGeometry x="1430" y="240" width="390" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n_local" parent="1" value="&lt;b&gt;Active Local Receiver (Default)&lt;/b&gt;&lt;br&gt;• default-local-receiver (In-Cluster Alerts)&lt;br&gt;• Zero external dependencies, never fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1430" y="335" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_slack" parent="1" value="&lt;b&gt;Slack Notifications (Ready to Enable)&lt;/b&gt;&lt;br&gt;• Secret: alertmanager-slack-webhook&lt;br&gt;• Channel: #alerts-microservices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="1430" y="410" width="185" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_jira" parent="1" value="&lt;b&gt;Jira Incident Webhook (Ready)&lt;/b&gt;&lt;br&gt;• severity: critical ➔ Issue Automation&lt;br&gt;• Direct ticket creation on outage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="1635" y="410" width="185" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_pr_amc" parent="1" value="Firing Alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF4444;strokeWidth=1.5;" edge="1" source="n_prule" target="n_amc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_amc_loc" parent="1" value="Route Default" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;" edge="1" source="n_amc" target="n_local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_amc_slk" parent="1" value="Configured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1;dashed=1;" edge="1" source="n_amc" target="n_slack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_amc_jir" parent="1" value="Critical" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1;dashed=1;" edge="1" source="n_amc" target="n_jira">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_multicloud_automation" name="11. Multi-Cloud IaC &amp; CLI Automation Suite">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t11" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MULTI-CLOUD INFRASTRUCTURE (AWS • AZURE • GCP) &amp; AUTOMATION SUITE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;12 Kubernetes clusters: 4 per provider (dev, staging, two prod) • 3 workspaces per provider • Unified CLI &amp; FinOps&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_aws" parent="1" value="&lt;b&gt;☁️ AMAZON WEB SERVICES (AWS)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/aws/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="aws_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; shared VPC per environment&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; EKS dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; RDS PostgreSQL 18 (Multi-AZ)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; ElastiCache Redis OSS 7.1 (AWS latest)&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Amazon MSK Provisioned (Kafka 4.1.x; M5; closest supported to local Kafka 4.3.x)&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; S3 Assets Bucket (SSE-KMS, Versioning)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; AWS KMS (CMK Key &amp; Alias)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; IAM IRSA (OIDC Trust Provider)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Network Load Balancer (NLB L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; CloudFront + WAFv2 (S3 Static SPA + NLB Dynamic API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; CloudWatch Alarms &amp; Dashboards&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Route53 Zone + Apex Alias to CloudFront + ACM SSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="150" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_azure" parent="1" value="&lt;b&gt;☁️ MICROSOFT AZURE CLOUD&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/azure/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="90" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="azure_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; VNet + dedicated prod AKS subnets&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; AKS dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; Azure PostgreSQL Flexible Server (HA)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; Azure Cache for Redis (TLS 1.2)&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Azure Event Hubs (Kafka Surface)&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; Azure Storage Account (Blob Containers)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Azure Key Vault (Soft-delete, Purge)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; Azure Workload Identity (Federated Creds)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Azure Standard Load Balancer (L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; Front Door Premium (Storage Blob SPA + AKS SLB API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; Azure Monitor (Log Analytics, App Insights)&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Azure DNS Zone + Custom Apex Records to Front Door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="150" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_gcp" parent="1" value="&lt;b&gt;☁️ GOOGLE CLOUD PLATFORM (GCP)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/gcp/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#064E3B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1260" y="90" width="580" height="470" as="geometry" />
        </mxCell>
        <mxCell id="gcp_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; Google Cloud VPC + Cloud NAT; separate secondary ranges for prod dp2&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; GKE Autopilot dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; Cloud SQL PostgreSQL 18 (HA)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; Cloud Memorystore for Redis 7.2&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Managed Kafka / Cloud PubSub &amp; DLQ&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; Google Cloud Storage (CMEK, Uniform Access)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Google Cloud KMS (KeyRing &amp; CryptoKey)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; GCP Workload Identity (GSA to KSA)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Passthrough Network Load Balancer (L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; Cloud Armor + Cloud CDN (GCS Bucket SPA + Istio NLB API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; Cloud Monitoring (Dashboards &amp; Alerts)&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Cloud DNS Managed Zone + Global A-Record to Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="150" width="540" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_cli" parent="1" value="&lt;b&gt;🚀 UNIFIED PLATFORM CLI ARCHITECTURE (platform-*.ps1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="580" width="880" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cli_commands" parent="1" value="• &lt;b&gt;Local Minikube CLI:&lt;/b&gt; platform-minikube.ps1 up / test / security-scan / doctor / mlops / canary / vault / set-tag (zero-cloud-cost local stack; Minikube-specific helpers included)&lt;br&gt;• &lt;b&gt;Multi-Cloud CLI:&lt;/b&gt; platform-multicloud.ps1 -Provider &amp;lt;aws|azure|gcp&amp;gt; (cloud-specific security, Terraform, delivery, and post-deploy helpers included)&lt;br&gt;  - &lt;b&gt;AWS:&lt;/b&gt; pre-deploy / plan / apply / drift / sync-argocd / post-deploy / pipeline (Flavors: eks, ecs-fargate, ec2-compact)&lt;br&gt;  - &lt;b&gt;Azure:&lt;/b&gt; pre-deploy / plan / apply / drift / apply-workloads / rollback / post-deploy / pipeline (AKS primary &amp; secondary data planes)&lt;br&gt;  - &lt;b&gt;GCP:&lt;/b&gt; pre-deploy / plan / apply / drift / apply-workloads / rollback / post-deploy / pipeline (GKE primary &amp; secondary data planes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="630" width="840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_scripts" parent="1" value="&lt;b&gt;📂 AUTOMATION SCRIPTS PORTFOLIO (scripts/)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="960" y="580" width="880" height="340" as="geometry" />
        </mxCell>
        <mxCell id="scripts_map" parent="1" value="• &lt;b&gt;Platform CLIs:&lt;/b&gt; platform-minikube.ps1 (local Minikube and its DevSecOps helpers) &amp; platform-multicloud.ps1 (AWS, Azure, GCP and their cloud helpers); each is a standalone entrypoint with no shared PowerShell runtime dependency&lt;br&gt;• &lt;b&gt;scripts/prod/:&lt;/b&gt; Production Linux-native tools: pg-bcdr-engine.sh (Postgres 18 / MLflow BCDR), pre-stop-drain.sh (zero-downtime traffic draining), sre-health-audit.sh (zero-dependency SRE health &amp; JVM triage), node-hardening.sh (Linux kernel sysctl &amp; Docker hardening), kafka-ops.sh (Kafka 8.3.2 KRaft operations &amp; lag inspection)&lt;br&gt;• &lt;b&gt;scripts/ci/:&lt;/b&gt; post-deploy-verify.sh (Newman, smoke, k6 SLO, OWASP ZAP DAST) &amp; run-quality-gate.sh (Gitleaks, Trivy IaC, Terraform fmt)&lt;br&gt;• &lt;b&gt;Velero v1.18.3 BCDR:&lt;/b&gt; scripts/install-velero.sh &amp; scripts/deploy-velero.sh with k8s/common/bcdr/velero-values.yaml &amp; velero-schedule.yaml (Kopia node-agent state backup)&lt;br&gt;• &lt;b&gt;scripts/bcdr-simulation.ps1:&lt;/b&gt; PostgreSQL isolated restore; Kafka replay of retained records; MLflow SQLite and artifact checksum restore checks&lt;br&gt;• &lt;b&gt;scripts/bootstrap-keycloak.ps1:&lt;/b&gt; Keycloak realm, roles, local test users, public SPA/confidential automation clients, secret sync&lt;br&gt;• &lt;b&gt;scripts/build-all.py:&lt;/b&gt; Concurrent Maven + React container image compiler&lt;br&gt;• &lt;b&gt;scripts/testing/smoke.py:&lt;/b&gt; Storefront deployment and resilience load smoke gate&lt;br&gt;• &lt;b&gt;scripts/testing/simulate.py:&lt;/b&gt; E-commerce traffic and chaos simulation suite&lt;br&gt;• &lt;b&gt;scripts/testing/diagnose.py:&lt;/b&gt; Unified standalone component, telemetry, and authenticated order diagnostics&lt;br&gt;• &lt;b&gt;scripts/local-cost-estimator.py:&lt;/b&gt; Unified FinOps suite (architecture estimates, Terraform plan-delta &amp; K8s right-sizing)&lt;br&gt;• &lt;b&gt;scripts/update_dashboards.py:&lt;/b&gt; Unified Grafana dashboard generator, live publisher, and demo telemetry CLI&lt;br&gt;• &lt;b&gt;scripts/generate_drawio.py:&lt;/b&gt; 16-page architectural blueprint generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="980" y="630" width="840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="ops_box_11" parent="1" value="&lt;b&gt;🎯 MULTI-CLOUD PLATFORM SUMMARY&lt;/b&gt;: AWS, Azure, and GCP use provider-specific modules with a consistent dev/staging/prod workspace model. Each provider plans four Kubernetes clusters (one dev, one staging, two production); Minikube is a local development platform, not full cloud parity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="940" width="1780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_cicd_rollback_arch" name="12. Multi-Cloud CI/CD &amp; Recovery Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t12" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MULTI-CLOUD CI/CD &amp; RECOVERY ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;GitHub Actions publishes the immutable GHCR chart • Azure DevOps and Bitbucket consume its pinned version • Terraform exposes the shared chart coordinates&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_gha_argo" parent="1" value="&lt;b&gt;🐙 GITHUB ACTIONS (CI) + ARGOCD (CD)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;AWS EKS &amp; Minikube Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="570" height="500" as="geometry" />
        </mxCell>
        <mxCell id="gha_ci_box" parent="1" value="&lt;b&gt;GitHub Actions (CI) + ArgoCD (GitOps CD):&lt;/b&gt;&lt;br&gt;• PR/push gates: tests, Trivy 0.76.1 scans, Gitleaks, Helm 4.3.1 and OPA policy fixtures&lt;br&gt;• Publish single immutable SemVer; capture registry digest; PR &amp; unversioned dev pushes blocked from registry&lt;br&gt;• &lt;b&gt;yq GitOps Writeback:&lt;/b&gt; Automates values-*.yaml synchronization upon SemVer release&lt;br&gt;• ArgoCD deploys by digest or SemVer pin; Zero-downtime rolling update&lt;br&gt;• Recovery: Git revert, ArgoCD revision rollback, or kubectl rollout undo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="150" width="530" height="145" as="geometry" />
        </mxCell>
        <mxCell id="argo_cd_box" parent="1" value="&lt;b&gt;ArgoCD (Strictly CD - GitOps):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;develop:&lt;/b&gt; &lt;code&gt;application-dev.yaml&lt;/code&gt; ➔ Minikube (&lt;code&gt;dev&lt;/code&gt; ns)&lt;br&gt;• &lt;b&gt;staging:&lt;/b&gt; &lt;code&gt;application-staging.yaml&lt;/code&gt; ➔ configured staging cluster (&lt;code&gt;staging&lt;/code&gt; ns)&lt;br&gt;• &lt;b&gt;master:&lt;/b&gt; &lt;code&gt;application-prod.yaml&lt;/code&gt; ➔ configured production cluster (&lt;code&gt;production&lt;/code&gt; ns)&lt;br&gt;• Applications remain Git-sourced; OCI migration awaits package publication and registry access&lt;br&gt;• Reconciliation and rollback remain separate from Terraform state recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="310" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="argo_roll_box" parent="1" value="&lt;b&gt;🔄 Recovery Controls:&lt;/b&gt;&lt;br&gt;• Revert desired-state Git commits for normal recovery&lt;br&gt;• Check auto-sync before using ArgoCD's emergency rollback&lt;br&gt;• Terraform state locks are recovered manually after investigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="80" y="490" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_azdo" parent="1" value="&lt;b&gt;🔷 AZURE DEVOPS (SINGLE UNIFIED PIPELINE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Azure Cloud &amp; AKS Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="90" width="570" height="500" as="geometry" />
        </mxCell>
        <mxCell id="azdo_stages" parent="1" value="&lt;b&gt;Shared Azure DevOps application template (14 numbered stages + rollbacks):&lt;/b&gt;&lt;br&gt;• Per-service roots: frontend, inventory, orders, products, notification, demand-forecast, mlops-training&lt;br&gt;• Cosmo Router has separate config/supergraph validation&lt;br&gt;• 1-6. Shift-Left: Tests (Maven/React/Python), security, image/SBOM, policy, ACR candidate&lt;br&gt;• 7-8,14. Deploy directly to AKS via Helm umbrella chart with &lt;code&gt;yq&lt;/code&gt; OCI metadata extraction&lt;br&gt;• 9-13. Post-Deploy Gates: Newman, Cypress, k6, OWASP ZAP DAST, and atomic Helm rollback&lt;br&gt;• Production canary awaits its production-specific Istio manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="150" width="530" height="240" as="geometry" />
        </mxCell>
        <mxCell id="azdo_tf_box" parent="1" value="&lt;b&gt;Terraform Azure validation (pipelines/infra.yml):&lt;/b&gt;&lt;br&gt;• Workspaces: &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, &lt;code&gt;prod&lt;/code&gt;&lt;br&gt;• Reads umbrella chart metadata and exposes repository/version/reference outputs&lt;br&gt;• fmt/init/validate only; cloud plan/apply awaits Blob state and locking&lt;br&gt;• &lt;code&gt;infra-stages.yml&lt;/code&gt; remains a saved-plan/apply helper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="410" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c_bb" parent="1" value="&lt;b&gt;🪣 BITBUCKET PIPELINES (SINGLE UNIFIED PIPELINE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Google Cloud Platform &amp; GKE Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#064E3B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1260" y="90" width="580" height="500" as="geometry" />
        </mxCell>
        <mxCell id="bb_stages" parent="1" value="&lt;b&gt;Bitbucket pipelines: 14 numbered stages per branch:&lt;/b&gt;&lt;br&gt;• Multi-stack: Spring Boot (Maven), Storefront (Node), MLOps (Python PySpark/FastAPI)&lt;br&gt;• &lt;b&gt;develop/staging:&lt;/b&gt; verification, environment image publish/deploy, API and storefront gates&lt;br&gt;• &lt;b&gt;master:&lt;/b&gt; QA, manual promotion of the same image SHA and rolling release&lt;br&gt;• Deploy directly to GKE via Helm umbrella chart with pinned &lt;code&gt;yq&lt;/code&gt; metadata validation&lt;br&gt;• Post-Deploy Gates: Newman contract, k6 SLA, OWASP ZAP DAST, and atomic Helm rollback&lt;br&gt;• Helm uses &lt;code&gt;--atomic&lt;/code&gt;; post-deploy QA recovery is operator-led" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="150" width="540" height="240" as="geometry" />
        </mxCell>
        <mxCell id="bb_tf_box" parent="1" value="&lt;b&gt;Terraform GCP validation (apply disabled):&lt;/b&gt;&lt;br&gt;• Workspaces: &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, &lt;code&gt;prod&lt;/code&gt;; prod has two GKE clusters&lt;br&gt;• Exposes the same GHCR chart repository/version/reference outputs&lt;br&gt;• Partial GCS backend; CI uses &lt;code&gt;-backend=false&lt;/code&gt;&lt;br&gt;• Cloud apply awaits durable state and locking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="410" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c_roll_matrix" parent="1" value="&lt;b&gt;🛡️ AUTOMATED ROLLBACK &amp; INCIDENT RECOVERY MATRIX&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="610" width="1780" height="290" as="geometry" />
        </mxCell>
        <mxCell id="rm_1" parent="1" value="&lt;b&gt;Level 1: IaC State Lock Recovery&lt;/b&gt;&lt;br&gt;• Operator inspects failed run and confirms no active operation&lt;br&gt;• Uses the real backend lock ID for manual recovery&lt;br&gt;• No automatic unlock on apply failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_2" parent="1" value="&lt;b&gt;Level 2: GitOps Recovery&lt;/b&gt;&lt;br&gt;• Revert the desired-state commit in Git&lt;br&gt;• ArgoCD reconciles the restored revision&lt;br&gt;• Emergency CLI rollback requires checking auto-sync behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="520" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_3" parent="1" value="&lt;b&gt;Level 3: Helm Recovery&lt;/b&gt;&lt;br&gt;• &lt;code&gt;--atomic&lt;/code&gt; reverts a failed readiness/upgrade operation&lt;br&gt;• Post-deploy QA failure blocks promotion; operator assesses and rolls back if needed&lt;br&gt;• Bitbucket production uses manual rolling release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="960" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_4" parent="1" value="&lt;b&gt;Level 4: Production &amp; GitOps Recovery&lt;/b&gt;&lt;br&gt;• Provider-specific rollback and ArgoCD Git revert/rollback&lt;br&gt;• Bitbucket is not configured for production canary&lt;br&gt;• Terraform state locks are recovered manually after inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="1400" y="660" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_banner" parent="1" value="&lt;b&gt;🎯 RECOVERY ASSURANCE:&lt;/b&gt; Helm restores the previous release for failed atomic upgrades. Post-deployment QA and production incidents follow the explicit provider/operator recovery paths above; Terraform state locks are never force-released automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="790" width="1740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ops_box_12" parent="1" value="&lt;b&gt;🎯 IMMUTABLE CHART DELIVERY&lt;/b&gt;: GitHub Actions is the only publisher to GHCR; Azure DevOps and Bitbucket deploy the exact Chart.yaml version; AWS/Azure/GCP Terraform outputs expose the same pin across all workspaces. ArgoCD Applications remain Git-sourced until GHCR publication and pull access are configured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="920" width="1780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_devsecops_lifecycle" name="13. The 5-Phase End-to-End Delivery Lifecycle">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t13" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;THE 5-PHASE END-TO-END DELIVERY LIFECYCLE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Enterprise DevSecOps governance • Automated quality and security gates • Continuous reliability feedback&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="260" y="25" width="1400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="phase1_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 1&lt;br&gt;STRATEGIC CONCEPTION &amp;amp; THREAT MODELING&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Business / PO 🔵&lt;/b&gt;&lt;br&gt;Value-stream hypothesis, functional acceptance &amp;amp; evil user stories&lt;br&gt;&lt;br&gt;&lt;b&gt;Solution Arch &amp;amp; Tech Lead 🟢&lt;/b&gt;&lt;br&gt;Baseline architecture, Schema-First design &amp;amp; approved ADRs&lt;br&gt;&lt;br&gt;&lt;b&gt;Cybersecurity Lead 🟡&lt;/b&gt;&lt;br&gt;STRIDE threat modeling &amp;amp; abuse cases&lt;br&gt;&lt;br&gt;&lt;b&gt;QA Automation 🟠&lt;/b&gt;&lt;br&gt;Contract &amp;amp; BDD acceptance test suites&lt;br&gt;&lt;br&gt;&lt;b&gt;🚦 Gate: Definition of Ready (DoR)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1">
          <mxGeometry x="50" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase2_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 2&lt;br&gt;SECURE CONSTRUCTION &amp;amp; SHIFT-LEFT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dev Team 🔴 &amp;amp; Tech Lead 🟢&lt;/b&gt;&lt;br&gt;Test-Driven Development (TDD), clean code &amp;amp; SOLID standards&lt;br&gt;Pre-commit secret detection (Gitleaks)&lt;br&gt;Non-destructive DB schema evolution (Expand/Contract)&lt;br&gt;Multi-cloud Terraform infrastructure as code&lt;br&gt;&lt;br&gt;&lt;b&gt;Pull Request &amp;amp; Peer Review&lt;/b&gt;&lt;br&gt;Mandatory peer approval on conventional commits" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1">
          <mxGeometry x="418" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase3_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 3&lt;br&gt;AUTOMATED QUALITY &amp;amp; SECURITY GATES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CI/CD Pipeline (Automated ⚙️) - DoD Level 1&lt;/b&gt;&lt;br&gt;1. Maven, React &amp;amp; Python compile cleanly&lt;br&gt;2. Polyglot test line coverage ≥ 80% (JaCoCo, Vitest, Coverage.py)&lt;br&gt;3. Shift-Left SAST: SonarCloud Quality Gate (Passed)&lt;br&gt;4. SCA &amp;amp; secret scanning: Trivy 0.76.1 &amp;amp; Gitleaks&lt;br&gt;5. IaC configuration scan: Trivy; policy enforcement: Conftest Rego&lt;br&gt;6. Supply-chain verification: Sigstore Cosign (cosign.pub)&lt;br&gt;&lt;br&gt;&lt;b&gt;Immutable Container Delivery&lt;/b&gt;&lt;br&gt;Multi-stage non-root container build with Trivy scan" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#064E3B;" vertex="1">
          <mxGeometry x="786" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase4_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 4&lt;br&gt;STAGING VALIDATION &amp;amp; GITOPS PROMOTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GitOps Continuous Delivery (ArgoCD) 🔘&lt;/b&gt;&lt;br&gt;Deploy to staging with Helm umbrella charts&lt;br&gt;&lt;br&gt;&lt;b&gt;Dynamic Assurance Suite (DoD Level 2)&lt;/b&gt;&lt;br&gt;6. Newman API contract check: 23/23 pass&lt;br&gt;7. Cosmo Router federated GraphQL composition&lt;br&gt;8. k6 load &amp;amp; SLO benchmark: p95 &amp;lt; 200 ms&lt;br&gt;9. OWASP ZAP baseline dynamic DAST&lt;br&gt;&lt;br&gt;&lt;b&gt;Production Promotion (DoD Level 3)&lt;/b&gt;&lt;br&gt;OPA Gatekeeper admission control&lt;br&gt;Istio canary progressive rollout: 10% → 100%" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#7F1D1D;" vertex="1">
          <mxGeometry x="1154" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase5_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 5&lt;br&gt;CONTINUOUS RELIABILITY &amp;amp; CLOSED-LOOP FEEDBACK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SRE / Platform / Observability 🔘&lt;/b&gt;&lt;br&gt;Full-Stack LGTM Telemetry:&lt;br&gt;• Distributed tracing: Grafana Tempo (TraceQL)&lt;br&gt;• Centralized logging: Grafana Loki (LogQL)&lt;br&gt;• Golden signals &amp;amp; metrics: Prometheus (PromQL)&lt;br&gt;&lt;br&gt;&lt;b&gt;Incident &amp;amp; RCA Management&lt;/b&gt;&lt;br&gt;Anomaly trigger / PagerAlert / ServiceNow&lt;br&gt;P1/P2 root-cause analysis &amp;amp; blameless post-mortem&lt;br&gt;&lt;br&gt;&lt;b&gt;Closed-Loop Backlog Feed 🔴 🔵&lt;/b&gt;&lt;br&gt;Regression tests added to Newman / k6&lt;br&gt;Preventive security &amp;amp; technical debt backlog" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1">
          <mxGeometry x="1522" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_1" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase1_delivery" target="phase2_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_2" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase2_delivery" target="phase3_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_3" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase3_delivery" target="phase4_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_4" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase4_delivery" target="phase5_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_feedback" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#8B5CF6;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="phase5_delivery" target="phase1_delivery">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1692" y="785" />
              <mxPoint x="220" y="785" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lifecycle_feedback_label" parent="1" value="&lt;b&gt;↶ CONTINUOUS CLOSED-LOOP FEEDBACK:&lt;/b&gt; Incident learning, Grafana Tempo TraceQL anomalies, and preventive backlog stories automatically feed regression tests and subsequent architecture cycles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;fontColor=#4C1D95;fontSize=12;align=center;verticalAlign=middle;" vertex="1">
          <mxGeometry x="360" y="820" width="1200" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_graphql_supergraph_hardening" name="14. GraphQL Supergraph - 6-Layer Defense-in-Depth Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t14" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;GRAPHQL SUPERGRAPH - 6-LAYER DEFENSE-IN-DEPTH ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;WunderGraph Cosmo Router • Apollo Federation v2 • Keycloak JWKS • K8s Hardening • Zero-Trust L3/L4 Network Policies&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="250" y="25" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c14_client" parent="1" value="&lt;b&gt;🌐 CLIENT LAYER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="50" y="100" width="260" height="740" as="geometry" />
        </mxCell>
        <mxCell id="n14_spa" parent="1" value="&lt;b&gt;React 19 SPA Storefront&lt;/b&gt;&lt;br&gt;Vite/Tunnel :5173 • Nginx :8080&lt;br&gt;Federated GraphQL Client&lt;br&gt;Unified Query Dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="70" y="160" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n14_client_req" parent="1" value="&lt;b&gt;Single GraphQL Operation&lt;/b&gt;&lt;br&gt;&lt;code&gt;query { products { sku name isInStock } }&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;mutation { placeOrder(...) }&lt;/code&gt;&lt;br&gt;+ Bearer JWT (Keycloak)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=10;" vertex="1">
          <mxGeometry x="70" y="260" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n14_attack_sim" parent="1" value="&lt;b&gt;Malicious Traffic Vector&lt;/b&gt;&lt;br&gt;• Circular DoS queries&lt;br&gt;• Field-stuffing bloat&lt;br&gt;• Alias batching attacks&lt;br&gt;• Unauthenticated calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;dashed=1;" vertex="1">
          <mxGeometry x="70" y="380" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c14_l6" parent="1" value="&lt;b&gt;🛡️ LAYER 6: ZERO-TRUST L3/L4 NETWORK POLICIES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="340" y="100" width="290" height="740" as="geometry" />
        </mxCell>
        <mxCell id="n14_ingress" parent="1" value="&lt;b&gt;Istio Gateway / Ingress&lt;/b&gt;&lt;br&gt;Port 8080 (TCP Ingress)&lt;br&gt;matchLabels: app=cosmo-router&lt;br&gt;STRICT L3/L4 Allow-list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="365" y="160" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n14_netpol_rules" parent="1" value="&lt;b&gt;NetworkPolicy Enforcement&lt;/b&gt;&lt;br&gt;• Ingress: Only from frontend / istio-system on :8080&lt;br&gt;• Egress: Only to subgraphs (:8001-:8004), Keycloak (:8181) &amp;amp; OTel (:4318)&lt;br&gt;• All other lateral ports BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#312E81;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="365" y="260" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c14_cosmo" parent="1" value="&lt;b&gt;🔒 LAYER 5: K8S POD &amp;amp; CONTAINER HARDENING (WunderGraph Cosmo Router 0.362.0)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748B;'&gt;Distroless UID/GID 65532 • readOnlyRootFilesystem: true • allowPrivilegeEscalation: false • drop: [ALL] • seccomp: RuntimeDefault • automountServiceAccountToken: false&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="100" width="750" height="740" as="geometry" />
        </mxCell>
        <mxCell id="n14_l4" parent="1" value="&lt;b&gt;🚦 LAYER 4: Traffic Shaping &amp;amp; Strict CORS&lt;/b&gt;&lt;br&gt;• max_request_body_size: 1MB • max_header_bytes: 1MiB (prevents buffer overflow &amp;amp; memory exhaustion)&lt;br&gt;• Strict CORS: localhost:5173 / 127.0.0.1:5173 whitelist • Allow: GET, POST, OPTIONS&lt;br&gt;• Connection pooling: 64 max_conns_per_host • Timeouts: 3s dial, 20s request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="685" y="160" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n14_l1" parent="1" value="&lt;b&gt;🔑 LAYER 1: Edge JWT Authentication (Keycloak OIDC)&lt;/b&gt;&lt;br&gt;• Cryptographic verification against Keycloak JWKS certs (/realms/microservices-realm/protocol/openid-connect/certs)&lt;br&gt;• Enforce RS256 algorithm • Fail-closed posture: on_error: reject for expired, invalid or tampered tokens&lt;br&gt;• Controlled propagation: Bearer token, W3C traceparent (OTel Tempo), and X-Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="685" y="255" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n14_l3" parent="1" value="&lt;b&gt;🛡️ LAYER 3: GraphQL AST &amp;amp; DoS Mitigation (Complexity Engine)&lt;/b&gt;&lt;br&gt;• maxDepth: 12 (blocks infinite circular recursive nesting attacks)&lt;br&gt;• maxTotalFields: 250 (mitigates query bloat / field-stuffing exhaustion)&lt;br&gt;• maxRootFields: 12 &amp;amp; maxRootFieldAliases: 5 (stops alias batching &amp;amp; rate-limit bypass)&lt;br&gt;• Parser limits: depth 40, total fields 500 • Introspection &amp;amp; Playground: DISABLED in Production Helm values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="685" y="350" width="700" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n14_l2" parent="1" value="&lt;b&gt;⚡ LAYER 2: Pre-Fetch Field-Level Authorization&lt;/b&gt;&lt;br&gt;• Hybrid model: catalog queries public (require_authentication: false), orders protected (@authenticated)&lt;br&gt;• enable_pre_fetch_field_authorization: true&lt;br&gt;• Evaluates AST permissions BEFORE compiling execution plan or dispatching sub-queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#4C1D95;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="685" y="455" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n14_engine" parent="1" value="&lt;b&gt;🧩 Apollo Federation v2 Execution Engine&lt;/b&gt;&lt;br&gt;• Deterministic execution-config.json compiled offline via wgc router compose&lt;br&gt;• Ultra-low latency Go runtime planner (sub-millisecond query planning)&lt;br&gt;• Concurrent entity resolution across subgraphs using @key(fields: &quot;sku&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="685" y="550" width="700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n14_kill" parent="1" value="&lt;b&gt;🛑 FAIL-CLOSED EDGE KILL-SWITCH:&lt;/b&gt; Malicious, oversized, unauthenticated, or complex AST queries terminated immediately at the router.&lt;br&gt;Returns HTTP 401 Unauthorized / 400 Bad Request — Zero CPU, Memory or DB load on downstream microservices." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=10;align=center;" vertex="1">
          <mxGeometry x="685" y="645" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c14_sub" parent="1" value="&lt;b&gt;📦 SHIELDED SUBGRAPHS &amp;amp; PLATFORM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="1440" y="100" width="430" height="740" as="geometry" />
        </mxCell>
        <mxCell id="n14_prod" parent="1" value="&lt;b&gt;Products Service (:8004)&lt;/b&gt;&lt;br&gt;Catalog &amp;amp; Pricing • Subgraph SDL&lt;br&gt;Entity: &lt;code&gt;Product @key(fields: &quot;sku&quot;)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1465" y="160" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n14_inv" parent="1" value="&lt;b&gt;Inventory Service (:8001)&lt;/b&gt;&lt;br&gt;Stock Levels &amp;amp; Reservations&lt;br&gt;Entity: &lt;code&gt;Product @key(fields: &quot;sku&quot;)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1465" y="240" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n14_ord" parent="1" value="&lt;b&gt;Orders Service (:8003)&lt;/b&gt;&lt;br&gt;Saga Orchestration &amp;amp; Checkout&lt;br&gt;Operations: &lt;code&gt;@authenticated&lt;/code&gt; required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1465" y="320" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n14_kc" parent="1" value="&lt;b&gt;Keycloak 26 (IAM :8181)&lt;/b&gt;&lt;br&gt;JWKS Public Key Certs (/certs)&lt;br&gt;microservices-realm OIDC Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="1465" y="405" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n14_otel" parent="1" value="&lt;b&gt;OpenTelemetry Collector (:4318)&lt;/b&gt;&lt;br&gt;Distributed Traces (Grafana Tempo)&lt;br&gt;Metrics Exporter (Prometheus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0C4A6E;fontSize=11;" vertex="1">
          <mxGeometry x="1465" y="490" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c14_summary" parent="1" value="&lt;b&gt;🎯 DEFENSE-IN-DEPTH GUARANTEE:&lt;/b&gt; Unified entry point for Apollo Federation v2 with Zero-Trust network policies, distroless runtime hardening, edge JWT validation, GraphQL AST complexity limits, and pre-fetch field authorization. Clients execute single federated queries while downstream microservices remain completely shielded from DoS, recursion exploits, and unauthorized traversal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="50" y="860" width="1820" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e14_1" parent="1" value="POST /graphql" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" source="n14_client_req" target="n14_ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_2" parent="1" value="TCP 8080 Allow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6366F1;strokeWidth=2;" edge="1" source="n14_ingress" target="n14_l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_3" parent="1" value="Sanitized HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="n14_l4" target="n14_l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_4" parent="1" value="JWKS Certs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EC4899;strokeWidth=1.5;dashed=1;" edge="1" source="n14_l1" target="n14_kc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_5" parent="1" value="Claims OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=1.5;" edge="1" source="n14_l1" target="n14_l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_6" parent="1" value="AST Checked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="n14_l3" target="n14_l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_7" parent="1" value="Authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="n14_l2" target="n14_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_8" parent="1" value="Invalid AST / Auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF4444;strokeWidth=1.5;dashed=1;" edge="1" source="n14_l2" target="n14_kill">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_9" parent="1" value="Entity Query (@key)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="n14_engine" target="n14_prod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_10" parent="1" value="Entity Query (@key)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="n14_engine" target="n14_inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_11" parent="1" value="Propagate Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="n14_engine" target="n14_ord">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14_12" parent="1" value="Export OTLP Spans" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=1.5;dashed=1;" edge="1" source="n14_engine" target="n14_otel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_graphql_supergraph_seq" name="15. Sequence - GraphQL Supergraph Request Lifecycle &amp; Edge Protection">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t15" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;SEQUENCE: GRAPHQL SUPERGRAPH REQUEST LIFECYCLE &amp;amp; FAIL-CLOSED EDGE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Chronological execution flow • Pre-fetch field authorization kill-switch • Parallel Apollo Federation v2 entity resolution&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="250" y="25" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p15_client" parent="1" value="&lt;b&gt;1. Client / SPA&lt;/b&gt;&lt;br&gt;(React 19 Frontend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="100" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p15_ingress" parent="1" value="&lt;b&gt;2. L6: NetPol / Ingress&lt;/b&gt;&lt;br&gt;(Port 8080 Allow-list)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="340" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p15_cosmo" parent="1" value="&lt;b&gt;3. Cosmo Router&lt;/b&gt;&lt;br&gt;(L5/L4/L3/L2 Gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11;" vertex="1">
          <mxGeometry x="640" y="100" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p15_kc" parent="1" value="&lt;b&gt;4. Keycloak IAM&lt;/b&gt;&lt;br&gt;(JWKS Public Certs :8181)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="100" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p15_prod" parent="1" value="&lt;b&gt;5. Products Subgraph&lt;/b&gt;&lt;br&gt;(Port 8004 • @key: sku)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1240" y="100" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p15_inv" parent="1" value="&lt;b&gt;6. Inventory Subgraph&lt;/b&gt;&lt;br&gt;(Port 8001 • @key: sku)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1470" y="100" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p15_ord" parent="1" value="&lt;b&gt;7. Orders Subgraph&lt;/b&gt;&lt;br&gt;(Port 8003 • @authenticated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1700" y="100" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l15_client" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="160" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="l15_ingress" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="430" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="l15_cosmo" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="750" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="l15_kc" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1055" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="l15_prod" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1325" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="l15_inv" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1555" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="l15_ord" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1785" y="150" width="10" height="770" as="geometry" />
        </mxCell>
        <mxCell id="s15_1" parent="1" value="1. Client dispatches POST /graphql (query { products { sku name price isInStock } }) + Bearer JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="160" y="175" width="270" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_2" parent="1" value="2. Layer 6 NetPol admits TCP 8080 traffic into Cosmo Router from frontend namespace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="430" y="220" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_3" parent="1" value="3. Layer 4: Traffic Shaping &amp;amp; CORS verification (body &amp;lt;= 1MB, allowed origins: localhost:5173)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="265" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_4" parent="1" value="4. Layer 1: Verify token signature against cached Keycloak JWKS certs (RS256 enforced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="310" width="305" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_5" parent="1" value="5. Keycloak confirms token validity; Cosmo extracts claims (sub, roles, username)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="355" width="305" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_6" parent="1" value="6. Layer 3: AST inspection verifies depth &amp;lt;= 12, total fields &amp;lt;= 250, root aliases &amp;lt;= 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="400" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_7" parent="1" value="7. Layer 2: Pre-Fetch Field Auth checks @authenticated directives across operation targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="445" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_fail_box" parent="1" value="&lt;b&gt;❌ FAIL-CLOSED FORK: UNAUTHORIZED OR MALICIOUS AST DETECTED&lt;/b&gt;&lt;br&gt;8a. Immediate HTTP 401 / 400 rejection sent to client. Request killed at router edge.&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Zero execution plan created. Subgraphs and PostgreSQL databases experience 0 CPU/RAM impact." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="160" y="495" width="590" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s15_auth_box" parent="1" value="&lt;b&gt;✅ AUTHORIZED PATH: PARALLEL APOLLO FEDERATION v2 RESOLUTION&lt;/b&gt;&lt;br&gt;Cosmo Router queries execution-config.json and constructs parallel execution plan across subgraphs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="750" y="570" width="1035" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s15_8" parent="1" value="8b. Concurrent query to Products Subgraph (resolve base product fields: sku, name, price)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="630" width="575" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_9" parent="1" value="9b. Products Service returns catalog records [{ sku: 'SKU-001', name: 'Laptop', price: 1200 }]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="675" width="575" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_10" parent="1" value="10b. Concurrent query to Inventory Subgraph resolving Product entity by @key(fields: 'sku')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="720" width="805" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_11" parent="1" value="11b. Inventory Service returns stock data [{ sku: 'SKU-001', isInStock: true, quantity: 45 }]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="750" y="765" width="805" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_12" parent="1" value="12. Cosmo Router merges entity partials into unified GraphQL response in Go memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="430" y="810" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_13" parent="1" value="13. HTTP 200 OK delivered to React 19 Client with full data payload (p95 latency &amp;lt; 20ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="160" y="855" width="590" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s15_summary" parent="1" value="&lt;b&gt;🎯 DETERMINISTIC EDGE PROTECTION:&lt;/b&gt; By compiling subgraphs into a deterministic execution plan, Cosmo Router acts as a cryptographic, semantic, and network firewall. Downstream microservices focus purely on domain logic without worrying about DoS recursion, query inflation, or unauthorized calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="80" y="915" width="1790" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_pos_qr_omnichannel" name="16. Agnostic POS QR Scanner &amp; Omnichannel Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t16" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;AGNOSTIC POS QR SCANNER &amp;amp; OMNICHANNEL STOREFRONT ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;React 19 • Dual-Engine BarcodeDetector + jsQR • Spring Microservices Correlation • PostgreSQL TEXT Persist &amp;amp; Redis • DevSecOps Permissions-Policy&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="250" y="25" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c16_input" parent="1" value="&lt;b&gt;📷 CAPTURE &amp;amp; INPUT MODALITIES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="50" y="100" width="310" height="750" as="geometry" />
        </mxCell>
        <mxCell id="n16_cam" parent="1" value="&lt;b&gt;Live WebCam Stream (getUserMedia)&lt;/b&gt;&lt;br&gt;• Multi-tier lens fallback: ideal 720p ➔ unconstrained ➔ any&lt;br&gt;• 100ms mount lock (prevents DOM camera driver races)&lt;br&gt;• Zero async re-renders during active frame streaming&lt;br&gt;• Flip camera lens toggle (environment vs user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="70" y="160" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n16_file" parent="1" value="&lt;b&gt;File Dropzone &amp;amp; Image Upload&lt;/b&gt;&lt;br&gt;• Drag &amp;amp; drop or click to upload QR / Barcodes&lt;br&gt;• Supports PNG, JPG, WEBP, AVIF formats&lt;br&gt;• Clean separation: Dedicated tab without UI redundancy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="70" y="305" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n16_laser" parent="1" value="&lt;b&gt;Hardware POS Barcode Reader&lt;/b&gt;&lt;br&gt;• USB &amp;amp; Bluetooth HID laser scanner input&lt;br&gt;• Rapid keyboard emulation buffer detection&lt;br&gt;• Omnichannel retail cashier workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="70" y="430" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n16_receipt" parent="1" value="&lt;b&gt;Order Receipt QR Generator (ReceiptModal)&lt;/b&gt;&lt;br&gt;• Dynamic client-side rendering via QRCode.toCanvas&lt;br&gt;• Encodes Order ID, fulfillment tokens &amp;amp; timestamp&lt;br&gt;• Customer download (.png) &amp;amp; printable physical receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="70" y="555" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c16_engine" parent="1" value="&lt;b&gt;⚙️ CLIENT ENGINE &amp;amp; NGINX HARDENING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="390" y="100" width="330" height="750" as="geometry" />
        </mxCell>
        <mxCell id="n16_nginx" parent="1" value="&lt;b&gt;Nginx DevSecOps Security Gate&lt;/b&gt;&lt;br&gt;• &lt;code&gt;Permissions-Policy: camera=(self)...&lt;/code&gt;&lt;br&gt;• Authorizes origin WebCam access (fixes NotAllowedError)&lt;br&gt;• Restricts unauthorized third-party embeds &amp;amp; iframes&lt;br&gt;• Strict Content-Security-Policy &amp;amp; HSTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="410" y="160" width="290" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n16_dual" parent="1" value="&lt;b&gt;Universal Dual-Engine Decoder (QrScannerModal)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Tier 1 (Native):&lt;/b&gt; BarcodeDetector API (GPU/Chrome/Edge)&lt;br&gt;• &lt;b&gt;Tier 2 (Software):&lt;/b&gt; jsQR offscreen canvas (Firefox/Safari)&lt;br&gt;• Universal coverage: 100% desktop, tablet &amp;amp; mobile browsers&lt;br&gt;• Polyglot formats: QR_CODE, EAN_13, CODE_128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="410" y="305" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n16_payload" parent="1" value="&lt;b&gt;Intelligent Payload Classifier&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SKU Pattern:&lt;/b&gt; ^[A-Z0-9\-]{6,20}$ ➔ Product Inventory&lt;br&gt;• &lt;b&gt;Order Pattern:&lt;/b&gt; ORD-* or JSON ➔ Order Fulfillment&lt;br&gt;• Direct dispatch to Spring microservices or GraphQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="410" y="460" width="290" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n16_cart" parent="1" value="&lt;b&gt;React 19 Context &amp;amp; Toast Feedback&lt;/b&gt;&lt;br&gt;• Instant Add to Cart / Optimistic UI updates&lt;br&gt;• In-modal Admin POS actions (Stock +1, Ship, Deliver)&lt;br&gt;• Transparent RFC 7807 error toasts (no error masking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="410" y="595" width="290" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c16_edge" parent="1" value="&lt;b&gt;🛡️ EDGE ROUTER &amp;amp; IAM SECURITY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="750" y="100" width="300" height="750" as="geometry" />
        </mxCell>
        <mxCell id="n16_router" parent="1" value="&lt;b&gt;Cosmo Router 0.362.0 (Gateway)&lt;/b&gt;&lt;br&gt;• Port 8080 (/graphql)&lt;br&gt;• Apollo Federation v2 query planner&lt;br&gt;• JWT Bearer validation &amp;amp; claims pass-through&lt;br&gt;• Subgraph dispatch to Orders &amp;amp; Products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="770" y="170" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n16_keycloak" parent="1" value="&lt;b&gt;Keycloak 26 IAM (:8181)&lt;/b&gt;&lt;br&gt;• Realm: microservices-realm&lt;br&gt;• OIDC / OAuth2 signed JWTs (JWKS)&lt;br&gt;• Role Enforcement: ROLE_ADMIN, ROLE_INTERNAL_SERVICE, ROLE_USER&lt;br&gt;• Protects POS Admin stock, S2S mutations &amp;amp; fulfillment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="770" y="325" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n16_funnel_gw" parent="1" value="&lt;b&gt;Audit &amp;amp; Telemetry Gateway&lt;/b&gt;&lt;br&gt;• Reverse proxy to Orders Funnel API&lt;br&gt;• Sub-second non-blocking dispatch&lt;br&gt;• Zero impact on cashier scanning latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="770" y="480" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c16_spring" parent="1" value="&lt;b&gt;📦 SPRING MICROSERVICES CORRELATION (Java 21 / Spring Boot 4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="1080" y="100" width="380" height="750" as="geometry" />
        </mxCell>
        <mxCell id="n16_inv_svc" parent="1" value="&lt;b&gt;Inventory Service (:8001)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Authoritative Stock Lookup:&lt;/b&gt; GET /api/inventory/detail/{sku}&lt;br&gt;  Direct query against PostgreSQL (prevents stale client cache)&lt;br&gt;• &lt;b&gt;Live POS Adjustment:&lt;/b&gt; PUT /api/inventory/{sku}?quantity={qty}&lt;br&gt;  Instant +1 stock correction directly from cashier scanner modal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1100" y="160" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n16_ord_svc" parent="1" value="&lt;b&gt;Orders Service (:8003)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Live Order Verification:&lt;/b&gt; Resolves order status, items, address&lt;br&gt;• &lt;b&gt;Omnichannel POS Fulfillment:&lt;/b&gt;&lt;br&gt;  mutation { shipOrder(id) } ➔ SHIPPED&lt;br&gt;  mutation { deliverOrder(id) } ➔ DELIVERED&lt;br&gt;• &lt;b&gt;Audit Telemetry Ingestion:&lt;/b&gt; POST /api/order/funnel&lt;br&gt;  Captures QR_PRODUCT_SCANNED &amp;amp; QR_ORDER_SCANNED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1100" y="315" width="340" height="155" as="geometry" />
        </mxCell>
        <mxCell id="n16_prod_svc" parent="1" value="&lt;b&gt;Products Service (:8004)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Image Upload Handling:&lt;/b&gt; Compressed base64 Data URL (≤ 256KiB)&lt;br&gt;• &lt;b&gt;Strict Field Validation:&lt;/b&gt; SKU &amp;amp; Name regex patterns&lt;br&gt;• &lt;b&gt;RFC 7807 Exception Aggregator:&lt;/b&gt; GlobalExceptionHandler joins field errors into 'message' &amp;amp; 'fields' map for client transparency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1100" y="500" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n16_notif_svc" parent="1" value="&lt;b&gt;Notification Service (:8002)&lt;/b&gt;&lt;br&gt;• Consumes Kafka fulfillment events&lt;br&gt;• Dispatches customer delivery notification &amp;amp; authenticated tenant-scoped SSE update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1100" y="665" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c16_data" parent="1" value="&lt;b&gt;💾 PERSISTENCE, CACHE &amp;amp; EVENT STREAM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="1490" y="100" width="380" height="750" as="geometry" />
        </mxCell>
        <mxCell id="n16_db_inv" parent="1" value="&lt;b&gt;db-inventory (PostgreSQL :5431)&lt;/b&gt;&lt;br&gt;• Table: inventory (sku, quantity, reserved)&lt;br&gt;• Transactional row-level lock (Pessimistic write)&lt;br&gt;• Atomic updates prevent race conditions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1510" y="160" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n16_db_ord" parent="1" value="&lt;b&gt;db-orders (PostgreSQL :5432)&lt;/b&gt;&lt;br&gt;• Table: orders &amp;amp; order_items&lt;br&gt;• Stateful transitions: CONFIRMED ➔ SHIPPED ➔ DELIVERED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1510" y="285" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n16_db_prod" parent="1" value="&lt;b&gt;db-products (PostgreSQL :5433)&lt;/b&gt;&lt;br&gt;• Column: TEXT imageUrl (unbounded text field)&lt;br&gt;• Enforces SKU uniqueness constraint" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1510" y="410" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n16_redis" parent="1" value="&lt;b&gt;Redis 8.8 (products-cache :6379)&lt;/b&gt;&lt;br&gt;• Sub-millisecond catalog caching&lt;br&gt;• Cache eviction on product create/update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1510" y="530" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n16_kafka" parent="1" value="&lt;b&gt;Apache Kafka 8.3.2 KRaft (:9092)&lt;/b&gt;&lt;br&gt;• Topic: orders-topic (order-shipped, order-delivered)&lt;br&gt;• Topic: order-funnel-topic (scanner audit &amp;amp; telemetry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1510" y="640" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e16_cam_dual" parent="1" value="Video Frames" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_cam" target="n16_dual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_file_dual" parent="1" value="Image Bitmap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_file" target="n16_dual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_laser_dual" parent="1" value="HID Buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_laser" target="n16_dual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_dual_payload" parent="1" value="Decoded String" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=2;fontSize=10;" edge="1" source="n16_dual" target="n16_payload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_payload_inv" parent="1" value="GET /api/inventory/detail/{sku}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;fontSize=10;" edge="1" source="n16_payload" target="n16_inv_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_cart_adjust" parent="1" value="Admin PUT +1 Stock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_cart" target="n16_inv_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_payload_router" parent="1" value="GraphQL Order Ops" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=2;fontSize=10;" edge="1" source="n16_payload" target="n16_router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_router_ord" parent="1" value="shipOrder / deliverOrder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=2;fontSize=10;" edge="1" source="n16_router" target="n16_ord_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_payload_funnel" parent="1" value="Telemetry (non-blocking)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;strokeDasharray=3 3;fontSize=10;" edge="1" source="n16_payload" target="n16_funnel_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_funnel_ord" parent="1" value="POST /api/order/funnel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;strokeDasharray=3 3;fontSize=10;" edge="1" source="n16_funnel_gw" target="n16_ord_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_inv_db" parent="1" value="Atomic Lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_inv_svc" target="n16_db_inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_ord_db" parent="1" value="Stateful Update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_ord_svc" target="n16_db_ord">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_ord_kafka" parent="1" value="Publish Fulfillment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_ord_svc" target="n16_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_prod_db" parent="1" value="TEXT Base64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_prod_svc" target="n16_db_prod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_prod_redis" parent="1" value="Cache Evict / Put" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_prod_svc" target="n16_redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16_kafka_notif" parent="1" value="Consume Event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;" edge="1" source="n16_kafka" target="n16_notif_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n16_legend" parent="1" value="&lt;b&gt;🎯 ENTERPRISE OMNICHANNEL SCANNER &amp;amp; HARDENED LIFECYCLE:&lt;/b&gt; Eliminates camera race conditions by combining a 100ms mount lock with a tiered native BarcodeDetector / jsQR software fallback. Nginx Permissions-Policy &lt;code&gt;camera=(self)&lt;/code&gt; guarantees browser camera activation while blocking unauthorized iframe embedding. Bidirectional correlation directly queries authoritative PostgreSQL inventory and drives live POS order fulfillment through federated GraphQL mutations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="50" y="870" width="1820" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_level5_resilience" name="17. Level 5 Hyper-Scale Resilience &amp; Cell-Based Architecture Blueprint">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t17" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;LEVEL 5 HYPER-SCALE RESILIENCE &amp;amp; CELL-BASED ARCHITECTURE BLUEPRINT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Zero Dual-Write Transactional Outbox • Distributed Redis 8 Idempotency • Non-Blocking Dead Letter Queue (DLQ) • Netflix Vegas Adaptive Concurrency Limits • Cell-Based Multi-Tenancy • Chaos Drills&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c17_cells" parent="1" value="&lt;b&gt;🌐 PILLAR 5: CELL-BASED ARCHITECTURE &amp;amp; BLAST RADIUS ISOLATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="50" y="85" width="410" height="700" as="geometry" />
        </mxCell>
        <mxCell id="n17_ingress" parent="1" value="&lt;b&gt;Client / External Ingress&lt;/b&gt;&lt;br&gt;Requests with &lt;code&gt;X-Cell-ID&lt;/code&gt; header&lt;br&gt;(or auto-routed via Hash Modulo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="70" y="130" width="370" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n17_cell_router" parent="1" value="&lt;b&gt;Cell Router Gateway (Envoy / Cosmo)&lt;/b&gt;&lt;br&gt;&lt;code&gt;k8s/cells/cell-router.yaml&lt;/code&gt;&lt;br&gt;Inspects client partition &amp;amp; context&lt;br&gt;Metrics: &lt;code&gt;ecommerce_cell_requests_total&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="70" y="220" width="370" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n17_cell_alpha" parent="1" value="&lt;b&gt;Cell-Alpha Partition (Isolated Domain)&lt;/b&gt;&lt;br&gt;&lt;code&gt;k8s/cells/cell-alpha.yaml&lt;/code&gt;&lt;br&gt;• orders-service-alpha (Port 8003)&lt;br&gt;• db-orders-alpha (PostgreSQL 18)&lt;br&gt;• redis-cell-alpha (Session &amp;amp; Idempotency)&lt;br&gt;• Blast radius strictly quarantined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="70" y="320" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n17_cell_beta" parent="1" value="&lt;b&gt;Cell-Beta Partition (Isolated Domain)&lt;/b&gt;&lt;br&gt;&lt;code&gt;k8s/cells/cell-beta.yaml&lt;/code&gt;&lt;br&gt;• orders-service-beta (Port 8003)&lt;br&gt;• db-orders-beta (PostgreSQL 18)&lt;br&gt;• redis-cell-beta (Session &amp;amp; Idempotency)&lt;br&gt;• Zero cross-cell cascading failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="70" y="465" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n17_cell_summary" parent="1" value="&lt;b&gt;💡 Blast Radius Guarantee:&lt;/b&gt; Failure in Cell-Alpha (e.g. database corruption or traffic spike) leaves Cell-Beta 100% operational, maintaining multi-tenant platform survival." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="70" y="610" width="370" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e17_in_router" parent="1" value="Inspect Cell Header" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="n17_ingress" target="n17_cell_router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_router_alpha" parent="1" value="X-Cell-ID: cell-alpha" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;" edge="1" source="n17_cell_router" target="n17_cell_alpha">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_router_beta" parent="1" value="X-Cell-ID: cell-beta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=1.5;" edge="1" source="n17_cell_router" target="n17_cell_beta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17_filters" parent="1" value="&lt;b&gt;🛡️ PILLARS 4 &amp;amp; 1: VEGAS ADAPTIVE LIMITS &amp;amp; IDEMPOTENCY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="490" y="85" width="430" height="700" as="geometry" />
        </mxCell>
        <mxCell id="n17_cell_filter" parent="1" value="&lt;b&gt;1. CellContextFilter (Servlet Entry)&lt;/b&gt;&lt;br&gt;Extracts &lt;code&gt;X-Cell-ID&lt;/code&gt; &amp;amp; injects into MDC / ThreadLocal&lt;br&gt;Tags Prometheus &lt;code&gt;ecommerce_cell_requests_total&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="510" y="130" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n17_vegas_filter" parent="1" value="&lt;b&gt;2. AdaptiveConcurrencyFilter (Netflix Vegas AIMD)&lt;/b&gt;&lt;br&gt;• Dynamic Capacity Headroom (Min RTT vs Smooth RTT)&lt;br&gt;• Metric: &lt;code&gt;ecommerce_adaptive_concurrency_limit&lt;/code&gt;&lt;br&gt;• In-Flight: &lt;code&gt;ecommerce_adaptive_inflight_requests&lt;/code&gt;&lt;br&gt;• Traffic Shedding: HTTP 429/503 for non-critical requests&lt;br&gt;• Metric: &lt;code&gt;ecommerce_traffic_shed_total&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="510" y="220" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n17_idemp_filter" parent="1" value="&lt;b&gt;3. IdempotencyFilter (Distributed Redis Lock)&lt;/b&gt;&lt;br&gt;• Intercepts &lt;code&gt;X-Idempotency-Key&lt;/code&gt; header&lt;br&gt;• Redis 8 atomic &lt;code&gt;SETNX&lt;/code&gt; with lease TTL (300s)&lt;br&gt;• In-progress conflict ➔ HTTP 409 Conflict&lt;br&gt;• Cached response ➔ HTTP 200 with stored payload&lt;br&gt;• Metric: &lt;code&gt;ecommerce_idempotency_hits_total&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="510" y="365" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="n17_redis_store" parent="1" value="&lt;b&gt;Redis 8 Cluster (Distributed Store)&lt;/b&gt;&lt;br&gt;Atomic Key Store: &lt;code&gt;idempotency:{key}&lt;/code&gt;&lt;br&gt;Stores status: &lt;code&gt;IN_PROGRESS&lt;/code&gt; / &lt;code&gt;COMPLETED&lt;/code&gt;&lt;br&gt;Stores serialized HTTP response body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=11;" vertex="1">
          <mxGeometry x="510" y="515" width="390" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n17_filter_summary" parent="1" value="&lt;b&gt;💡 Concurrency vs Brownout:&lt;/b&gt; Replaces static thread pools with dynamic TCP congestion control. Concurrency limit auto-tunes in microsecond granularity to protect CPU &amp;amp; DB connection pools." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="510" y="610" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e17_cell_vegas" parent="1" value="Passes Cell Context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="n17_cell_filter" target="n17_vegas_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_vegas_idemp" parent="1" value="Within Concurrency Limit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="n17_vegas_filter" target="n17_idemp_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_idemp_redis" parent="1" value="SETNX &amp;amp; GET Cached" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EC4899;strokeWidth=1.5;" edge="1" source="n17_idemp_filter" target="n17_redis_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17_outbox" parent="1" value="&lt;b&gt;📦 PILLAR 2: TRANSACTIONAL OUTBOX &amp;amp; ZERO DUAL-WRITE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="950" y="85" width="430" height="700" as="geometry" />
        </mxCell>
        <mxCell id="n17_orders_domain" parent="1" value="&lt;b&gt;Orders Service Business Logic&lt;/b&gt;&lt;br&gt;Create / Cancel Order via &lt;code&gt;OrderService&lt;/code&gt;&lt;br&gt;Orchestrates state machine in domain boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="970" y="130" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n17_db_acid" parent="1" value="&lt;b&gt;PostgreSQL 18 Atomic ACID Boundary&lt;/b&gt;&lt;br&gt;Single &lt;code&gt;@Transactional&lt;/code&gt; Commit:&lt;br&gt;1. Insert / Update &lt;code&gt;orders&lt;/code&gt; record&lt;br&gt;2. Insert &lt;code&gt;outbox_events&lt;/code&gt; record (PENDING)&lt;br&gt;&lt;b&gt;Zero dual-write gap:&lt;/b&gt; Never commits DB without event" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="970" y="220" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n17_outbox_poller" parent="1" value="&lt;b&gt;OutboxProcessor (Async Poller)&lt;/b&gt;&lt;br&gt;• Runs on 500ms fixed delay&lt;br&gt;• Queries &lt;code&gt;outbox_events WHERE status='PENDING'&lt;/code&gt;&lt;br&gt;• Batch fetch with optimistic locking&lt;br&gt;• Asynchronously dispatches to Kafka broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="970" y="355" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n17_state_writer" parent="1" value="&lt;b&gt;OutboxEventStateWriter (Isolated Bean)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;@Transactional(REQUIRES_NEW)&lt;/code&gt;&lt;br&gt;• SonarCloud S2229 compliant (No self-invocation)&lt;br&gt;• Marks status &lt;code&gt;PUBLISHED&lt;/code&gt; or &lt;code&gt;FAILED&lt;/code&gt;&lt;br&gt;• Metrics: &lt;code&gt;ecommerce_outbox_events_published_total&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="970" y="475" width="390" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n17_outbox_summary" parent="1" value="&lt;b&gt;💡 Zero Dual-Write Guarantee:&lt;/b&gt; Decouples database mutations from network broker availability. If Kafka is temporarily partitioned, database commits succeed and events buffer safely in PostgreSQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="970" y="610" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e17_ord_acid" parent="1" value="Single ACID Transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="n17_orders_domain" target="n17_db_acid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_acid_poller" parent="1" value="Poll PENDING Events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=1.5;" edge="1" source="n17_db_acid" target="n17_outbox_poller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_poller_writer" parent="1" value="Update State (REQUIRES_NEW)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;" edge="1" source="n17_outbox_poller" target="n17_state_writer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c17_dlq" parent="1" value="&lt;b&gt;☠️ PILLARS 3 &amp;amp; 6: NON-BLOCKING DLQ &amp;amp; CHAOS DRILLS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1410" y="85" width="450" height="700" as="geometry" />
        </mxCell>
        <mxCell id="n17_kafka_broker" parent="1" value="&lt;b&gt;Apache Kafka 8.3.2 (KRaft)&lt;/b&gt;&lt;br&gt;Topic: &lt;code&gt;orders-topic&lt;/code&gt; (Main Stream)&lt;br&gt;Topic: &lt;code&gt;orders-topic.DLT&lt;/code&gt; (Dead Letter Topic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="1430" y="130" width="410" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n17_retry_consumer" parent="1" value="&lt;b&gt;OrderProcessingConsumer (Resilient Consumer)&lt;/b&gt;&lt;br&gt;• &lt;code&gt;@RetryableTopic&lt;/code&gt; with exponential backoff (1s, 2s, 4s)&lt;br&gt;• Non-blocking retry: Healthy events bypass retrying ones&lt;br&gt;• Unparseable / fatal payloads ➔ routed to &lt;code&gt;@DltHandler&lt;/code&gt;&lt;br&gt;• Metric: &lt;code&gt;ecommerce_kafka_dlq_total&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1430" y="220" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n17_dlq_ops" parent="1" value="&lt;b&gt;Operational DLQ Replay CLI Tool&lt;/b&gt;&lt;br&gt;&lt;code&gt;scripts/prod/kafka-ops.sh replay-dlq&lt;/code&gt;&lt;br&gt;• Reads quarantined poison pills from &lt;code&gt;orders-topic.DLT&lt;/code&gt;&lt;br&gt;• Inspects failure reason &amp;amp; stacktrace metadata&lt;br&gt;• Safely replays unblocked events back to main topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#0C4A6E;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1430" y="355" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n17_chaos_suite" parent="1" value="&lt;b&gt;Chaos Drills Automation Suite (Pillar 6)&lt;/b&gt;&lt;br&gt;&lt;code&gt;scripts/chaos/run-chaos-drills.ps1&lt;/code&gt; &amp;amp; &lt;code&gt;.sh&lt;/code&gt;&lt;br&gt;• Scenario 1: Poison Pill Injection (quarantine check)&lt;br&gt;• Scenario 2: Network Latency Injection (Vegas shedding)&lt;br&gt;• Scenario 3: Cell Evacuation &amp;amp; Failover&lt;br&gt;• Scenario 4: Concurrent Duplicate Flooding (Idempotency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1430" y="480" width="410" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n17_dlq_summary" parent="1" value="&lt;b&gt;💡 Zero Head-of-Line Blocking:&lt;/b&gt; Eliminates consumer lag build-up caused by poisoned messages. Corrupt events are quarantined instantly to DLT while valid traffic processes at full wire speed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="1430" y="610" width="410" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e17_poller_kafka" parent="1" value="Async Event Dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F59E0B;strokeWidth=1.5;" edge="1" source="n17_outbox_poller" target="n17_kafka_broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_kafka_consumer" parent="1" value="Consume @RetryableTopic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="n17_kafka_broker" target="n17_retry_consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_consumer_dlt" parent="1" value="Exhausted ➔ Quarantine to DLT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF4444;strokeWidth=1.5;" edge="1" source="n17_retry_consumer" target="n17_dlq_ops">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17_chaos_drill" parent="1" value="Inject Faults &amp;amp; Verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF4444;strokeWidth=1.5;dashed=1;" edge="1" source="n17_chaos_suite" target="n17_retry_consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n17_banner" parent="1" value="&lt;b&gt;📊 SRE OBSERVABILITY &amp;amp; EXECUTIVE CONVERGENCE (Live Telemetry in Grafana Port 3000):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Business Dashboard:&lt;/b&gt; Executive Financial Reconciliation Triad — Gross Orders Placed (7) vs Cancelled Orders &amp;amp; Loss (4) = True Net Completed Orders (3) • Order Cancellation Rate (% OCR) • Reconciled AOV ($/Net Order) • Live Cart Abandonment Rate (75%).&lt;br&gt;• &lt;b&gt;Technical Dashboard (Level 5 SRE Row):&lt;/b&gt; Vegas Adaptive Concurrency Limits vs In-Flight Requests • Kafka DLQ Quarantined &amp;amp; Traffic Shedding Rates • Cell-Based Traffic Routing (cell-alpha vs cell-beta) &amp;amp; Transactional Outbox Dispatches." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11.5;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="50" y="805" width="1810" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_platform_layers_a_to_e" name="18. Platform Layers A to E Implementation Blueprint">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t18" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;PLATFORM LAYERS A TO E IMPLEMENTATION BLUEPRINT (DOCKER COMPOSE &amp;amp; MINIKUBE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Unified Architectural Parity: Layer A (Service Mesh) • Layer B (Edge Federation) • Layer C (Kafka Sagas) • Layer D (Observability) • Layer E (Secrets Management)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="250" y="25" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n18_la_hdr" parent="1" value="&lt;b&gt;🛡️ LAYER A: SERVICE MESH &amp;amp; NETWORK SECURITY&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Zero-Trust mTLS &amp;amp; Least-Privilege Access&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#3730A3;fontSize=12;" vertex="1">
          <mxGeometry x="55" y="100" width="345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18_la_1" parent="1" value="&lt;b&gt;Istio Service Mesh (Minikube)&lt;/b&gt;&lt;br&gt;• STRICT mTLS across dev, staging &amp;amp; prod&lt;br&gt;• Default PeerAuthentication: STRICT&lt;br&gt;• Workload SPIFFE Identity validation&lt;br&gt;• DestinationRules connection pooling &amp;amp; circuit breakers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="55" y="175" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_la_2" parent="1" value="&lt;b&gt;Least-Privilege AuthorizationPolicies&lt;/b&gt;&lt;br&gt;• default-deny-all baseline in all namespaces&lt;br&gt;• allow-ingress-to-edge / frontend&lt;br&gt;• allow-router-to-subgraphs (ports 8001-8087)&lt;br&gt;• allow-orders-to-downstream (S2S mTLS)&lt;br&gt;• allow-observability-scraping (Prometheus/Alloy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="55" y="320" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_la_3" parent="1" value="&lt;b&gt;L3/L4 Network Isolation &amp;amp; Parity&lt;/b&gt;&lt;br&gt;• K8s NetworkPolicies (ingress &amp;amp; egress rules)&lt;br&gt;• Docker Compose bridge isolation:&lt;br&gt;  - frontend-net (Public &amp;amp; Edge routes)&lt;br&gt;  - backend-net (Private transactional core)&lt;br&gt;  - data-net (Dedicated database network)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="55" y="480" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_la_4" parent="1" value="&lt;b&gt;Strategic Roadmap: Ambient Mode&lt;/b&gt;&lt;br&gt;• Evaluation for hyper-scale production&lt;br&gt;• In-node ztunnel L4 mTLS daemon&lt;br&gt;• Waypoint proxies for L7 authorization&lt;br&gt;• Eliminates ~100MB RAM sidecar per pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="55" y="640" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_lb_hdr" parent="1" value="&lt;b&gt;🚀 LAYER B: EDGE FEDERATION &amp;amp; IDENTITY&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;GraphQL Federation v2 &amp;amp; OIDC Gateway&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=12;" vertex="1">
          <mxGeometry x="420" y="100" width="345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18_lb_1" parent="1" value="&lt;b&gt;Cosmo Router Gateway v2 (Go)&lt;/b&gt;&lt;br&gt;• Apollo Federation v2 Supergraph Execution&lt;br&gt;• Static compiled execution-config.json&lt;br&gt;• Subgraph query planning across all 9 services&lt;br&gt;• HTTP/2, WebSocket subscriptions, OTLP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="420" y="175" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_lb_2" parent="1" value="&lt;b&gt;Keycloak 26 IAM (OIDC / OAuth2)&lt;/b&gt;&lt;br&gt;• microservices-realm authentication realm&lt;br&gt;• RS256 JWKS public keys (/certs)&lt;br&gt;• Role-Based Access Control (RBAC):&lt;br&gt;  ROLE_ADMIN, ROLE_INTERNAL_SERVICE, ROLE_USER&lt;br&gt;• PKCE authorization flow for React SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="420" y="320" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_lb_3" parent="1" value="&lt;b&gt;JWKS Stale-While-Revalidate Caching&lt;/b&gt;&lt;br&gt;• refresh_unknown_kid: enabled (max_wait 10s)&lt;br&gt;• Background refresh interval: 5m&lt;br&gt;• Prevents edge rejection on Keycloak hiccups&lt;br&gt;• Token header propagation (Bearer, Idempotency,&lt;br&gt;  W3C traceparent, X-Correlation-ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="420" y="480" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_lb_4" parent="1" value="&lt;b&gt;GraphQL Defense-in-Depth Guardrails&lt;/b&gt;&lt;br&gt;• Query Depth limiting: &amp;le; 12 levels&lt;br&gt;• Query Alias limiting: &amp;le; 5 aliases&lt;br&gt;• Max request payload size: 1 MiB&lt;br&gt;• @authenticated pre-fetch field kill-switch&lt;br&gt;• Anonymous catalog browsing preserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#831843;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="420" y="640" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_lc_hdr" parent="1" value="&lt;b&gt;⚡ LAYER C: EVENT-DRIVEN MESSAGING &amp;amp; SAGAS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Asynchronous Sagas &amp;amp; Distributed Idempotency&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=12;" vertex="1">
          <mxGeometry x="785" y="100" width="345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18_lc_1" parent="1" value="&lt;b&gt;Apache Kafka 3.x (KRaft Mode)&lt;/b&gt;&lt;br&gt;• Zookeeper-less distributed consensus&lt;br&gt;• High-throughput partitioned topics:&lt;br&gt;  orders-topic &amp;bull; payments-topic &amp;bull; fulfillment-topic&lt;br&gt;• Minikube &amp;amp; Compose identical cluster topology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="785" y="175" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_lc_2" parent="1" value="&lt;b&gt;Redis 7.x Distributed Idempotency&lt;/b&gt;&lt;br&gt;• Atomic SETNX with 24h Time-To-Live (TTL)&lt;br&gt;• X-Idempotency-Key request deduplication&lt;br&gt;• Guaranteed single execution for financial actions&lt;br&gt;• Rejects concurrent duplicate orders/payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="785" y="320" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_lc_3" parent="1" value="&lt;b&gt;Transactional Outbox Pattern&lt;/b&gt;&lt;br&gt;• Database outbox table records event state&lt;br&gt;• Background scheduler polls &amp;amp; dispatches to Kafka&lt;br&gt;• Eliminates dual-write partial failures&lt;br&gt;• Zero phantom reads; at-least-once guarantee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="785" y="480" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_lc_4" parent="1" value="&lt;b&gt;DLQ Quarantining &amp;amp; Schema Safety&lt;/b&gt;&lt;br&gt;• @RetryableTopic non-blocking backoff (1s, 2s, 4s)&lt;br&gt;• Poison pills quarantined to orders-topic.DLT&lt;br&gt;• CLI replay automation via scripts/prod/kafka-ops.sh&lt;br&gt;• Shared event contracts across Java, Go, TS &amp;amp; Python" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="785" y="640" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_ld_hdr" parent="1" value="&lt;b&gt;📊 LAYER D: FULL-STACK OBSERVABILITY PIPELINE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Unified LGTM Stack &amp;amp; FinOps Intelligence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#065F46;fontSize=12;" vertex="1">
          <mxGeometry x="1150" y="100" width="345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18_ld_1" parent="1" value="&lt;b&gt;Unified LGTM Observability Stack&lt;/b&gt;&lt;br&gt;• Prometheus 3.x: Scrapes all 9 core services&lt;br&gt;• Loki 3.x: Structured multiline log storage&lt;br&gt;• Tempo 3.x: OpenTelemetry distributed trace store&lt;br&gt;• Grafana 13.x: Unified visualization &amp;amp; dashboards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1150" y="175" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_ld_2" parent="1" value="&lt;b&gt;Bidirectional Trace-to-Log Correlation&lt;/b&gt;&lt;br&gt;• Loki derivedFields: Regex captures traceId &amp;amp;&lt;br&gt;  renders instant 1-click 'Tempo' trace button&lt;br&gt;• Tempo tracesToLogsV2: Span navigates to Loki&lt;br&gt;• Instant RCA from 500 error log to trace waterfall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1150" y="320" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_ld_3" parent="1" value="&lt;b&gt;Grafana Alloy Telemetry Daemon&lt;/b&gt;&lt;br&gt;• DaemonSet log scraping &amp;amp; multiline aggregation&lt;br&gt;• OTLP trace ingestion &amp;amp; batch forwarding (4317/4318)&lt;br&gt;• Live web debugging interface on port 3300&lt;br&gt;• In-memory buffer &amp;amp; resilient retry forwarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1150" y="480" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_ld_4" parent="1" value="&lt;b&gt;OpenCost FinOps Real-Time UI (:7000)&lt;/b&gt;&lt;br&gt;• Container &amp;amp; namespace spend allocation&lt;br&gt;• Real-time CPU, RAM &amp;amp; storage cost tracking&lt;br&gt;• Prometheus metrics engine integration&lt;br&gt;• Cluster budget adherence &amp;amp; rightsizing insights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1150" y="640" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_le_hdr" parent="1" value="&lt;b&gt;🔒 LAYER E: SECRETS MANAGEMENT &amp;amp; ZERO-TRUST&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Vault KV-v2, Transit Encryption &amp;amp; ESO&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;" vertex="1">
          <mxGeometry x="1515" y="100" width="345" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18_le_1" parent="1" value="&lt;b&gt;HashiCorp Vault KV-v2 (Port 8200)&lt;/b&gt;&lt;br&gt;• Encrypted secret engine mounted at secret/&lt;br&gt;• Application database &amp;amp; JWT master secrets&lt;br&gt;• Per-service isolated secret paths&lt;br&gt;• Audit logging device enabled to /vault/file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1515" y="175" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_le_2" parent="1" value="&lt;b&gt;Transit Encryption Engine (AES-256-GCM)&lt;/b&gt;&lt;br&gt;• Key: transit/keys/microservices-data-key&lt;br&gt;• Cryptographic envelope encryption at rest&lt;br&gt;• Microservices encrypt PII before database storage&lt;br&gt;• Centralized cryptographic key lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1515" y="320" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_le_3" parent="1" value="&lt;b&gt;Dynamic Database Engine (PostgreSQL 18)&lt;/b&gt;&lt;br&gt;• Automatic ephemeral credential generation&lt;br&gt;• Dedicated roles: postgres-*-db-role&lt;br&gt;• Leased credentials with 1h default TTL&lt;br&gt;• Automated revocation upon lease expiration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1515" y="480" width="345" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n18_le_4" parent="1" value="&lt;b&gt;External Secrets Operator (ESO) &amp;amp; Compose Parity&lt;/b&gt;&lt;br&gt;• K8s SecretStore connects to Vault KV-v2&lt;br&gt;• ExternalSecret syncs to microservices-secrets&lt;br&gt;• Compose auto-seeding via vault-init container&lt;br&gt;• Zero hardcoded credentials across git repos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#4C1D95;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1515" y="640" width="345" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n18_banner" parent="1" value="&lt;b&gt;⚙️ DEPLOYMENT RUNTIME PARITY (DOCKER COMPOSE &amp;bull; KUBERNETES MINIKUBE):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Docker Compose:&lt;/b&gt; &lt;code&gt;compose.yaml&lt;/code&gt; spins up all 9 microservices, Keycloak 26, Cosmo Router, Kafka KRaft, Redis, Vault, Postgres, and LGTM Observability on identical port bindings.&lt;br&gt;• &lt;b&gt;Minikube (Kubernetes):&lt;/b&gt; &lt;code&gt;platform-minikube.ps1 up&lt;/code&gt; provisions full Istio STRICT mTLS mesh, ArgoCD GitOps, OpenCost FinOps, KEDA autoscalers, and Gatekeeper policies with 100% architectural parity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11.5;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="55" y="795" width="1805" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>