        </mxCell>
        <mxCell id="n_v2" parent="1" value="&lt;b&gt;products-service v2 Pod (10% + Header)&lt;/b&gt;&lt;br&gt;Canary Release • image: products-service:1.0.0&lt;br&gt;Labels: app=products-service, version=v2&lt;br&gt;Safe validation before full promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="980" y="430" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_vs_dr" parent="1" value="Routes to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="n_vs" target="n_dr">
