          <mxGeometry x="710" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_gw" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="905" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_ord" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1095" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_prod_inv" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1285" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_obs" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1490" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" value="1. User initiates OAuth2 Login / PKCE flow from React 19 SPA (CartAggregate &amp; Checkout FSM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="190" width="420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" value="2. Ingress Controller (Istio) routes auth requests directly to Keycloak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="325" y="235" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" value="3. Keycloak validates credentials, issues signed JWT Access Token (JWKS, roles, 'sub')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="280" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st4" parent="1" value="4. GraphQL POST / (Authorization: Bearer &amp;lt;JWT&amp;gt;, X-Idempotency-Key, traceparent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="325" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st5" parent="1" value="5. Ingress Controller applies L7 security: rate-limiting (100 req/s), security headers &amp; WAF sanitization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="325" y="370" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st6" parent="1" value="6. Istio Envoy Sidecar intercepts egress, applies VirtualService &amp; encrypts with STRICT mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="710" y="415" width="195" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st7" parent="1" value="7. Cosmo Router builds the federated query plan and forwards Authorization; protected Spring services validate JWTs with Keycloak JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="520" y="460" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st8" parent="1" value="8. Cosmo Router dispatches concurrent subgraph queries to orders-service:8003 over mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="905" y="505" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st9" parent="1" value="9. Orders Service verifies inventory with Inventory Service and creates saga transaction in PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1095" y="550" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st10" parent="1" value="10. Orders Service publishes order-created event to Kafka KRaft (Port 9092 / PLAINTEXT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1095" y="595" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st11" parent="1" value="11. Orders Service returns Order entity ➔ Cosmo Router merges subgraphs ➔ Ingress ➔ React 19 SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="640" width="960" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st12" parent="1" value="12. Kiali Dashboard captures mesh topology: [Ingress] ➔ [cosmo-router] ➔ [orders-service] with green 🔒 mTLS lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1">
          <mxGeometry x="710" y="690" width="780" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st13" parent="1" value="13. Full Telemetry Collection: Prometheus scrapes RPS/latencies, Tempo correlates OTel spans, Loki indexes logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1">
          <mxGeometry x="905" y="740" width="585" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_ecommerce_obs" name="8. Mature E-Commerce Observability Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t8" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MATURE E-COMMERCE OBSERVABILITY &amp; BUSINESS INTELLIGENCE (5 DIMENSIONS)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;High-cardinality prevention (O(1) discrete cohorts), observed funnel event activity, order fulfillment, and distributed saga resilience&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" value="&lt;b&gt;1. Financial &amp; Executive KPIs&lt;/b&gt;&lt;br&gt;• All-time delivered merchandise value&lt;br&gt;• All-time delivered order count&lt;br&gt;• Merchandise value per delivered order&lt;br&gt;• All-time cancelled order count&lt;br&gt;• Tax and shipping excluded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" value="&lt;b&gt;2. Observed Funnel Event Activity&lt;/b&gt;&lt;br&gt;• Prometheus event counter activity&lt;br&gt;• Cart Add / Checkout Start / Checkout Step&lt;br&gt;• Events are not session-correlated&lt;br&gt;• No conversion or abandonment rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="460" y="120" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" value="&lt;b&gt;3. Inventory Intelligence&lt;/b&gt;&lt;br&gt;• Live Available Stock by SKU&lt;br&gt;• SKU Sales Market Share&lt;br&gt;• Stockout Incidents (&lt;code&gt;inventory_out_of_stock_events_total&lt;/code&gt;)&lt;br&gt;• Low Stock Warnings (&amp;lt;5 units)&lt;br&gt;• Warehouse Restock Operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="840" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" value="&lt;b&gt;4. Order Fulfillment Status&lt;/b&gt;&lt;br&gt;• &lt;code&gt;PLACED&lt;/code&gt;: Order created&lt;br&gt;• &lt;code&gt;SHIPPED&lt;/code&gt;: Dispatched for delivery&lt;br&gt;• &lt;code&gt;DELIVERED&lt;/code&gt;: Delivered order&lt;br&gt;• Counts come from Orders Service database snapshots&lt;br&gt;• Cancelled orders are excluded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1200" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" value="&lt;b&gt;5. Distributed Consistency &amp; Resilience&lt;/b&gt;&lt;br&gt;• Duplicate Orders Prevented (Idempotency Hits)&lt;br&gt;• Saga Distributed Rollbacks &amp; Compensations&lt;br&gt;• Notification Kafka Processing Throughput &amp; Lag&lt;br&gt;• Resilience4j Circuit Breaker Health Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="320" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ret_box" parent="1" value="&lt;b&gt;CUSTOMER RETENTION &amp; BASKET DYNAMICS (O(1) Bounded Cardinality Architecture)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Problem:&lt;/b&gt; Tagging metrics with unbounded &lt;code&gt;username&lt;/code&gt; causes cardinality explosion (millions of time series in Prometheus TSDB).&lt;br&gt;• &lt;b&gt;Solution:&lt;/b&gt; Aggregation into discrete business cohorts: &lt;code&gt;first_time&lt;/code&gt;, &lt;code&gt;repeat&lt;/code&gt;, and &lt;code&gt;loyal_vip&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Basket Economics:&lt;/b&gt; Order volume segmentation by basket size: &lt;code&gt;single_item&lt;/code&gt;, &lt;code&gt;2_3_items&lt;/code&gt;, &lt;code&gt;bulk_4_plus&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="460" y="320" width="1060" height="160" as="geometry" />
        </mxCell>
        <mxCell id="dash_biz" parent="1" value="&lt;b&gt;📊 Grafana Dashboard: Curated Business Operations (16 Panels)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dynamic Filter:&lt;/b&gt; &lt;code&gt;Filter Microservice&lt;/code&gt; dropdown (All / Orders / Inventory / Products)&lt;br&gt;• &lt;b&gt;1. Executive Summary:&lt;/b&gt; All-time delivered merchandise value, delivered orders, value per order &amp; cancellations (DB snapshots)&lt;br&gt;• &lt;b&gt;2. Funnel &amp; Logistics:&lt;/b&gt; Observed event activity &amp; current lifecycle-stage counts&lt;br&gt;• &lt;b&gt;3. Inventory &amp; Demand:&lt;/b&gt; Live stock, low/out-of-stock SKU counts &amp; all-time delivered SKU sales&lt;br&gt;• &lt;b&gt;4. Customer Retention:&lt;/b&gt; Discrete delivered-order loyalty cohorts &amp; sampled 5-minute snapshot changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="100" y="520" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="dash_tech" parent="1" value="&lt;b&gt;🛡️ Grafana Dashboard: Curated Technical &amp; SRE Operations (13 Panels)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dynamic Filter:&lt;/b&gt; &lt;code&gt;Filter Microservice&lt;/code&gt; drilldown (All / Gateway / Orders / Inventory / Products / Notif)&lt;br&gt;• &lt;b&gt;1. Global Health:&lt;/b&gt; Core Services Available (of 5), no-data visibility, Spring P95, threat level, circuit breakers&lt;br&gt;• &lt;b&gt;2. HTTP Golden Signals:&lt;/b&gt; Request Rate, per-service P95, and HTTP 5xx error rate&lt;br&gt;• &lt;b&gt;3. Distributed Resilience:&lt;/b&gt; Idempotency Hits, Saga Rollbacks &amp; Kafka Streaming Rate&lt;br&gt;• &lt;b&gt;4. Platform Saturation:&lt;/b&gt; JVM Heap Memory, CPU &amp; HikariCP Database Connection Pools (Active vs Total Pool Size)&lt;br&gt;• &lt;b&gt;5. Security &amp; Diagnostics:&lt;/b&gt; Blocked Attacks (HTTP 429) &amp; Incident Logs Stream (Loki)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="840" y="520" width="680" height="200" as="geometry" />
        </mxCell>
        <mxCell id="dash_infra" parent="1" value="&lt;b&gt;⚙️ Prometheus Infrastructure Targets: Full-Stack Coverage (All Targets UP)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;redis-exporter:&lt;/b&gt; Cache hit ratio, keyspace stats, memory limit, rate limiter load (Port 9121)&lt;br&gt;• &lt;b&gt;kafka-exporter v1.9.0:&lt;/b&gt; Consumer lag, topic partition throughput, broker count (Port 9308)&lt;br&gt;• &lt;b&gt;postgres-exporter v0.20.1:&lt;/b&gt; Active connections, commit rate, lock deadlocks (Port 9187)&lt;br&gt;• &lt;b&gt;keycloak:&lt;/b&gt; OIDC authentication success/fail, token issuance latency, JVM heap (Port 9000)&lt;br&gt;• &lt;b&gt;vault &amp; istiod:&lt;/b&gt; KMS seal status, API rates, Envoy mesh telemetry &amp; mTLS golden signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="100" y="740" width="1420" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_devsecops_pipeline" name="9. Local DevSecOps Platform &amp; GitHub Actions Delivery">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t9" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;LOCAL DEVSECOPS PLATFORM &amp; GITHUB ACTIONS DELIVERY FLOW&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;GitHub Actions 12-stage DevSecOps workflow • Azure DevOps &amp; Bitbucket 14-stage cloud pipelines • Minikube local platform&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_ci" parent="1" value="&lt;b&gt;🔨 CI PHASE: Continuous Integration &amp; Shift-Left Security (GitHub Actions Windows Runner)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="750" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" value="&lt;b&gt;1. Unit Tests&lt;/b&gt;&lt;br&gt;Maven / React 19&lt;br&gt;JaCoCo Coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=10;" vertex="1">
          <mxGeometry x="80" y="130" width="125" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" value="&lt;b&gt;2. SAST &amp; Secrets&lt;/b&gt;&lt;br&gt;Gitleaks / Semgrep&lt;br&gt;Checkov / optional Sonar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=10;" vertex="1">
          <mxGeometry x="225" y="130" width="125" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" value="&lt;b&gt;3. Image &amp; SBOM&lt;/b&gt;&lt;br&gt;BuildKit image&lt;br&gt;Trivy CycloneDX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=10;" vertex="1">
          <mxGeometry x="370" y="130" width="125" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" value="&lt;b&gt;4. Trivy Scan&lt;/b&gt;&lt;br&gt;Image audit&lt;br&gt;Soft gate today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;" vertex="1">
          <mxGeometry x="515" y="130" width="125" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" value="&lt;b&gt;5. Conftest (OPA)&lt;/b&gt;&lt;br&gt;Helm render&lt;br&gt;Rego policy gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;" vertex="1">
          <mxGeometry x="660" y="130" width="135" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pe1" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_cd" parent="1" value="&lt;b&gt;🚀 REGISTRY, GITOPS &amp; RUNTIME VALIDATION (12-Stage GitHub Actions Flow)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="830" y="90" width="1010" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" value="&lt;b&gt;6. Publish image&lt;/b&gt;&lt;br&gt;Commit tag + SBOM&lt;br&gt;Docker Hub when configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=10;" vertex="1">
          <mxGeometry x="850" y="130" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" value="&lt;b&gt;7. ArgoCD / Helm delivery&lt;/b&gt;&lt;br&gt;Sync and health wait when connected&lt;br&gt;Failure recovery is provider-specific" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#4C1D95;fontSize=10;" vertex="1">
          <mxGeometry x="1160" y="130" width="500" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pe5" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe6" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_plat" parent="1" value="&lt;b&gt;☸️ MINIKUBE PLATFORM TOPOLOGY (8 CPUs • 16 GiB RAM • containerd • Ingress Controller)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="60" y="310" width="1780" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p_loki" parent="1" value="&lt;b&gt;📑 Loki (Logs Datasource)&lt;/b&gt;&lt;br&gt;observability namespace&lt;br&gt;Alloy ships pod/container logs here&lt;br&gt;Queried in Grafana with LogQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="90" y="360" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_argo" parent="1" value="&lt;b&gt;🐙 ArgoCD GitOps&lt;/b&gt;&lt;br&gt;Port 8088 (Web UI)&lt;br&gt;GitOps Controller (admin/admin)&lt;br&gt;Automated Sync Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="360" y="360" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_vault" parent="1" value="&lt;b&gt;🔒 HashiCorp Vault&lt;/b&gt;&lt;br&gt;Port 8200 (Token: root)&lt;br&gt;Secrets Management&lt;br&gt;K8s ServiceAccount Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="630" y="360" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_gatekeeper" parent="1" value="&lt;b&gt;🛡️ OPA Gatekeeper &amp; Conftest&lt;/b&gt;&lt;br&gt;Admission Controller &amp; Rego Gates&lt;br&gt;Trusted Registry (georgegxx/*)&lt;br&gt;Immutable :1.0.0 (No :latest)&lt;br&gt;Least-Privilege RBAC (No default SA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=10;" vertex="1">
          <mxGeometry x="900" y="360" width="240" height="90" as="geometry" />
