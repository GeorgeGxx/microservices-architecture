        <mxCell id="app_gw" parent="1" value="&lt;b&gt;🚀 Apollo Router v2&lt;/b&gt;&lt;br&gt;Port 8080 (/graphql)&lt;br&gt;Sandbox: http://localhost:8080&lt;br&gt;Apollo Federation 2.3 Supergraph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="360" y="480" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_kc" parent="1" value="&lt;b&gt;🔑 Keycloak 26 IAM&lt;/b&gt;&lt;br&gt;Port 8181 (admin/admin)&lt;br&gt;Realm: microservices-realm&lt;br&gt;OIDC &amp; User Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="630" y="480" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_istio" parent="1" value="&lt;b&gt;🚪 Istio Unified Edge&lt;/b&gt;&lt;br&gt;Kubernetes-assigned NodePort (Ingress Gateway)&lt;br&gt;Routes: /, /api/*, /admin/*&lt;br&gt;Zero-Trust Service Mesh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="900" y="480" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_kiali" parent="1" value="&lt;b&gt;🧭 Kiali Visual Mesh&lt;/b&gt;&lt;br&gt;Port 20001 (/kiali)&lt;br&gt;Real-time Traffic Graph&lt;br&gt;mTLS Encryption Health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="1170" y="480" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_dbs" parent="1" value="&lt;b&gt;💾 Persistence &amp; Streams&lt;/b&gt;&lt;br&gt;PostgreSQL (Products, Orders, Inv, KC)&lt;br&gt;Apache Kafka 7.8 (Port 9094 SASL PLAIN)&lt;br&gt;Redis Cache Cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=11;" vertex="1">
          <mxGeometry x="1440" y="480" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ops_box" parent="1" value="&lt;b&gt;⚙️ UNIFIED PLATFORM CLI &amp; OPERATIONAL LIFECYCLE&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Unified Orchestrator:&lt;/b&gt; &lt;code&gt;.\platform.ps1 up&lt;/code&gt; (Minikube, Istio, ArgoCD, Prometheus, Vault, Keycloak, Apps &amp; Tunnels).&lt;br&gt;• &lt;b&gt;Health Doctor:&lt;/b&gt; &lt;code&gt;.\platform.ps1 doctor&lt;/code&gt; (Deep diagnostics of pods, NodePorts, and active Gatekeeper OPA policies).&lt;br&gt;• &lt;b&gt;Live Workload Costs:&lt;/b&gt; &lt;code&gt;.\platform.ps1 cost&lt;/code&gt; (OpenCost allocation for the current Kubernetes context); &lt;code&gt;.\platform.ps1 finops&lt;/code&gt; provides offline illustrative estimates.&lt;br&gt;• &lt;b&gt;Endpoints Table:&lt;/b&gt; &lt;code&gt;.\platform.ps1 urls&lt;/code&gt; (Formatted table of active services and credentials).&lt;br&gt;• &lt;b&gt;Teardown &amp; Purge:&lt;/b&gt; &lt;code&gt;.\platform.ps1 down [-DeleteCluster]&lt;/code&gt; (Releases 6 CPUs &amp; 12 GB RAM, or cleans 40 GB disk)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="590" width="1780" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_resiliency_canary_ops" name="10. Resiliency, Secrets, Canary &amp; Alerts">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t10" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;PRODUCTION-GRADE RESILIENCY, SECRETS, CANARY &amp; ALERTING ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;KEDA v2.20.1 Event-driven Autoscaling • Horizontal Pod Autoscaler (HPA) • PodDisruptionBudgets (PDB) • External Secrets Operator + Vault • Istio Canary Mesh • Alertmanager Routing&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_hpa" parent="1" value="&lt;b&gt;⚖️ AUTOSCALING &amp; HIGH AVAILABILITY (KEDA v2.20.1 + HPA &amp; PDB)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="n_hpa" parent="1" value="&lt;b&gt;KEDA v2.20.1 Event Autoscaler + HPA&lt;/b&gt;&lt;br&gt;• Kafka Consumer Lag: notification-service (lag &amp;gt; 10)&lt;br&gt;• Prometheus RPS: apollo-router (req/s &amp;gt; 100)&lt;br&gt;• CPU Target: 70% • Memory Target: 80%&lt;br&gt;• ScaledObjects unify event + resource triggers&lt;br&gt;• Auto-generates unified HPA with zero flapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="140" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_pdb" parent="1" value="&lt;b&gt;PodDisruptionBudgets (PDB)&lt;/b&gt;&lt;br&gt;• minAvailable: 1 across all 5 services&lt;br&gt;• Guarantees application quorum&lt;br&gt;• Zero downtime during node drains &amp; updates&lt;br&gt;• Dynamic allowedDisruptions calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="245" width="380" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n_pods" parent="1" value="&lt;b&gt;Protected Microservice Deployments&lt;/b&gt;&lt;br&gt;• apollo-router (Port 8080)&lt;br&gt;• inventory-service (Port 8001)&lt;br&gt;• notification-service (Port 8002)&lt;br&gt;• orders-service (Port 8003)&lt;br&gt;• products-service (Port 8004)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="335" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_mem_opt" parent="1" value="&lt;b&gt;💡 Event-Driven Scaling Guarantee&lt;/b&gt;&lt;br&gt;KEDA controls HPA via ScaledObjects.&lt;br&gt;No duplicate HPAs, no replica race conditions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;" vertex="1">
          <mxGeometry x="80" y="450" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_hpa_pod" parent="1" value="Scale Controller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="n_hpa" target="n_pods">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pdb_pod" parent="1" value="Quorum Guard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;" edge="1" source="n_pdb" target="n_pods">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_eso" parent="1" value="&lt;b&gt;🔐 SECRETS MANAGEMENT (ESO + VAULT)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="510" y="90" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="n_vault_dev" parent="1" value="&lt;b&gt;HashiCorp Vault (Port 8200)&lt;/b&gt;&lt;br&gt;• KV-v2 Secrets Engine at 'secret/'&lt;br&gt;• secret/data/application (DB &amp; JWT)&lt;br&gt;• secret/data/apollo-router (Config &amp; JWKS)&lt;br&gt;• secret/data/orders-service (Kafka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="530" y="140" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_store" parent="1" value="&lt;b&gt;SecretStore: vault-secret-store&lt;/b&gt;&lt;br&gt;• API: external-secrets.io/v1&lt;br&gt;• Auth: Kubernetes Token SecretRef&lt;br&gt;• Target Server: http://vault.vault.svc:8200&lt;br&gt;• Status: Valid (ReadWrite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="530" y="240" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_es" parent="1" value="&lt;b&gt;ExternalSecret: microservices-external-secret&lt;/b&gt;&lt;br&gt;• Refresh Interval: 1h (Auto-reconciliation)&lt;br&gt;• creationPolicy: Merge • deletionPolicy: Retain&lt;br&gt;• Status: SecretSynced (Ready: True)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
          <mxGeometry x="530" y="340" width="380" height="80" as="geometry" />
