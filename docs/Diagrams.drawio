          <mxGeometry x="60" y="560" width="580" height="200" as="geometry" />
        </mxCell>
        <mxCell id="k_keda_op" parent="1" value="&lt;b&gt;Deployment: keda-operator (v2.20.1)&lt;/b&gt;&lt;br&gt;CRD Controller: ScaledObject &amp; TriggerAuthentication&lt;br&gt;Event-Driven Scaler (Kafka Lag, Prometheus RPS, Redis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
