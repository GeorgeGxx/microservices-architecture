        <mxCell id="k_sa_vault" parent="1" value="&lt;b&gt;ServiceAccount: vault-auth&lt;/b&gt;&lt;br&gt;ClusterRoleBinding: system:auth-delegator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontSize=10;" vertex="1">
          <mxGeometry x="80" y="250" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k_script_auth" parent="1" value="&lt;b&gt;platform-minikube.ps1 vault&lt;/b&gt;&lt;br&gt;k8s-auth: scoped service policies&lt;br&gt;istio-pki: guarded CA setup/rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontSize=10;" vertex="1">
          <mxGeometry x="80" y="340" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ns_auth" parent="1" value="&lt;b&gt;🛡️ NAMESPACE: auth&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="360" y="110" width="300" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k_kc_pod" parent="1" value="&lt;b&gt;Deployment: keycloak&lt;/b&gt;&lt;br&gt;Keycloak 26.8.1 (IdP)&lt;br&gt;Port 8181 (HTTP) &amp; 9000 (Metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="380" y="160" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k_db_kc" parent="1" value="&lt;b&gt;StatefulSet: db-keycloak&lt;/b&gt;&lt;br&gt;PostgreSQL 18 (Port 5432)&lt;br&gt;Dedicated IAM database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=10;" vertex="1">
          <mxGeometry x="380" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ns_data" parent="1" value="&lt;b&gt;💾 NAMESPACE: data (Stateful &amp; Exporters)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="680" y="110" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k_data_pods" parent="1" value="&lt;b&gt;StatefulSets (PostgreSQL 18 x6 + Kafka + Redis):&lt;/b&gt;&lt;br&gt;• Kafka KRaft (9092: orders, payments, fulfillment)&lt;br&gt;• Redis 8.8 (6379)&lt;br&gt;• Postgres 18 (orders, inventory, products,&lt;br&gt;  payments, fulfillment, analytics: 5432)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=10.5;" vertex="1">
          <mxGeometry x="700" y="160" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="k_data_exp" parent="1" value="&lt;b&gt;Infrastructure Exporters:&lt;/b&gt;&lt;br&gt;• kafka-exporter v1.9.0 (Port 9308)&lt;br&gt;• postgres-exporter v0.20.1 (Port 9187)&lt;br&gt;• redis-exporter (Port 9121)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;" vertex="1">
          <mxGeometry x="700" y="270" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ns_staging" parent="1" value="&lt;b&gt;📦 NAMESPACE: dev (Helm Umbrella Workloads &amp; RBAC)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="1080" y="110" width="400" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k_apps_pods" parent="1" value="&lt;b&gt;Deployments &amp; MLOps (Helm Single Source of Truth):&lt;/b&gt;&lt;br&gt;• cosmo-router (8080) • frontend SPA (80)&lt;br&gt;• products-service (8004) • orders-service (8003)&lt;br&gt;• inventory-service (8001) • notification-service (8002)&lt;br&gt;• payments-service (8085) • fulfillment-service (8086)&lt;br&gt;• analytics-service (8087)&lt;br&gt;• demand-sales-capture • demand-forecast-service (8005)&lt;br&gt;• mlflow tracking (5000) • demand-model-training (CronJob)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=9.5;" vertex="1">
          <mxGeometry x="1100" y="155" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="k_rbac_dev" parent="1" value="&lt;b&gt;🛡️ K8s RBAC Least-Privilege Hardening:&lt;/b&gt;&lt;br&gt;• Dedicated SAs: *-sa (automountToken: false)&lt;br&gt;• Empty Workload Role: 0 API privileges&lt;br&gt;• Scoped Roles: dev-developer, dev-cicd-deployer&lt;br&gt;• OPA Conftest: Deny default ServiceAccount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=9.5;" vertex="1">
          <mxGeometry x="1100" y="285" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="k_eso_objs" parent="1" value="&lt;b&gt;ExternalName Cross-Namespace Bridges:&lt;/b&gt;&lt;br&gt;• keycloak -&gt; keycloak.auth&lt;br&gt;• kafka / redis / db-* -&gt; data.svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=10;" vertex="1">
          <mxGeometry x="1100" y="355" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ns_obs" parent="1" value="&lt;b&gt;📊 NAMESPACE: observability (LGTM Telemetry)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="1500" y="110" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="k_obs_pods" parent="1" value="&lt;b&gt;Observability &amp; FinOps Stack:&lt;/b&gt;&lt;br&gt;• Prometheus v3.14.0 (9090; 15s scrape; 5Gi PVC; 7d/4GB cap)&lt;br&gt;• OpenCost namespace (API 9003, UI 9090; host tunnel 7000)&lt;br&gt;• Grafana 13.2.3 (NodePort 30030; tunnel 3000)&lt;br&gt;• Tempo 3.0.5 (HTTP NodePort 30200; 2Gi PVC; 7d retention)&lt;br&gt;• Loki 3.7.8 (3100; 2Gi PVC; 30d retention)&lt;br&gt;• Alloy v1.21.0 (DaemonSet NodePort 30330; per-node positions storage; multiline &amp; JSON → Loki)&lt;br&gt;• OTel Collector (4317/4318; traces to Tempo)&lt;br&gt;• Grafana datasources: Prometheus, Loki, Tempo; stack-down alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=10;" vertex="1">
          <mxGeometry x="1520" y="160" width="320" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ns_keda" parent="1" value="&lt;b&gt;⚖️ NAMESPACE: keda (Event-Driven Autoscaling)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="60" y="560" width="580" height="200" as="geometry" />
        </mxCell>
        <mxCell id="k_keda_op" parent="1" value="&lt;b&gt;Deployment: keda-operator (v2.21.0)&lt;/b&gt;&lt;br&gt;CRD Controller: ScaledObject &amp; TriggerAuthentication&lt;br&gt;Event-Driven Scaler (Kafka Lag, Prometheus RPS, Redis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="610" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="k_keda_ms" parent="1" value="&lt;b&gt;Deployment: keda-metrics-apiserver (v2.21.0)&lt;/b&gt;&lt;br&gt;External Metrics API Provider for Kubernetes HPA (autoscaling/v2)&lt;br&gt;Translates external telemetry to native HPA metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="685" width="540" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_e2e_sequence" name="7. End-to-End Request Flow &amp; Order Processing Sequence">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t7" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;END-TO-END REQUEST FLOW &amp; ORDER PROCESSING SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Complete journey: React 19 SPA ➔ Istio Ingress ➔ Cosmo Router v2 ➔ Federated Subgraphs ➔ Kafka ➔ Observability&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_fe" parent="1" value="&lt;b&gt;1. Client / SPA&lt;br&gt;(React 19 + Tailwind)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="60" y="110" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_igw" parent="1" value="&lt;b&gt;2. Ingress Controller&lt;br&gt;(Istio)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="240" y="110" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_kc" parent="1" value="&lt;b&gt;3. Keycloak IAM&lt;br&gt;(OIDC / PKCE / JWKS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="440" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_mesh" parent="1" value="&lt;b&gt;4. Istio Envoy Mesh&lt;br&gt;(mTLS STRICT SPIFFE)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="630" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_gw" parent="1" value="&lt;b&gt;5. Cosmo Router v2&lt;br&gt;(Query Planner / Fed 2.3)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="820" y="110" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_ord" parent="1" value="&lt;b&gt;6. Orders Service&lt;br&gt;(Spring Boot 4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1020" y="110" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_prod_inv" parent="1" value="&lt;b&gt;7. Products / Inventory&lt;br&gt;&amp; Kafka KRaft&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="1200" y="110" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_obs" parent="1" value="&lt;b&gt;8. Kiali Dashboard &amp;&lt;br&gt;LGTM Observability&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=11;" vertex="1">
          <mxGeometry x="1400" y="110" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l_fe" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="135" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_igw" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="325" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_kc" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="520" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_mesh" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="710" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_gw" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="905" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_ord" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1095" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_prod_inv" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1285" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_obs" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1490" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" value="1. User initiates OAuth2 Login / PKCE flow from React 19 SPA (CartAggregate &amp; Checkout FSM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="190" width="420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" value="2. Ingress Controller (Istio) routes auth requests directly to Keycloak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="325" y="235" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" value="3. Keycloak validates credentials, issues signed JWT Access Token (JWKS, roles, 'sub')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="280" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st4" parent="1" value="4. GraphQL POST / (Authorization: Bearer &amp;lt;JWT&amp;gt;, X-Idempotency-Key, traceparent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="325" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st5" parent="1" value="5. Ingress Controller applies L7 security: rate-limiting (100 req/s), security headers &amp; WAF sanitization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="325" y="370" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st6" parent="1" value="6. Istio Envoy Sidecar intercepts egress, applies VirtualService &amp; encrypts with STRICT mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="710" y="415" width="195" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st7" parent="1" value="7. Cosmo Router builds the federated query plan and forwards Authorization; protected Spring services validate JWTs with Keycloak JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="520" y="460" width="385" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st8" parent="1" value="8. Cosmo Router dispatches concurrent subgraph queries to orders-service:8003 over mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="905" y="505" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st9" parent="1" value="9. Orders Service verifies &amp;amp; decrements inventory via S2S OAuth2 (ROLE_INTERNAL_SERVICE) and creates saga transaction in PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1095" y="550" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st10" parent="1" value="10. Orders Service publishes order-created event to Kafka KRaft (Port 9092 / PLAINTEXT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1095" y="595" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st11" parent="1" value="11. Orders Service returns Order entity ➔ Cosmo Router merges subgraphs ➔ Ingress ➔ React 19 SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="135" y="640" width="960" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st12" parent="1" value="12. Kiali Dashboard captures mesh topology: [Ingress] ➔ [cosmo-router] ➔ [orders-service] with green 🔒 mTLS lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1">
          <mxGeometry x="710" y="690" width="780" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st13" parent="1" value="13. Full Telemetry Collection: Prometheus scrapes RPS/latencies, Tempo correlates OTel spans, Loki indexes logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1">
          <mxGeometry x="905" y="740" width="585" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_ecommerce_obs" name="8. Mature E-Commerce Observability Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t8" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MATURE E-COMMERCE OBSERVABILITY &amp; BUSINESS INTELLIGENCE (5 DIMENSIONS)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;High-cardinality prevention (O(1) discrete cohorts), observed funnel event activity, order fulfillment, and distributed saga resilience&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" value="&lt;b&gt;1. Financial &amp; Executive Triad&lt;/b&gt;&lt;br&gt;• Gross Orders Placed (7)&lt;br&gt;• Cancelled Orders &amp;amp; Loss (4)&lt;br&gt;• True Net Completed Orders (3)&lt;br&gt;• Order Cancellation Rate (% OCR)&lt;br&gt;• Reconciled AOV ($/Net Order)&lt;br&gt;• Live Cart Abandonment Rate (75%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" value="&lt;b&gt;2. Observed Funnel Event Activity&lt;/b&gt;&lt;br&gt;• Prometheus event counter activity&lt;br&gt;• Cart Add / Checkout Start / Checkout Step&lt;br&gt;• Events are not session-correlated&lt;br&gt;• No conversion or abandonment rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="460" y="120" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" value="&lt;b&gt;3. Inventory Intelligence&lt;/b&gt;&lt;br&gt;• Live Available Stock by SKU&lt;br&gt;• SKU Sales Market Share&lt;br&gt;• Stockout Incidents (&lt;code&gt;inventory_out_of_stock_events_total&lt;/code&gt;)&lt;br&gt;• Low Stock Warnings (&amp;lt;5 units)&lt;br&gt;• Warehouse Restock Operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="840" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" value="&lt;b&gt;4. Order Fulfillment Status&lt;/b&gt;&lt;br&gt;• &lt;code&gt;PLACED&lt;/code&gt;: Order created&lt;br&gt;• &lt;code&gt;SHIPPED&lt;/code&gt;: Dispatched for delivery&lt;br&gt;• &lt;code&gt;DELIVERED&lt;/code&gt;: Delivered order&lt;br&gt;• Counts come from Orders Service database snapshots&lt;br&gt;• Cancelled orders are excluded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1200" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" value="&lt;b&gt;5. Distributed Consistency &amp; Resilience&lt;/b&gt;&lt;br&gt;• Duplicate Orders Prevented (Idempotency Hits)&lt;br&gt;• Saga Distributed Rollbacks &amp; Compensations&lt;br&gt;• Notification Kafka Processing Throughput &amp; Lag&lt;br&gt;• Resilience4j Circuit Breaker Health Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="320" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ret_box" parent="1" value="&lt;b&gt;CUSTOMER RETENTION &amp; BASKET DYNAMICS (O(1) Bounded Cardinality Architecture)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Problem:&lt;/b&gt; Tagging metrics with unbounded &lt;code&gt;username&lt;/code&gt; causes cardinality explosion (millions of time series in Prometheus TSDB).&lt;br&gt;• &lt;b&gt;Solution:&lt;/b&gt; Aggregation into discrete business cohorts: &lt;code&gt;first_time&lt;/code&gt;, &lt;code&gt;repeat&lt;/code&gt;, and &lt;code&gt;loyal_vip&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Basket Economics:&lt;/b&gt; Order volume segmentation by basket size: &lt;code&gt;single_item&lt;/code&gt;, &lt;code&gt;2_3_items&lt;/code&gt;, &lt;code&gt;bulk_4_plus&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="460" y="320" width="1060" height="160" as="geometry" />
        </mxCell>
        <mxCell id="dash_biz" parent="1" value="&lt;b&gt;📊 Dashboard: Business Operations (Reconciled Triad)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dynamic Filter:&lt;/b&gt; &lt;code&gt;Filter Microservice&lt;/code&gt;&lt;br&gt;• &lt;b&gt;1. Executive Triad:&lt;/b&gt; Gross (7) vs Cancelled (4) ➔ Net Orders (3)&lt;br&gt;• &lt;b&gt;2. AOV &amp;amp; Cart Health:&lt;/b&gt; Reconciled AOV &amp;amp; Live Abandonment&lt;br&gt;• &lt;b&gt;3. Audit &amp;amp; Funnel:&lt;/b&gt; Net Fulfilled vs Cancelled (% OCR) &amp;amp; Stages&lt;br&gt;• &lt;b&gt;4. SKU Intelligence &amp;amp; Retention:&lt;/b&gt; Available stock &amp;amp; loyalty cohorts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="80" y="510" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dash_tech" parent="1" value="&lt;b&gt;🛡️ Dashboard: Technical &amp;amp; SRE (Level 5 Resilience)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dynamic Filter:&lt;/b&gt; &lt;code&gt;Filter Microservice&lt;/code&gt;&lt;br&gt;• &lt;b&gt;1. Global Health:&lt;/b&gt; 8 Microservices UP, P95, Breakers, SLO Burn&lt;br&gt;• &lt;b&gt;2. HTTP Golden Signals:&lt;/b&gt; Request rate (RPS), per-service P95&lt;br&gt;• &lt;b&gt;3. Level 5 SRE Row:&lt;/b&gt; Vegas Adaptive Limits vs In-Flight, DLQ&lt;br&gt;Quarantine &amp;amp; Traffic Shedding, Cell Traffic &amp;amp; Outbox Dispatches&lt;br&gt;• &lt;b&gt;4. Consistency:&lt;/b&gt; Redis Idempotency hits &amp;amp; Saga Rollbacks&lt;br&gt;• &lt;b&gt;5. Telemetry Pipeline:&lt;/b&gt; Grafana Alloy Controller, Loki Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="510" y="510" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dash_mlops" parent="1" value="&lt;b&gt;🧪 Dashboard: MLOps Operations (Port 8005)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Demand Forecast API:&lt;/b&gt; FastAPI &amp; PySpark pipelines&lt;br&gt;• &lt;b&gt;1. Availability &amp; Health:&lt;/b&gt; Forecast API UP, hours since run&lt;br&gt;• &lt;b&gt;2. HTTP Performance:&lt;/b&gt; Request Rate (qps), P95 &amp; error rate&lt;br&gt;• &lt;b&gt;3. Model Governance:&lt;/b&gt; Active Model RMSE, MAE &amp; age&lt;br&gt;• &lt;b&gt;4. Data Freshness:&lt;/b&gt; Parquet snapshot &amp; sales freshness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="940" y="510" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dash_alloy" parent="1" value="&lt;b&gt;⚡ Grafana Alloy Live Web UI (Port 3300)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Native Component Graph:&lt;/b&gt; Visual DAG of pipeline stages&lt;br&gt;• &lt;b&gt;Live Component Inspect:&lt;/b&gt; &lt;code&gt;discovery.docker&lt;/code&gt;, &lt;code&gt;loki.source.docker&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Stage Verification:&lt;/b&gt; &lt;code&gt;loki.process.docker_logs&lt;/code&gt; multiline &amp; JSON&lt;br&gt;• &lt;b&gt;Forwarding Sink:&lt;/b&gt; &lt;code&gt;loki.write.endpoint&lt;/code&gt; push states&lt;br&gt;• &lt;b&gt;Direct NodePort Access:&lt;/b&gt; &lt;code&gt;http://localhost:3300&lt;/code&gt; or &lt;code&gt;:30330&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=10.5;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="1370" y="510" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dash_infra" parent="1" value="&lt;b&gt;⚙️ Prometheus Infrastructure Targets: Full-Stack Coverage (All Targets UP)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;redis-exporter:&lt;/b&gt; Cache hit ratio, keyspace stats, memory limit, rate limiter load (Port 9121)&lt;br&gt;• &lt;b&gt;kafka-exporter v1.9.0:&lt;/b&gt; Consumer lag, topic partition throughput, broker count (Port 9308)&lt;br&gt;• &lt;b&gt;postgres-exporter v0.20.1:&lt;/b&gt; Active connections, commit rate, lock deadlocks (Port 9187)&lt;br&gt;• &lt;b&gt;alloy:&lt;/b&gt; Component controller, build info, memory/CPU, log push metrics (Port 3300 / NodePort 30330)&lt;br&gt;• &lt;b&gt;vault &amp; istiod:&lt;/b&gt; KMS seal status, API rates, Envoy mesh telemetry &amp; mTLS golden signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11.5;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="80" y="735" width="1700" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_devsecops_pipeline" name="9. Local DevSecOps Platform &amp; GitHub Actions Delivery">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t9" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;LOCAL DEVSECOPS PLATFORM &amp; GITHUB ACTIONS DELIVERY FLOW&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Automatic PR/push quality gates • digest-based image delivery • Minikube local platform&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
