        <mxCell id="app_dbs" parent="1" value="&lt;b&gt;💾 Persistence &amp; Streams&lt;/b&gt;&lt;br&gt;PostgreSQL (Products, Orders, Inv, KC)&lt;br&gt;Apache Kafka 7.8 (Port 9092 PLAINTEXT)&lt;br&gt;Redis Cache Cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=11;" vertex="1">
          <mxGeometry x="1440" y="480" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ops_box" parent="1" value="&lt;b&gt;⚙️ MINIKUBE PLATFORM CLI &amp; OPERATIONAL LIFECYCLE&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Unified Orchestrator:&lt;/b&gt; &lt;code&gt;.\platform-minikube.ps1 up&lt;/code&gt; (Minikube, Istio, ArgoCD, Prometheus, Vault, Keycloak, Apps &amp; Tunnels).&lt;br&gt;• &lt;b&gt;Health Doctor:&lt;/b&gt; &lt;code&gt;.\platform-minikube.ps1 doctor&lt;/code&gt; (Deep diagnostics of pods, NodePorts, and active Gatekeeper OPA policies).&lt;br&gt;• &lt;b&gt;Live Workload Costs:&lt;/b&gt; &lt;code&gt;.\platform-minikube.ps1 cost&lt;/code&gt; (OpenCost allocation for the current Kubernetes context); &lt;code&gt;.\platform-minikube.ps1 finops&lt;/code&gt; provides offline illustrative estimates.&lt;br&gt;• &lt;b&gt;Endpoints Table:&lt;/b&gt; &lt;code&gt;.\platform-minikube.ps1 urls&lt;/code&gt; (Formatted table of active services and credentials).&lt;br&gt;• &lt;b&gt;Teardown &amp; Purge:&lt;/b&gt; &lt;code&gt;.\platform-minikube.ps1 down [-DeleteCluster]&lt;/code&gt; (Releases 8 CPUs &amp; 16 GiB RAM, or cleans 40 GB disk)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="590" width="1780" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_resiliency_canary_ops" name="10. Resiliency, Secrets, Canary &amp; Alerts">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t10" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;PRODUCTION-GRADE RESILIENCY, SECRETS, CANARY &amp; ALERTING ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;KEDA v2.21.0 Event-driven Autoscaling • Horizontal Pod Autoscaler (HPA) • PodDisruptionBudgets (PDB) • External Secrets Operator + Vault • Istio Canary Mesh • Alertmanager Routing&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_hpa" parent="1" value="&lt;b&gt;⚖️ AUTOSCALING &amp; HIGH AVAILABILITY (KEDA v2.21.0 + HPA &amp; PDB)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="n_hpa" parent="1" value="&lt;b&gt;KEDA v2.21.0 Event Autoscaler + HPA&lt;/b&gt;&lt;br&gt;• Kafka Consumer Lag: notification-service (lag &amp;gt; 10)&lt;br&gt;• Prometheus RPS: cosmo-router (req/s &amp;gt; 100)&lt;br&gt;• CPU Target: 70% • Memory Target: 80%&lt;br&gt;• ScaledObjects unify event + resource triggers&lt;br&gt;• Auto-generates unified HPA with zero flapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="140" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_pdb" parent="1" value="&lt;b&gt;PodDisruptionBudgets (PDB)&lt;/b&gt;&lt;br&gt;• minAvailable: 1 across all 5 services&lt;br&gt;• Guarantees application quorum&lt;br&gt;• Zero downtime during node drains &amp; updates&lt;br&gt;• Dynamic allowedDisruptions calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="245" width="380" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n_pods" parent="1" value="&lt;b&gt;Protected Microservice Deployments&lt;/b&gt;&lt;br&gt;• cosmo-router (Port 8080)&lt;br&gt;• inventory-service (Port 8001)&lt;br&gt;• notification-service (Port 8002)&lt;br&gt;• orders-service (Port 8003)&lt;br&gt;• products-service (Port 8004)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="335" width="380" height="100" as="geometry" />
        </mxCell>
