  <diagram id="page_multicloud_automation" name="11. Multi-Cloud IaC &amp; CLI Automation Suite">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t11" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MULTI-CLOUD INFRASTRUCTURE (AWS • AZURE • GCP) &amp; AUTOMATION SUITE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;12 Kubernetes clusters: 4 per provider (dev, staging, two prod) • 3 workspaces per provider • Unified CLI &amp; FinOps&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_aws" parent="1" value="&lt;b&gt;☁️ AMAZON WEB SERVICES (AWS)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/aws/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="aws_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; shared VPC per environment&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; EKS dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; RDS PostgreSQL 18 (Multi-AZ)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; ElastiCache Redis 7.1 Replication&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Amazon MSK (Apache Kafka 3.6)&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; S3 Assets Bucket (SSE-KMS, Versioning)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; AWS KMS (CMK Key &amp; Alias)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; IAM IRSA (OIDC Trust Provider)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Network Load Balancer (NLB L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; CloudFront + WAFv2 (S3 Static SPA + NLB Dynamic API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; CloudWatch Alarms &amp; Dashboards&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Route53 Zone + Apex Alias to CloudFront + ACM SSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="150" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_azure" parent="1" value="&lt;b&gt;☁️ MICROSOFT AZURE CLOUD&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/azure/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="90" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="azure_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; VNet + dedicated prod AKS subnets&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; AKS dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; Azure PostgreSQL Flexible Server (HA)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; Azure Cache for Redis (TLS 1.2)&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Azure Event Hubs (Kafka Surface)&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; Azure Storage Account (Blob Containers)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Azure Key Vault (Soft-delete, Purge)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; Azure Workload Identity (Federated Creds)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Azure Standard Load Balancer (L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; Front Door Premium (Storage Blob SPA + AKS SLB API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; Azure Monitor (Log Analytics, App Insights)&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Azure DNS Zone + Custom Apex Records to Front Door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="150" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_gcp" parent="1" value="&lt;b&gt;☁️ GOOGLE CLOUD PLATFORM (GCP)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/gcp/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#064E3B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1260" y="90" width="580" height="470" as="geometry" />
        </mxCell>
        <mxCell id="gcp_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; Google Cloud VPC + Cloud NAT; separate secondary ranges for prod dp2&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; GKE Autopilot dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; Cloud SQL PostgreSQL 18 (HA)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; Cloud Memorystore for Redis 7.2&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Managed Kafka / Cloud PubSub &amp; DLQ&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; Google Cloud Storage (CMEK, Uniform Access)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Google Cloud KMS (KeyRing &amp; CryptoKey)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; GCP Workload Identity (GSA to KSA)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Passthrough Network Load Balancer (L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; Cloud Armor + Cloud CDN (GCS Bucket SPA + Istio NLB API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; Cloud Monitoring (Dashboards &amp; Alerts)&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Cloud DNS Managed Zone + Global A-Record to Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="150" width="540" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_cli" parent="1" value="&lt;b&gt;🚀 UNIFIED PLATFORM CLI ARCHITECTURE (platform-*.ps1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="580" width="880" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cli_commands" parent="1" value="• &lt;b&gt;Minikube:&lt;/b&gt; platform-minikube.ps1 up / doctor / mlops / canary / vault (Zero-cloud-cost local stack)&lt;br&gt;• &lt;b&gt;Multi-Cloud Orchestrator:&lt;/b&gt; platform-multicloud.ps1 -Provider &amp;lt;aws|azure|gcp&amp;gt;&lt;br&gt;  - &lt;b&gt;AWS:&lt;/b&gt; pre-deploy / plan / apply / drift / sync-argocd / post-deploy / pipeline (Flavors: eks, ecs-fargate, ec2-compact)&lt;br&gt;  - &lt;b&gt;Azure:&lt;/b&gt; pre-deploy / plan / apply / drift / apply-workloads / rollback / post-deploy / pipeline (AKS primary &amp; secondary data planes)&lt;br&gt;  - &lt;b&gt;GCP:&lt;/b&gt; pre-deploy / plan / apply / drift / apply-workloads / rollback / post-deploy / pipeline (GKE primary &amp; secondary data planes)&lt;br&gt;• &lt;b&gt;DevSecOps Core Engine:&lt;/b&gt; platform-common.ps1 (Unified root module for non-cascading shift-left static gates, binary plan lifecycle, delivery drivers, Gatekeeper admission, and live dynamic DAST/testing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="630" width="840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_scripts" parent="1" value="&lt;b&gt;📂 AUTOMATION SCRIPTS PORTFOLIO (scripts/)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="960" y="580" width="880" height="340" as="geometry" />
        </mxCell>
        <mxCell id="scripts_map" parent="1" value="• &lt;b&gt;Platform CLIs:&lt;/b&gt; platform-minikube.ps1 (Local) &amp; platform-multicloud.ps1 (AWS, Azure, GCP); Unified Engine in platform-common.ps1&lt;br&gt;• &lt;b&gt;platform-common.ps1:&lt;/b&gt; Centralized core module for Gitleaks, TFLint, Trivy, Conftest OPA, Cosign, Graphviz, binary plan apply, drift, delivery &amp; post-deploy DAST/k6/Newman&lt;br&gt;• &lt;b&gt;scripts/bcdr-simulation.ps1:&lt;/b&gt; Disaster recovery GameDay simulation &amp; backup verification runner&lt;br&gt;• &lt;b&gt;scripts/bootstrap-keycloak.ps1:&lt;/b&gt; Keycloak realm, roles, local test users, public SPA/confidential automation clients, secret sync&lt;br&gt;• &lt;b&gt;scripts/build-all.py:&lt;/b&gt; Concurrent Maven + React container image compiler&lt;br&gt;• &lt;b&gt;scripts/testing/smoke.py:&lt;/b&gt; Storefront deployment and resilience load smoke gate&lt;br&gt;• &lt;b&gt;scripts/testing/simulate.py:&lt;/b&gt; E-commerce traffic and chaos simulation suite&lt;br&gt;• &lt;b&gt;scripts/testing/diagnose.py:&lt;/b&gt; Unified standalone component, telemetry, and authenticated order diagnostics&lt;br&gt;• &lt;b&gt;scripts/generate-secure-secrets.py:&lt;/b&gt; High-entropy CSPRNG credential &amp; JWT secret generator&lt;br&gt;• &lt;b&gt;scripts/local-cost-estimator.py:&lt;/b&gt; Unified FinOps suite (architecture estimates, Terraform plan-delta &amp; K8s right-sizing)&lt;br&gt;• &lt;b&gt;Terraform FinOps budgets:&lt;/b&gt; Opt-in monthly AWS, Azure, and GCP spend notifications&lt;br&gt;• &lt;b&gt;scripts/validate-opencost.sh:&lt;/b&gt; Pinned OpenCost and cloud Prometheus chart rendering for CI&lt;br&gt;• &lt;b&gt;scripts/supervise-tunnels.py:&lt;/b&gt; Resilient background port-forward supervisor (includes OpenCost UI :7000)&lt;br&gt;• &lt;b&gt;scripts/update_dashboards.py:&lt;/b&gt; Unified Grafana dashboard generator, live publisher, and demo telemetry CLI&lt;br&gt;• &lt;b&gt;scripts/generate_drawio.py:&lt;/b&gt; 13-page architectural blueprint generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="980" y="630" width="840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="ops_box_11" parent="1" value="&lt;b&gt;🎯 MULTI-CLOUD PLATFORM SUMMARY&lt;/b&gt;: AWS, Azure, and GCP use provider-specific modules with a consistent dev/staging/prod workspace model. Each provider plans four Kubernetes clusters (one dev, one staging, two production); Minikube is a local development platform, not full cloud parity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="940" width="1780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_cicd_rollback_arch" name="12. Multi-Cloud CI/CD &amp; Recovery Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t12" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MULTI-CLOUD CI/CD &amp; RECOVERY ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;GitHub Actions publishes the immutable GHCR chart • Azure DevOps and Bitbucket consume its pinned version • Terraform exposes the shared chart coordinates&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_gha_argo" parent="1" value="&lt;b&gt;🐙 GITHUB ACTIONS (CI) + ARGOCD (CD)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;AWS EKS &amp; Minikube Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="570" height="500" as="geometry" />
        </mxCell>
        <mxCell id="gha_ci_box" parent="1" value="&lt;b&gt;GitHub Actions (CI) + ArgoCD (GitOps CD):&lt;/b&gt;&lt;br&gt;• 1-6. Shift-Left: Unit tests, Gitleaks, TFLint, Trivy, Conftest OPA, Cosign&lt;br&gt;• 7-8. Push certified image to ECR and trigger ArgoCD sync (platform-multicloud.ps1 sync-argocd -Provider aws)&lt;br&gt;• 9-12. Post-Deploy Gates: Newman contract, storefront smoke, k6 SLO, OWASP ZAP DAST&lt;br&gt;• Automated recovery triggers if ArgoCD sync or post-deploy checks fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="150" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="argo_cd_box" parent="1" value="&lt;b&gt;ArgoCD (Strictly CD - GitOps):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;develop:&lt;/b&gt; &lt;code&gt;application-dev.yaml&lt;/code&gt; ➔ Minikube (&lt;code&gt;dev&lt;/code&gt; ns)&lt;br&gt;• &lt;b&gt;staging:&lt;/b&gt; &lt;code&gt;application-staging.yaml&lt;/code&gt; ➔ configured staging cluster (&lt;code&gt;staging&lt;/code&gt; ns)&lt;br&gt;• &lt;b&gt;main/master:&lt;/b&gt; &lt;code&gt;application-prod.yaml&lt;/code&gt; ➔ configured production cluster (&lt;code&gt;production&lt;/code&gt; ns)&lt;br&gt;• Applications remain Git-sourced; OCI migration awaits package publication and registry access&lt;br&gt;• Reconciliation and rollback remain separate from Terraform state recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="310" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="argo_roll_box" parent="1" value="&lt;b&gt;🔄 Recovery Controls:&lt;/b&gt;&lt;br&gt;• Revert desired-state Git commits for normal recovery&lt;br&gt;• Check auto-sync before using ArgoCD's emergency rollback&lt;br&gt;• Terraform state locks are recovered manually after investigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="80" y="490" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_azdo" parent="1" value="&lt;b&gt;🔷 AZURE DEVOPS (SINGLE UNIFIED PIPELINE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Azure Cloud &amp; AKS Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="90" width="570" height="500" as="geometry" />
        </mxCell>
        <mxCell id="azdo_stages" parent="1" value="&lt;b&gt;Shared Azure DevOps application template (14 numbered stages + rollbacks):&lt;/b&gt;&lt;br&gt;• Per-service roots: frontend, inventory, orders, products, notification&lt;br&gt;• Cosmo Router has separate config/supergraph validation&lt;br&gt;• 1-6. Shift-Left: Tests, security, image/SBOM, policy and ACR candidate&lt;br&gt;• 7-8,14. Deploy directly to AKS via Helm umbrella chart (platform-multicloud.ps1 apply-workloads -Provider azure)&lt;br&gt;• 9-13. Post-Deploy Gates: Newman, Cypress, k6, OWASP ZAP DAST, and atomic Helm rollback (platform-multicloud.ps1 rollback -Provider azure)&lt;br&gt;• Production canary awaits its production-specific Istio manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="150" width="530" height="240" as="geometry" />
        </mxCell>
        <mxCell id="azdo_tf_box" parent="1" value="&lt;b&gt;Terraform Azure validation (pipelines/infra.yml):&lt;/b&gt;&lt;br&gt;• Workspaces: &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, &lt;code&gt;prod&lt;/code&gt;&lt;br&gt;• Reads umbrella chart metadata and exposes repository/version/reference outputs&lt;br&gt;• fmt/init/validate only; cloud plan/apply awaits Blob state and locking&lt;br&gt;• &lt;code&gt;infra-stages.yml&lt;/code&gt; remains a saved-plan/apply helper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="410" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c_bb" parent="1" value="&lt;b&gt;🪣 BITBUCKET PIPELINES (SINGLE UNIFIED PIPELINE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Google Cloud Platform &amp; GKE Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#064E3B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1260" y="90" width="580" height="500" as="geometry" />
        </mxCell>
        <mxCell id="bb_stages" parent="1" value="&lt;b&gt;Bitbucket pipelines: 14 numbered stages per branch:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;develop/staging:&lt;/b&gt; verification, environment image publish/deploy, API and storefront gates&lt;br&gt;• &lt;b&gt;main/master:&lt;/b&gt; QA, manual promotion of the same image SHA and rolling release&lt;br&gt;• Deploy directly to GKE via Helm umbrella chart (platform-multicloud.ps1 apply-workloads -Provider gcp)&lt;br&gt;• Post-Deploy Gates: Newman contract, k6 SLA, OWASP ZAP DAST, and atomic Helm rollback (platform-multicloud.ps1 rollback -Provider gcp)&lt;br&gt;• Helm uses &lt;code&gt;--atomic&lt;/code&gt;; post-deploy QA recovery is operator-led" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="150" width="540" height="240" as="geometry" />
        </mxCell>
        <mxCell id="bb_tf_box" parent="1" value="&lt;b&gt;Terraform GCP validation (apply disabled):&lt;/b&gt;&lt;br&gt;• Workspaces: &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, &lt;code&gt;prod&lt;/code&gt;; prod has two GKE clusters&lt;br&gt;• Exposes the same GHCR chart repository/version/reference outputs&lt;br&gt;• Partial GCS backend; CI uses &lt;code&gt;-backend=false&lt;/code&gt;&lt;br&gt;• Cloud apply awaits durable state and locking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="410" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c_roll_matrix" parent="1" value="&lt;b&gt;🛡️ AUTOMATED ROLLBACK &amp; INCIDENT RECOVERY MATRIX&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="610" width="1780" height="290" as="geometry" />
        </mxCell>
        <mxCell id="rm_1" parent="1" value="&lt;b&gt;Level 1: IaC State Lock Recovery&lt;/b&gt;&lt;br&gt;• Operator inspects failed run and confirms no active operation&lt;br&gt;• Uses the real backend lock ID for manual recovery&lt;br&gt;• No automatic unlock on apply failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_2" parent="1" value="&lt;b&gt;Level 2: GitOps Recovery&lt;/b&gt;&lt;br&gt;• Revert the desired-state commit in Git&lt;br&gt;• ArgoCD reconciles the restored revision&lt;br&gt;• Emergency CLI rollback requires checking auto-sync behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="520" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_3" parent="1" value="&lt;b&gt;Level 3: Helm Recovery&lt;/b&gt;&lt;br&gt;• &lt;code&gt;--atomic&lt;/code&gt; reverts a failed readiness/upgrade operation&lt;br&gt;• Post-deploy QA failure blocks promotion; operator assesses and rolls back if needed&lt;br&gt;• Bitbucket production uses manual rolling release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="960" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_4" parent="1" value="&lt;b&gt;Level 4: Production &amp; GitOps Recovery&lt;/b&gt;&lt;br&gt;• Provider-specific rollback and ArgoCD Git revert/rollback&lt;br&gt;• Bitbucket is not configured for production canary&lt;br&gt;• Terraform state locks are recovered manually after inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="1400" y="660" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_banner" parent="1" value="&lt;b&gt;🎯 RECOVERY ASSURANCE:&lt;/b&gt; Helm restores the previous release for failed atomic upgrades. Post-deployment QA and production incidents follow the explicit provider/operator recovery paths above; Terraform state locks are never force-released automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="790" width="1740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ops_box_12" parent="1" value="&lt;b&gt;🎯 IMMUTABLE CHART DELIVERY&lt;/b&gt;: GitHub Actions is the only publisher to GHCR; Azure DevOps and Bitbucket deploy the exact Chart.yaml version; AWS/Azure/GCP Terraform outputs expose the same pin across all workspaces. ArgoCD Applications remain Git-sourced until GHCR publication and pull access are configured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="920" width="1780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_devsecops_lifecycle" name="13. The 5-Phase End-to-End Delivery Lifecycle">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t13" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;THE 5-PHASE END-TO-END DELIVERY LIFECYCLE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Enterprise DevSecOps governance • Automated quality and security gates • Continuous reliability feedback&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="260" y="25" width="1400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="phase1_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 1&lt;br&gt;PORTFOLIO &amp;amp; ARCHITECTURE CONCEPTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Business / PO&lt;/b&gt;&lt;br&gt;Business need and value-stream hypothesis&lt;br&gt;&lt;br&gt;&lt;b&gt;Enterprise &amp;amp; Solution Architect&lt;/b&gt;&lt;br&gt;Baseline architecture and technical feasibility&lt;br&gt;Architecture Decision Record (ADR) and approved MVP scope&lt;br&gt;&lt;br&gt;&lt;b&gt;Cybersecurity Lead&lt;/b&gt;&lt;br&gt;STRIDE threat modeling and abuse cases" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1">
          <mxGeometry x="50" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase2_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 2&lt;br&gt;AGILE REFINEMENT &amp;amp; CONSTRUCTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Business / PO → Dev Team&lt;/b&gt;&lt;br&gt;Refined user stories and acceptance criteria&lt;br&gt;&lt;br&gt;&lt;b&gt;Dev Team &amp;amp; Tech Lead&lt;/b&gt;&lt;br&gt;Test-Driven Development (TDD), clean code, and local pre-commit linting&lt;br&gt;Versioned Flyway database migrations and Terraform infrastructure as code&lt;br&gt;Open pull request to &lt;code&gt;develop&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;" vertex="1">
          <mxGeometry x="418" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase3_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 3&lt;br&gt;AUTOMATED QUALITY &amp;amp; SECURITY GATES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CI/CD Pipeline (automated)&lt;/b&gt;&lt;br&gt;1. Unit tests and JaCoCo coverage ≥ 80%&lt;br&gt;2. SAST: SonarQube Quality Gate&lt;br&gt;3. SCA and secret scanning: Trivy and Gitleaks&lt;br&gt;4. IaC policy checks: Checkov / OPA&lt;br&gt;&lt;br&gt;&lt;b&gt;Pipeline output&lt;/b&gt;&lt;br&gt;Build artifacts and container images delivered to the Dev Team" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#064E3B;" vertex="1">
          <mxGeometry x="786" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase4_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 4&lt;br&gt;STAGING VALIDATION &amp;amp; PROMOTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CI/CD → SRE / Platform&lt;/b&gt;&lt;br&gt;Deploy to staging with Helm / ArgoCD&lt;br&gt;&lt;br&gt;&lt;b&gt;Automated validation&lt;/b&gt;&lt;br&gt;5. Newman API contract check: 23/23 pass (inc. MLOps)&lt;br&gt;6. k6 load and SLO benchmark: p95 &amp;lt; 200 ms&lt;br&gt;7. OWASP ZAP baseline DAST&lt;br&gt;&lt;br&gt;&lt;b&gt;Production promotion&lt;/b&gt;&lt;br&gt;Istio canary rollout: 10% → 100%" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#7F1D1D;" vertex="1">
          <mxGeometry x="1154" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="phase5_delivery" parent="1" value="&lt;b style='font-size:15px;'&gt;PHASE 5&lt;br&gt;CONTINUOUS RELIABILITY &amp;amp; FEEDBACK LOOP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SRE / Platform / Observability&lt;/b&gt;&lt;br&gt;Distributed tracing (Jaeger) and metrics (Prometheus / Grafana)&lt;br&gt;&lt;br&gt;&lt;b&gt;ServiceNow / Incident Management&lt;/b&gt;&lt;br&gt;Anomaly trigger / PagerAlert&lt;br&gt;P1/P2 incident root-cause analysis and blameless post-mortem&lt;br&gt;&lt;br&gt;&lt;b&gt;Dev Team → Business / PO&lt;/b&gt;&lt;br&gt;Add preventive technical-debt stories to the backlog" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1">
          <mxGeometry x="1522" y="135" width="340" height="600" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_1" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase1_delivery" target="phase2_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_2" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase2_delivery" target="phase3_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_3" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase3_delivery" target="phase4_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_flow_4" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" source="phase4_delivery" target="phase5_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle_feedback" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#8B5CF6;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" source="phase5_delivery" target="phase1_delivery">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1692" y="785" />
              <mxPoint x="220" y="785" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lifecycle_feedback_label" parent="1" value="&lt;b&gt;↶ CONTINUOUS FEEDBACK:&lt;/b&gt; Incident learning and preventive backlog stories inform the next portfolio and architecture cycle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;fontColor=#4C1D95;fontSize=12;align=center;verticalAlign=middle;" vertex="1">
          <mxGeometry x="360" y="820" width="1200" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
