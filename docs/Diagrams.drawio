  <diagram id="page_multicloud_automation" name="11. Multi-Cloud IaC &amp; CLI Automation Suite">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t11" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MULTI-CLOUD INFRASTRUCTURE (AWS • AZURE • GCP) &amp; AUTOMATION SUITE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;12 Kubernetes clusters: 4 per provider (dev, staging, two prod) • 3 workspaces per provider • Unified CLI &amp; FinOps&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_aws" parent="1" value="&lt;b&gt;☁️ AMAZON WEB SERVICES (AWS)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/aws/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="aws_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; shared VPC per environment&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; EKS dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; RDS PostgreSQL 18 (Multi-AZ)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; ElastiCache Redis 7.1 Replication&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Amazon MSK (Apache Kafka 3.6)&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; S3 Assets Bucket (SSE-KMS, Versioning)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; AWS KMS (CMK Key &amp; Alias)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; IAM IRSA (OIDC Trust Provider)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Network Load Balancer (NLB L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; CloudFront + WAFv2 (S3 Static SPA + NLB Dynamic API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; CloudWatch Alarms &amp; Dashboards&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Route53 Zone + Apex Alias to CloudFront + ACM SSL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="150" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_azure" parent="1" value="&lt;b&gt;☁️ MICROSOFT AZURE CLOUD&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/azure/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="90" width="570" height="470" as="geometry" />
        </mxCell>
        <mxCell id="azure_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; VNet + dedicated prod AKS subnets&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; AKS dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; Azure PostgreSQL Flexible Server (HA)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; Azure Cache for Redis (TLS 1.2)&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Azure Event Hubs (Kafka Surface)&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; Azure Storage Account (Blob Containers)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Azure Key Vault (Soft-delete, Purge)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; Azure Workload Identity (Federated Creds)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Azure Standard Load Balancer (L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; Front Door Premium (Storage Blob SPA + AKS SLB API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; Azure Monitor (Log Analytics, App Insights)&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Azure DNS Zone + Custom Apex Records to Front Door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="150" width="530" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_gcp" parent="1" value="&lt;b&gt;☁️ GOOGLE CLOUD PLATFORM (GCP)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;terraform/modules/gcp/ (dev • staging • prod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#064E3B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1260" y="90" width="580" height="470" as="geometry" />
        </mxCell>
        <mxCell id="gcp_m1" parent="1" value="• &lt;b&gt;Networking:&lt;/b&gt; Google Cloud VPC + Cloud NAT; separate secondary ranges for prod dp2&lt;br&gt;• &lt;b&gt;Kubernetes:&lt;/b&gt; GKE Autopilot dev + staging; two independent prod clusters/data planes (dp1, dp2)&lt;br&gt;• &lt;b&gt;Database:&lt;/b&gt; Cloud SQL PostgreSQL 18 (HA)&lt;br&gt;• &lt;b&gt;Cache:&lt;/b&gt; Cloud Memorystore for Redis 7.2&lt;br&gt;• &lt;b&gt;Messaging:&lt;/b&gt; Managed Kafka / Cloud PubSub &amp; DLQ&lt;br&gt;• &lt;b&gt;Storage:&lt;/b&gt; Google Cloud Storage (CMEK, Uniform Access)&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Google Cloud KMS (KeyRing &amp; CryptoKey)&lt;br&gt;• &lt;b&gt;Identity:&lt;/b&gt; GCP Workload Identity (GSA to KSA)&lt;br&gt;• &lt;b&gt;Ingress (Model 2):&lt;/b&gt; Istio Ingress + Passthrough Network Load Balancer (L4)&lt;br&gt;• &lt;b&gt;Dual-Origin CDN:&lt;/b&gt; Cloud Armor + Cloud CDN (GCS Bucket SPA + Istio NLB API)&lt;br&gt;• &lt;b&gt;Observability:&lt;/b&gt; Cloud Monitoring (Dashboards &amp; Alerts)&lt;br&gt;• &lt;b&gt;DNS:&lt;/b&gt; Cloud DNS Managed Zone + Global A-Record to Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="150" width="540" height="390" as="geometry" />
        </mxCell>
        <mxCell id="c_cli" parent="1" value="&lt;b&gt;🚀 UNIFIED PLATFORM CLI ORCHESTRATOR (.\platform.ps1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="580" width="880" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cli_commands" parent="1" value="• &lt;code&gt;.\platform.ps1 up [-Platform minikube|aws|azure|gcp] [-Environment dev|staging|prod]&lt;/code&gt;: Multi-platform bootstrap&lt;br&gt;• &lt;code&gt;.\platform.ps1 doctor [-Platform &lt;name&gt;]&lt;/code&gt;: Deep diagnostic health audit of pods, nodeports, metrics and OPA policies&lt;br&gt;• &lt;code&gt;.\platform.ps1 cost&lt;/code&gt;: Live OpenCost namespace allocation for current Kubernetes context; &lt;code&gt;finops -Environment &amp;lt;env&amp;gt;&lt;/code&gt;: offline illustrative architecture estimate&lt;br&gt;• &lt;code&gt;.\platform.ps1 tools [-Install]&lt;/code&gt;: Audit/install of 18 documented CLI tools&lt;br&gt;• &lt;code&gt;.\platform.ps1 rollback [-Platform &lt;name&gt;] [-LockId &lt;id&gt;]&lt;/code&gt;: Explicit state-lock recovery and deployment rollback&lt;br&gt;• &lt;code&gt;.\platform.ps1 plan / apply [-Platform &lt;name&gt;]&lt;/code&gt;: Multi-cloud Terraform infrastructure provisioning&lt;br&gt;• &lt;code&gt;.\platform.ps1 urls&lt;/code&gt;: Interactive live table of all active frontend, API, IAM, and observability endpoints&lt;br&gt;• &lt;code&gt;.\platform.ps1 smoke / tunnels / secrets / graph / diagrams&lt;/code&gt;: Verification, background port-forwarding, CSPRNG secrets &amp; Draw.io sync&lt;br&gt;• &lt;code&gt;.\platform.ps1 down / destroy [-Destroy]&lt;/code&gt;: Graceful resource pause or complete multi-cloud / Minikube purge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="630" width="840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_scripts" parent="1" value="&lt;b&gt;📂 AUTOMATION SCRIPTS PORTFOLIO (scripts/)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="960" y="580" width="880" height="340" as="geometry" />
        </mxCell>
        <mxCell id="scripts_map" parent="1" value="• &lt;b&gt;Unified Master CLI:&lt;/b&gt; platform.ps1 (Multi-cloud lifecycle, diagnostics, live OpenCost cost, offline finops)&lt;br&gt;• &lt;b&gt;scripts/bootstrap-keycloak.ps1:&lt;/b&gt; Keycloak realm, roles, local test users, public SPA/confidential automation clients, secret sync&lt;br&gt;• &lt;b&gt;scripts/build-all.py:&lt;/b&gt; Concurrent Maven + React container image compiler&lt;br&gt;• &lt;b&gt;scripts/endpoint-smoke-test.py:&lt;/b&gt; Synthetic post-deployment health &amp; latency SLO validator&lt;br&gt;• &lt;b&gt;scripts/generate-secure-secrets.py:&lt;/b&gt; High-entropy CSPRNG credential &amp; JWT secret generator&lt;br&gt;• &lt;b&gt;scripts/local-cost-estimator.py:&lt;/b&gt; Offline illustrative architecture estimate (not provider billing)&lt;br&gt;• &lt;b&gt;scripts/validate-opencost.sh:&lt;/b&gt; Pinned OpenCost and cloud Prometheus chart rendering for CI&lt;br&gt;• &lt;b&gt;scripts/supervise-tunnels.py:&lt;/b&gt; Resilient background port-forward supervisor (includes OpenCost UI :7000)&lt;br&gt;• &lt;b&gt;scripts/update_dashboards.py:&lt;/b&gt; Dashboard generator; live Grafana publishing is opt-in and credentialed&lt;br&gt;• &lt;b&gt;scripts/generate_drawio.py:&lt;/b&gt; 12-page architectural blueprint generator&lt;br&gt;• &lt;b&gt;scripts/testing/:&lt;/b&gt; simulate.py (Apollo Router; Keycloak-authenticated traffic/chaos; explicit anonymous DDoS mode), smoke.py, verify.py, check.py, read-only test_order.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="980" y="630" width="840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="ops_box_11" parent="1" value="&lt;b&gt;🎯 ENTERPRISE PLATFORM SUMMARY&lt;/b&gt;: True cloud-agnostic architecture offering identical 12-tier functionality across AWS, Azure, and GCP, fully operational locally on Minikube with 100% cloud parity, zero cloud costs, and managed by a single unified CLI entrypoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="940" width="1780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_cicd_rollback_arch" name="12. Multi-Cloud CI/CD &amp; Automated Rollback Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t12" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MULTI-CLOUD CI/CD &amp; AUTOMATED ROLLBACK ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;GitHub Actions (CI) + ArgoCD (CD) • Azure DevOps (Unified 14+ Stages) • Bitbucket Pipelines (Unified 14+ Stages) • Emergency Rollback Engines&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="25" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_gha_argo" parent="1" value="&lt;b&gt;🐙 GITHUB ACTIONS (CI) + ARGOCD (CD)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;AWS EKS &amp; Minikube Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#78350F;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="90" width="570" height="500" as="geometry" />
        </mxCell>
        <mxCell id="gha_ci_box" parent="1" value="&lt;b&gt;GitHub Actions (Strictly CI - Stages 1-5):&lt;/b&gt;&lt;br&gt;• 1. Unit Tests (Maven/React, JaCoCo Coverage)&lt;br&gt;• 2. SAST &amp; Secrets (Gitleaks + Semgrep Rules)&lt;br&gt;• 3. Build Container &amp; CycloneDX SBOM (Trivy)&lt;br&gt;• 4. Container Vulnerability Scan (Trivy CRITICAL/HIGH)&lt;br&gt;• 5. Compliance &amp; Policy Gate (Conftest / OPA)&lt;br&gt;• 6. Certified Image Push to AWS ECR&lt;br&gt;• 7. Trigger ArgoCD GitOps Sync via CLI/API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="150" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="argo_cd_box" parent="1" value="&lt;b&gt;ArgoCD (Strictly CD - GitOps):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;develop:&lt;/b&gt; &lt;code&gt;application-dev.yaml&lt;/code&gt; ➔ Minikube (&lt;code&gt;dev&lt;/code&gt; ns)&lt;br&gt;• &lt;b&gt;staging:&lt;/b&gt; &lt;code&gt;application-staging.yaml&lt;/code&gt; ➔ configured staging cluster (&lt;code&gt;staging&lt;/code&gt; ns)&lt;br&gt;• &lt;b&gt;main/master:&lt;/b&gt; &lt;code&gt;application-prod.yaml&lt;/code&gt; ➔ configured production cluster (&lt;code&gt;production&lt;/code&gt; ns)&lt;br&gt;• Automated reconciliation and rollback remain separate from Terraform state recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="310" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="argo_roll_box" parent="1" value="&lt;b&gt;🔄 Recovery Controls:&lt;/b&gt;&lt;br&gt;• ArgoCD retries reconciliation with configured backoff&lt;br&gt;• Application rollback restores a prior healthy release&lt;br&gt;• Terraform state locks are never force-released automatically; operators use the actual lock ID after investigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="80" y="490" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_azdo" parent="1" value="&lt;b&gt;🔷 AZURE DEVOPS (SINGLE UNIFIED PIPELINE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Azure Cloud &amp; AKS Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="660" y="90" width="570" height="500" as="geometry" />
        </mxCell>
        <mxCell id="azdo_stages" parent="1" value="&lt;b&gt;Single Pipeline Covering All 14+ Stages:&lt;/b&gt;&lt;br&gt;• 1. Maven / React Tests &amp; JaCoCo Coverage&lt;br&gt;• 2. SAST (Semgrep, Gitleaks, Checkov, SonarQube)&lt;br&gt;• 3. BuildKit Image Build &amp; CycloneDX SBOM&lt;br&gt;• 4. Aqua Trivy Image Vulnerability Scan&lt;br&gt;• 5. Conftest / OPA Kubernetes Manifest Verification&lt;br&gt;• &lt;b&gt;Stage 5.5:&lt;/b&gt; Deploy AKS Dev (branch &lt;code&gt;develop&lt;/code&gt;, ns &lt;code&gt;dev&lt;/code&gt;) + &lt;b&gt;RollbackDev&lt;/b&gt;&lt;br&gt;• 6. Deploy AKS Staging (branch &lt;code&gt;staging&lt;/code&gt;/PR, ns &lt;code&gt;staging&lt;/code&gt;)&lt;br&gt;• 7-10. Newman QA, Cypress E2E, k6 Latency, OWASP ZAP DAST&lt;br&gt;• &lt;b&gt;RollbackStaging:&lt;/b&gt; Automated Helm rollback on test failure&lt;br&gt;• 11. Certified Image Promotion &amp; Push to ACR&lt;br&gt;• 12. Deploy AKS Production (Istio Canary 90/10, ns &lt;code&gt;production&lt;/code&gt;)&lt;br&gt;• &lt;b&gt;RollbackProduction:&lt;/b&gt; Emergency rollback &amp; Istio route restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="150" width="530" height="240" as="geometry" />
        </mxCell>
        <mxCell id="azdo_tf_box" parent="1" value="&lt;b&gt;Terraform Azure Pipeline (pipelines/infra.yml):&lt;/b&gt;&lt;br&gt;• Workspaces: &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, &lt;code&gt;prod&lt;/code&gt;&lt;br&gt;• Static fmt/init/validate checks only; cloud apply is disabled until durable remote state and locking are configured&lt;br&gt;• Then add reviewed saved-plan applies behind environment gates&lt;br&gt;• No automatic state force-unlock; legacy pipeline is trigger-disabled and validation-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="680" y="410" width="530" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c_bb" parent="1" value="&lt;b&gt;🪣 BITBUCKET PIPELINES (SINGLE UNIFIED PIPELINE)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Google Cloud Platform &amp; GKE Ecosystem&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#064E3B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="1260" y="90" width="580" height="500" as="geometry" />
        </mxCell>
        <mxCell id="bb_stages" parent="1" value="&lt;b&gt;Single Pipeline Covering All 14+ Stages:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;develop:&lt;/b&gt; CI (1-5) ➔ GCP Terraform Dev (ws &lt;code&gt;dev&lt;/code&gt;) ➔ GKE Dev Deploy (ns &lt;code&gt;dev&lt;/code&gt;) ➔ &lt;b&gt;rollback-gke-dev&lt;/b&gt; on error&lt;br&gt;• &lt;b&gt;staging:&lt;/b&gt; CI (1-5) ➔ GCP Terraform Staging (ws &lt;code&gt;staging&lt;/code&gt;, Medium Perf) ➔ GKE Staging Deploy (ns &lt;code&gt;staging&lt;/code&gt;) ➔ QA Validation (Newman, Cypress, k6, ZAP DAST) ➔ GAR Push ➔ &lt;b&gt;rollback-gke-staging&lt;/b&gt; on test fail&lt;br&gt;• &lt;b&gt;main / master:&lt;/b&gt; CI (1-5) ➔ GCP Terraform Prod (ws &lt;code&gt;prod&lt;/code&gt;, High Perf HA) ➔ Pre-flight QA ➔ GAR Push ➔ GKE Production Canary (Istio 90/10) ➔ &lt;b&gt;rollback-gke-production&lt;/b&gt; on rollout fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="150" width="540" height="240" as="geometry" />
        </mxCell>
        <mxCell id="bb_tf_box" parent="1" value="&lt;b&gt;Terraform GCP validation (apply disabled):&lt;/b&gt;&lt;br&gt;• Environment workspaces: &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, &lt;code&gt;prod&lt;/code&gt;&lt;br&gt;• Production topology defines two independent GKE clusters with distinct control-plane and Pod/Service ranges&lt;br&gt;• Shared databases and networking stay once per environment&lt;br&gt;• CI apply remains disabled until durable remote state and locking are configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1280" y="410" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c_roll_matrix" parent="1" value="&lt;b&gt;🛡️ AUTOMATED ROLLBACK &amp; INCIDENT RECOVERY MATRIX&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E293B;fontSize=12;dashed=1;" vertex="1">
          <mxGeometry x="60" y="610" width="1780" height="290" as="geometry" />
        </mxCell>
        <mxCell id="rm_1" parent="1" value="&lt;b&gt;Level 1: IaC State Lock Recovery&lt;/b&gt;&lt;br&gt;• Operator inspects failed run and confirms no active operation&lt;br&gt;• Uses the real backend lock ID for manual recovery&lt;br&gt;• No automatic unlock on apply failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_2" parent="1" value="&lt;b&gt;Level 2: Automated GitOps Rollback&lt;/b&gt;&lt;br&gt;• ArgoCD CLI app rollback&lt;br&gt;• Reverts to previous certified Git revision&lt;br&gt;• SelfHeal restores desired cluster state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="520" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_3" parent="1" value="&lt;b&gt;Level 3: Helm Atomic Rollback&lt;/b&gt;&lt;br&gt;• Executes &lt;code&gt;helm rollback&lt;/code&gt; on QA failure&lt;br&gt;• Protects &lt;code&gt;dev&lt;/code&gt;, &lt;code&gt;staging&lt;/code&gt;, and &lt;code&gt;production&lt;/code&gt;&lt;br&gt;• Zero residual orphaned resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="960" y="660" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_4" parent="1" value="&lt;b&gt;Level 4: Istio Canary Shift Abort&lt;/b&gt;&lt;br&gt;• Health probe failure triggers 100% v1 shift&lt;br&gt;• Re-applies baseline DestinationRule &amp; VS&lt;br&gt;• Customer-facing traffic unaffected (&amp;lt;1s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1400" y="660" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rm_banner" parent="1" value="&lt;b&gt;🎯 ZERO DOWNTIME &amp; SELF-HEALING ASSURANCE:&lt;/b&gt; Application rollback is automated at configured health gates. Terraform failures require plan review and deliberate state-lock recovery using the actual lock ID; pipelines never unlock state automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="790" width="1740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ops_box_12" parent="1" value="&lt;b&gt;🎯 MULTI-CLOUD CI/CD SUMMARY&lt;/b&gt;: GitHub Actions strictly governs CI while ArgoCD operates declarative CD. Azure DevOps and Bitbucket Pipelines execute single unified pipelines with all 14+ stages, multi-cloud Terraform provisioning across dev/staging/prod workspaces, and fully automated rollback engines." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="60" y="920" width="1780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>