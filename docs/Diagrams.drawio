  </diagram>
  <diagram id="page_precedence" name="5. Secret Isolation &amp; Configuration Precedence">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" parent="1" value="&lt;b style=&#39;font-size:22px;color:#1E293B;&#39;&gt;CONFIGURATION PRECEDENCE &amp; SECRET ISOLATION HIERARCHY&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px;color:#64748B;&#39;&gt;Why zero collisions or race conditions exist between Spring Cloud Vault, Sidecar, ESO, and .env&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" value="&lt;b&gt;LEVEL 1: Operating System Environment Variables (Highest Priority)&lt;/b&gt;&lt;br&gt;• Local &lt;b&gt;.env&lt;/b&gt; file in Docker Compose&lt;br&gt;• Injected secrets from &lt;b&gt;Vault Agent Sidecar&lt;/b&gt; (/vault/secrets/database.env)&lt;br&gt;• Standard Kubernetes Secret mounted via &lt;b&gt;External Secrets Operator (ESO)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Overrides any packaged or static application configuration.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="130" width="1100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" value="&lt;b&gt;LEVEL 2: Active Profile Properties (application-vault.yml)&lt;/b&gt;&lt;br&gt;• Active &lt;b&gt;strictly&lt;/b&gt; when passing &lt;code&gt;--spring.profiles.active=vault&lt;/code&gt;&lt;br&gt;• Connects directly via REST API to Vault Server to load secrets into JVM memory&lt;br&gt;• &lt;i&gt;If the &#39;vault&#39; profile is not active, this bootstrap configuration remains totally inert.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="260" width="1100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" value="&lt;b&gt;LEVEL 3: Base Application Properties (application.yml)&lt;/b&gt;&lt;br&gt;• Default fallback properties packaged inside the Spring Boot JAR&lt;br&gt;• Parameterized placeholders: &lt;code&gt;${SPRING_DATASOURCE_URL:...}&lt;/code&gt;&lt;br&gt;• Acts as a safe fallback when no environment variables or Vault profiles are supplied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="390" width="1100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_conclusion" parent="1" value="&lt;b&gt;🎯 ZERO-COLLISION ARCHITECTURAL GUARANTEE:&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Fast Local Development:&lt;/b&gt; Run &lt;code&gt;docker compose up -d&lt;/code&gt; (Reads .env directly with zero friction).&lt;br&gt;2. &lt;b&gt;Direct Java Vault Testing:&lt;/b&gt; Run &lt;code&gt;mvn spring-boot:run -Dspring-boot.run.profiles=vault&lt;/code&gt;.&lt;br&gt;3. &lt;b&gt;Kubernetes / Minikube:&lt;/b&gt; Use &lt;code&gt;External Secrets Operator (ESO)&lt;/code&gt; to sync secrets into K8s without code changes.&lt;br&gt;4. &lt;b&gt;Multi-Cloud Production:&lt;/b&gt; Use &lt;code&gt;Vault Agent Sidecar&lt;/code&gt; with KMS Auto-Unseal and Cloud Workload Identity / IRSA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="520" width="1100" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_k8s_topo" name="6. Kubernetes &amp; Minikube Cluster Topology">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" parent="1" value="&lt;b style=&#39;font-size:22px;color:#1E293B;&#39;&gt;KUBERNETES &amp; MINIKUBE CLUSTER TOPOLOGY&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px;color:#64748B;&#39;&gt;Namespace isolation, ServiceAccount identities, RBAC Auth Delegator, and Istio Service Mesh&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
