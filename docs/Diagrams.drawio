          <mxGeometry x="140" y="520" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_inv" parent="1" value="&lt;b&gt;Pod: inventory-service&lt;/b&gt;&lt;br&gt;App Container (8001)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style=&#39;color:#059669;&#39;&gt;Stock Validation &amp; Lock Engine&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="540" y="520" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_notif" parent="1" value="&lt;b&gt;Pod: notification-service&lt;/b&gt;&lt;br&gt;App Container (8002)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style=&#39;color:#059669;&#39;&gt;Event Driven Consumer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="520" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ie1" parent="1" value="Rotates X.509 certs (24h)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DB2777;strokeWidth=1.5;dashed=1;" edge="1" source="i_istiod" target="pod_gw">
          <mxGeometry relative="1" as="geometry" />
