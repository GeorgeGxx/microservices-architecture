  <diagram id="page_vault_arch" name="2. HashiCorp Vault - Zero-Touch Security Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;HASHICORP VAULT - ZERO-TOUCH ENTERPRISE SECURITY ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Automated provisioning, least-privilege policy isolation, and advanced cryptographic engines&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_box_init" parent="1" value="&lt;b&gt;1. STARTUP PHASE (Zero-Touch)&lt;/b&gt;&lt;br&gt;compose.yaml: vault-init container&lt;br&gt;• Waits for Vault to be healthy&lt;br&gt;• Enables KV-v2, Transit, Database, Audit&lt;br&gt;• Seeds microservices credentials&lt;br&gt;• Exits cleanly (exit 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=12;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="120" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v_box_server" parent="1" value="&lt;b&gt;2. HASHICORP VAULT SERVER&lt;/b&gt;&lt;br&gt;Core Security Engine (Port 8200)&lt;br&gt;• Token &amp; Kubernetes Authentication&lt;br&gt;• Policy Enforcement Engine&lt;br&gt;• Telemetry &amp; Prometheus metrics&lt;br&gt;• Real-time Audit logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="580" y="120" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_kv" parent="1" value="&lt;b&gt;KV-v2 Secrets Engine&lt;/b&gt;&lt;br&gt;secret/application&lt;br&gt;secret/products-service&lt;br&gt;secret/orders-service&lt;br&gt;secret/inventory-service&lt;br&gt;secret/notification-service&lt;br&gt;secret/api-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="100" y="320" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_db" parent="1" value="&lt;b&gt;Dynamic Database Engine&lt;/b&gt;&lt;br&gt;database/config/postgres-products&lt;br&gt;database/roles/products-db-role&lt;br&gt;• On-the-fly user creation&lt;br&gt;• Automatic 1h TTL&lt;br&gt;• Auto-drop on expiration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="380" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_tr" parent="1" value="&lt;b&gt;Transit Encryption Engine&lt;/b&gt;&lt;br&gt;transit/keys/microservices-data-key&lt;br&gt;• Encryption as a Service&lt;br&gt;• AES256-GCM96&lt;br&gt;• Protects Credit Cards &amp; PII&lt;br&gt;• Zero app key storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="700" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_pki" parent="1" value="&lt;b&gt;PKI Certificate Engine&lt;/b&gt;&lt;br&gt;pki_int (Intermediate CA)&lt;br&gt;• Emits ca-cert.pem / root-cert.pem&lt;br&gt;• Signs istio-system/cacerts&lt;br&gt;• Zero-Trust mTLS Mesh Trust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#831843;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="1020" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="app_compose" parent="1" value="&lt;b&gt;Approach A: Docker Compose&lt;/b&gt;&lt;br&gt;Default fast startup via .env&lt;br&gt;Zero friction, fallback guaranteed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="100" y="520" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_spring" parent="1" value="&lt;b&gt;Approach B: Native Spring Boot&lt;/b&gt;&lt;br&gt;--spring.profiles.active=vault&lt;br&gt;application-vault.yml in all 5 apps&lt;br&gt;Spring Cloud Vault direct connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="420" y="520" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_eso" parent="1" value="&lt;b&gt;Approach C: External Secrets (ESO)&lt;/b&gt;&lt;br&gt;K8s SecretStore &amp; ExternalSecret&lt;br&gt;Syncs to microservices-secrets&lt;br&gt;Zero sidecar RAM footprint (Recommended)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="760" y="520" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_sidecar" parent="1" value="&lt;b&gt;Approach D: Vault Agent Sidecar&lt;/b&gt;&lt;br&gt;vault.hashicorp.com/agent-inject&lt;br&gt;Injects /vault/secrets/database.env&lt;br&gt;Multi-Cloud production standard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="1120" y="520" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pol_box" parent="1" value="&lt;b&gt;LEAST-PRIVILEGE ACCESS POLICIES (Service-Level Isolation)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;products-service-policy:&lt;/b&gt; READ secret/data/products-service + secret/data/application&lt;br&gt;• &lt;b&gt;orders-service-policy:&lt;/b&gt; READ secret/data/orders-service + secret/data/application&lt;br&gt;• &lt;b&gt;inventory-service-policy:&lt;/b&gt; READ secret/data/inventory-service + secret/data/application&lt;br&gt;• &lt;b&gt;notification-service-policy:&lt;/b&gt; READ secret/data/notification-service + secret/data/application&lt;br&gt;• &lt;b&gt;api-gateway-policy:&lt;/b&gt; READ secret/data/api-gateway + secret/data/application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="100" y="660" width="1320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ve1" parent="1" value="Seeds All Engines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A855F7;strokeWidth=2;" edge="1" source="v_box_init" target="v_box_server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve2" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_kv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve3" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve4" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_tr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve5" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_pki">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_rotation_seq" name="3. Sequence - Dynamic Database Secret Rotation">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;DYNAMIC DATABASE SECRET ROTATION SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Ephemeral user generation, automated revocation, and transparent lease renewals&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act_docker" parent="1" value="&lt;b&gt;1. Docker / K8s&lt;br&gt;Bootstrap&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;" vertex="1">
          <mxGeometry x="100" y="110" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act_pg" parent="1" value="&lt;b&gt;2. PostgreSQL&lt;br&gt;(db-products)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=12;" vertex="1">
          <mxGeometry x="380" y="110" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act_vault" parent="1" value="&lt;b&gt;3. HashiCorp&lt;br&gt;Vault Server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=12;" vertex="1">
          <mxGeometry x="660" y="110" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act_ms" parent="1" value="&lt;b&gt;4. Microservice&lt;br&gt;(products-service)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;" vertex="1">
          <mxGeometry x="940" y="110" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="line_docker" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="190" y="160" width="10" height="680" as="geometry" />
        </mxCell>
        <mxCell id="line_pg" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="470" y="160" width="10" height="680" as="geometry" />
        </mxCell>
        <mxCell id="line_vault" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="750" y="160" width="10" height="680" as="geometry" />
        </mxCell>
        <mxCell id="line_ms" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1030" y="160" width="10" height="680" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" value="1. Initialize DB with master admin credentials (postgres/postgres from .env)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="190" y="200" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" value="2. vault-init stores master connection in database/config/postgres-products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="190" y="270" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" value="3. Microservice requests DB connection: GET database/creds/products-db-role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="750" y="340" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" value="4. Vault executes in Postgres: CREATE ROLE 'v-token-prod-a1b2' PASSWORD 'X#9...' VALID UNTIL 1h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="470" y="410" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" value="5. Vault delivers dynamic user 'v-token-prod-a1b2' &amp; temporary password (Lease TTL: 1h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="750" y="480" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" value="6. Microservice opens JDBC connection pool using the ephemeral user credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="470" y="550" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" value="⏰ &lt;b&gt;1 HOUR ELAPSES (Lease TTL Expiration)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=12;align=center;" vertex="1">
          <mxGeometry x="380" y="620" width="680" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" value="7. Vault destroys previous user in Postgres: DROP ROLE 'v-token-prod-a1b2'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="470" y="680" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" value="8. Vault generates &amp; issues new user 'v-token-prod-c3d4' with zero service downtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="470" y="750" width="560" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_istio_mesh" name="4. Istio Service Mesh &amp; Zero-Trust mTLS">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;ISTIO SERVICE MESH - ZERO-TRUST MTLS &amp; TRAFFIC SHAPING&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;STRICT mTLS security with SPIFFE identities, Vault Intermediate CA, and progressive Canary releases&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="i_ingress" parent="1" value="&lt;b&gt;🌐 ISTIO INGRESS GATEWAY&lt;/b&gt;&lt;br&gt;microservices-gateway (Port 80 / 443)&lt;br&gt;TLS Termination • Edge Routing to Mesh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=12;" vertex="1">
          <mxGeometry x="100" y="140" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i_istiod" parent="1" value="&lt;b&gt;🛡️ ISTIOD CONTROL PLANE&lt;/b&gt;&lt;br&gt;Citadel CA &amp; Discovery Server&lt;br&gt;Mounted Secret: &lt;b&gt;istio-system/cacerts&lt;/b&gt;&lt;br&gt;(Signed by Vault PKI Intermediate CA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=2;fontColor=#831843;fontSize=12;" vertex="1">
          <mxGeometry x="500" y="140" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i_mesh_box" parent="1" value="&lt;b&gt;🔒 ZERO-TRUST SERVICE MESH (PeerAuthentication: STRICT mTLS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="100" y="280" width="1340" height="480" as="geometry" />
        </mxCell>
        <mxCell id="pod_gw" parent="1" value="&lt;b&gt;Pod: api-gateway&lt;/b&gt;&lt;br&gt;App Container (8080)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style='color:#059669;'&gt;spiffe://cluster.local/ns/ecommerce/sa/api-gateway&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="140" y="350" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_prod_v1" parent="1" value="&lt;b&gt;Pod: products-service (v1 - 90%)&lt;/b&gt;&lt;br&gt;App Container (8004)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style='color:#059669;'&gt;spiffe://cluster.local/ns/ecommerce/sa/products-service&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="540" y="350" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_prod_v2" parent="1" value="&lt;b&gt;Pod: products-service (v2 Canary - 10%)&lt;/b&gt;&lt;br&gt;App Container (8004)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style='color:#059669;'&gt;Canary Release (set-canary-weight.ps1)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="350" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_orders" parent="1" value="&lt;b&gt;Pod: orders-service&lt;/b&gt;&lt;br&gt;App Container (8003)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style='color:#059669;'&gt;Resilience4j Circuit Breaker &amp; Outlier Detection&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="140" y="520" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_inv" parent="1" value="&lt;b&gt;Pod: inventory-service&lt;/b&gt;&lt;br&gt;App Container (8001)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style='color:#059669;'&gt;Stock Validation &amp; Lock Engine&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="540" y="520" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pod_notif" parent="1" value="&lt;b&gt;Pod: notification-service&lt;/b&gt;&lt;br&gt;App Container (8002)&lt;br&gt;+ Envoy Sidecar Proxy&lt;br&gt;&lt;span style='color:#059669;'&gt;Event Driven Consumer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="960" y="520" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ie1" parent="1" value="Rotates X.509 certs (24h)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DB2777;strokeWidth=1.5;dashed=1;" edge="1" source="i_istiod" target="pod_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie2" parent="1" value="STRICT mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="pod_gw" target="pod_prod_v1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie3" parent="1" value="STRICT mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="pod_gw" target="pod_orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie4" parent="1" value="STRICT mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=2;" edge="1" source="pod_orders" target="pod_inv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_precedence" name="5. Secret Isolation &amp; Configuration Precedence">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;CONFIGURATION PRECEDENCE &amp; SECRET ISOLATION HIERARCHY&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Why zero collisions or race conditions exist between Spring Cloud Vault, Sidecar, ESO, and .env&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" value="&lt;b&gt;LEVEL 1: Operating System Environment Variables (Highest Priority)&lt;/b&gt;&lt;br&gt;• Local &lt;b&gt;.env&lt;/b&gt; file in Docker Compose&lt;br&gt;• Injected secrets from &lt;b&gt;Vault Agent Sidecar&lt;/b&gt; (/vault/secrets/database.env)&lt;br&gt;• Standard Kubernetes Secret mounted via &lt;b&gt;External Secrets Operator (ESO)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Overrides any packaged or static application configuration.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="130" width="1100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" value="&lt;b&gt;LEVEL 2: Active Profile Properties (application-vault.yml)&lt;/b&gt;&lt;br&gt;• Active &lt;b&gt;strictly&lt;/b&gt; when passing &lt;code&gt;--spring.profiles.active=vault&lt;/code&gt;&lt;br&gt;• Connects directly via REST API to Vault Server to load secrets into JVM memory&lt;br&gt;• &lt;i&gt;If the 'vault' profile is not active, this bootstrap configuration remains totally inert.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="260" width="1100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" value="&lt;b&gt;LEVEL 3: Base Application Properties (application.yml)&lt;/b&gt;&lt;br&gt;• Default fallback properties packaged inside the Spring Boot JAR&lt;br&gt;• Parameterized placeholders: &lt;code&gt;${SPRING_DATASOURCE_URL:...}&lt;/code&gt;&lt;br&gt;• Acts as a safe fallback when no environment variables or Vault profiles are supplied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="390" width="1100" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_conclusion" parent="1" value="&lt;b&gt;🎯 ZERO-COLLISION ARCHITECTURAL GUARANTEE:&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Fast Local Development:&lt;/b&gt; Run &lt;code&gt;docker compose up -d&lt;/code&gt; (Reads .env directly with zero friction).&lt;br&gt;2. &lt;b&gt;Direct Java Vault Testing:&lt;/b&gt; Run &lt;code&gt;mvn spring-boot:run -Dspring-boot.run.profiles=vault&lt;/code&gt;.&lt;br&gt;3. &lt;b&gt;Kubernetes / Minikube:&lt;/b&gt; Use &lt;code&gt;External Secrets Operator (ESO)&lt;/code&gt; to sync secrets into K8s without code changes.&lt;br&gt;4. &lt;b&gt;Multi-Cloud Production:&lt;/b&gt; Use &lt;code&gt;Vault Agent Sidecar&lt;/code&gt; with KMS Auto-Unseal and Cloud Workload Identity / IRSA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="200" y="520" width="1100" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_k8s_topo" name="6. Kubernetes &amp; Minikube Cluster Topology">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;KUBERNETES &amp; MINIKUBE CLUSTER TOPOLOGY&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Namespace isolation, ServiceAccount identities, RBAC Auth Delegator, and Istio Service Mesh&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ns_vault" parent="1" value="&lt;b&gt;🔒 NAMESPACE: vault&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="80" y="120" width="380" height="480" as="geometry" />
        </mxCell>
        <mxCell id="k_vault_pod" parent="1" value="&lt;b&gt;Deployment: vault&lt;/b&gt;&lt;br&gt;hashicorp/vault:2.0.4&lt;br&gt;Service: vault:8200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=12;" vertex="1">
          <mxGeometry x="110" y="180" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k_sa_vault" parent="1" value="&lt;b&gt;ServiceAccount: vault-auth&lt;/b&gt;&lt;br&gt;ClusterRoleBinding: system:auth-delegator&lt;br&gt;Validates Pod JWT tokens with K8s API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontSize=11;" vertex="1">
          <mxGeometry x="110" y="290" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k_script_auth" parent="1" value="&lt;b&gt;vault-k8s-auth-setup.ps1&lt;/b&gt;&lt;br&gt;Configures Kubernetes Auth Method&lt;br&gt;+ Least-Privilege Roles &amp; Policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontSize=11;" vertex="1">
          <mxGeometry x="110" y="400" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ns_istio" parent="1" value="&lt;b&gt;🌐 NAMESPACE: istio-system&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="500" y="120" width="380" height="480" as="geometry" />
        </mxCell>
        <mxCell id="k_istiod" parent="1" value="&lt;b&gt;Deployment: istiod&lt;/b&gt;&lt;br&gt;Istio Control Plane &amp; Citadel&lt;br&gt;Manages mTLS &amp; Envoy proxy configs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=12;" vertex="1">
          <mxGeometry x="530" y="180" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k_cacerts" parent="1" value="&lt;b&gt;Secret: cacerts&lt;/b&gt;&lt;br&gt;Intermediate CA from Vault PKI&lt;br&gt;ca-cert.pem / root-cert.pem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="530" y="290" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k_ingw" parent="1" value="&lt;b&gt;Deployment: istio-ingressgateway&lt;/b&gt;&lt;br&gt;Edge Proxy LoadBalancer (Port 80/443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="530" y="400" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ns_default" parent="1" value="&lt;b&gt;📦 NAMESPACE: ecommerce (Apps &amp; Databases)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="920" y="120" width="520" height="480" as="geometry" />
        </mxCell>
        <mxCell id="k_sa_apps" parent="1" value="&lt;b&gt;ServiceAccounts:&lt;/b&gt;&lt;br&gt;products-service • orders-service&lt;br&gt;inventory-service • notification-service • api-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=12;" vertex="1">
          <mxGeometry x="950" y="180" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k_eso_objs" parent="1" value="&lt;b&gt;External Secrets Operator (ESO):&lt;/b&gt;&lt;br&gt;SecretStore: vault-secret-store&lt;br&gt;ExternalSecret -&gt; Secret: microservices-secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="950" y="280" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k_apps_pods" parent="1" value="&lt;b&gt;Deployments &amp; Pods (Istio Sidecar Injected):&lt;/b&gt;&lt;br&gt;api-gateway • products-service • orders-service&lt;br&gt;inventory-service • notification-service • frontend&lt;br&gt;Postgres (products, orders, inventory, keycloak) • Kafka • Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="950" y="390" width="460" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_e2e_sequence" name="7. End-to-End Request Flow &amp; Order Processing Sequence">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t7" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;END-TO-END REQUEST FLOW &amp; ORDER PROCESSING SEQUENCE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;Complete journey: Angular 21 SPA ➔ Istio Ingress ➔ API Gateway ➔ Microservices ➔ Kafka ➔ Observability&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_fe" parent="1" value="&lt;b&gt;1. Frontend SPA&lt;br&gt;(Angular 21)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="80" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_igw" parent="1" value="&lt;b&gt;2. Istio Ingress&lt;br&gt;Gateway (80/443)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="280" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_kc" parent="1" value="&lt;b&gt;3. Keycloak IAM&lt;br&gt;(OAuth2 / PKCE)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
          <mxGeometry x="480" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_gw" parent="1" value="&lt;b&gt;4. API Gateway&lt;br&gt;(Spring Cloud)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=2;fontColor=#312E81;fontSize=11;" vertex="1">
          <mxGeometry x="680" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_redis" parent="1" value="&lt;b&gt;5. Redis 8.8&lt;br&gt;(Rate Limiter)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontColor=#7F1D1D;fontSize=11;" vertex="1">
          <mxGeometry x="880" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_ord" parent="1" value="&lt;b&gt;6. Orders Service&lt;br&gt;(Spring Boot 3.4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1080" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_prod_inv" parent="1" value="&lt;b&gt;7. Products &amp;&lt;br&gt;Inventory (DBs)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="1280" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_kafka" parent="1" value="&lt;b&gt;8. Kafka &amp;&lt;br&gt;Notification&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;" vertex="1">
          <mxGeometry x="1480" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_obs" parent="1" value="&lt;b&gt;9. LGTM Telemetry&lt;br&gt;(OTel/Tempo/Loki)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=11;" vertex="1">
          <mxGeometry x="1680" y="110" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l_fe" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="160" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_igw" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="360" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_kc" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="560" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_gw" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="760" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_redis" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="960" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_ord" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1160" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_prod_inv" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1360" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_kafka" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1560" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="l_obs" parent="1" value="" style="shape=line;strokeWidth=2;strokeColor=#CBD5E1;direction=south;" vertex="1">
          <mxGeometry x="1760" y="160" width="10" height="780" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" value="1. User initiates Self-Registration or Login in Angular 21 SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="160" y="190" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" value="2. Keycloak registers user, assigns default ROLE_USER, and issues signed JWT Access Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="160" y="240" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" value="3. HTTP POST /api/order (Authorization: Bearer &amp;lt;JWT&amp;gt;, traceparent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="160" y="290" width="200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st4" parent="1" value="4. Istio Ingress Gateway terminates edge TLS &amp; forwards via STRICT mTLS (SPIFFE ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="360" y="340" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st5" parent="1" value="5. API Gateway evaluates Redis Token Bucket Rate Limiter (20 req/s, burst 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="760" y="390" width="200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st6" parent="1" value="6. API Gateway verifies JWT cryptographic signature against Keycloak JWKS endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="560" y="440" width="200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st7" parent="1" value="7. API Gateway creates OTel span and proxies request to Orders Service over mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="760" y="490" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st8" parent="1" value="8. Orders Service calls Products Service (GET /api/product/{id}) to validate catalog &amp; price" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1160" y="540" width="200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st9" parent="1" value="9. Orders Service calls Inventory Service (POST /api/inventory/check-and-lock) to lock stock in db-inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1160" y="590" width="200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st10" parent="1" value="10. Orders Service binds authenticated userId/username and persists Order in db-orders (Multi-Tenant Isolation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1160" y="640" width="450" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st11" parent="1" value="11. Orders Service emits 'order-placed-topic' event to Apache Kafka cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1160" y="690" width="400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st12" parent="1" value="12. Orders Service returns HTTP 201 Created response ➔ API Gateway ➔ Frontend SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="160" y="740" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st13" parent="1" value="13. Notification Service asynchronously consumes Kafka event &amp; sends confirmation email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=10;align=left;spacingLeft=8;" vertex="1">
          <mxGeometry x="1560" y="790" width="150" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st14" parent="1" value="14. Continuous Observability: Prometheus tracks conversion funnels, loyalty cohorts, basket sizes, logistics pipelines, idempotency &amp; Grafana visualizes e-commerce business KPIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1">
          <mxGeometry x="760" y="840" width="1000" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_ecommerce_obs" name="8. Mature E-Commerce Observability Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t8" parent="1" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;MATURE E-COMMERCE OBSERVABILITY &amp; BUSINESS INTELLIGENCE (5 DIMENSIONS)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;High-cardinality prevention (O(1) discrete cohorts), conversion funnel, 5-stage logistics state machine, and distributed saga resilience&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" value="&lt;b&gt;1. Financial &amp; Executive KPIs&lt;/b&gt;&lt;br&gt;• Net Completed Orders &amp; Revenue ($ USD)&lt;br&gt;• Average Order Value (AOV)&lt;br&gt;• Collected Taxes (IVA/Tax)&lt;br&gt;• Shipping Revenue (DHL Express)&lt;br&gt;• Total Units Sold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" value="&lt;b&gt;2. Conversion Funnel &amp; Cart&lt;/b&gt;&lt;br&gt;• Cart Additions (&lt;code&gt;ecommerce_cart_additions_total&lt;/code&gt;)&lt;br&gt;• Checkout Started (&lt;code&gt;ecommerce_checkout_started_total&lt;/code&gt;)&lt;br&gt;• Payment Step (&lt;code&gt;ecommerce_checkout_step_reached_total&lt;/code&gt;)&lt;br&gt;• Cart Abandonment Rate (%)&lt;br&gt;• Payment Brand &amp; Delivery Market Share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="460" y="120" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" value="&lt;b&gt;3. Inventory Intelligence&lt;/b&gt;&lt;br&gt;• Live Available Stock by SKU&lt;br&gt;• SKU Sales Market Share&lt;br&gt;• Stockout Incidents (&lt;code&gt;inventory_out_of_stock_events_total&lt;/code&gt;)&lt;br&gt;• Low Stock Warnings (&amp;lt;5 units)&lt;br&gt;• Warehouse Restock Operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="840" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" value="&lt;b&gt;4. 5-Stage Logistics Pipeline&lt;/b&gt;&lt;br&gt;• &lt;code&gt;PLACED&lt;/code&gt;: Order created &amp; inventory reserved&lt;br&gt;• &lt;code&gt;PAYMENT_CONFIRMED&lt;/code&gt;: Capture verified&lt;br&gt;• &lt;code&gt;PREPARING&lt;/code&gt;: Warehouse picking &amp; packing&lt;br&gt;• &lt;code&gt;SHIPPED&lt;/code&gt;: In transit with DHL tracking&lt;br&gt;• &lt;code&gt;DELIVERED&lt;/code&gt;: Final mile receipt confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="1200" y="120" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" value="&lt;b&gt;5. Distributed Consistency &amp; Resilience&lt;/b&gt;&lt;br&gt;• Duplicate Orders Prevented (Idempotency Hits)&lt;br&gt;• Saga Distributed Rollbacks &amp; Compensations&lt;br&gt;• Notification Kafka Processing Throughput &amp; Lag&lt;br&gt;• Resilience4j Circuit Breaker Health Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="320" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ret_box" parent="1" value="&lt;b&gt;CUSTOMER RETENTION &amp; BASKET DYNAMICS (O(1) Bounded Cardinality Architecture)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Problem:&lt;/b&gt; Tagging metrics with unbounded &lt;code&gt;username&lt;/code&gt; causes cardinality explosion (millions of time series in Prometheus TSDB).&lt;br&gt;• &lt;b&gt;Solution:&lt;/b&gt; Aggregation into discrete business cohorts: &lt;code&gt;first_time&lt;/code&gt;, &lt;code&gt;repeat&lt;/code&gt;, and &lt;code&gt;loyal_vip&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Basket Economics:&lt;/b&gt; Order volume segmentation by basket size: &lt;code&gt;single_item&lt;/code&gt;, &lt;code&gt;2_3_items&lt;/code&gt;, &lt;code&gt;bulk_4_plus&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="460" y="320" width="1060" height="160" as="geometry" />
        </mxCell>
        <mxCell id="dash_biz" parent="1" value="&lt;b&gt;📊 Grafana Dashboard: Curated Business Operations (10 High-Value Panels)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dynamic Filter:&lt;/b&gt; &lt;code&gt;Filter Microservice&lt;/code&gt; dropdown (All / Orders / Inventory / Products)&lt;br&gt;• &lt;b&gt;1. Executive Summary:&lt;/b&gt; Net Revenue, Net Orders, AOV &amp; Abandonment Rate (Safe Clamping)&lt;br&gt;• &lt;b&gt;2. Conversion &amp; Logistics:&lt;/b&gt; Funnel Stages &amp; 5-Stage Logistics Pipeline&lt;br&gt;• &lt;b&gt;3. Inventory &amp; Demand:&lt;/b&gt; Live Stock by SKU (Alerts &amp;lt;5) &amp; Top Selling SKUs Share&lt;br&gt;• &lt;b&gt;4. Customer Retention:&lt;/b&gt; Discrete Loyalty Cohorts (O(1)) &amp; Growth Timeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="100" y="520" width="700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="dash_tech" parent="1" value="&lt;b&gt;🛡️ Grafana Dashboard: Curated Technical &amp; SRE Operations (12 Essential Panels)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dynamic Filter:&lt;/b&gt; &lt;code&gt;Filter Microservice&lt;/code&gt; drilldown (All / Gateway / Orders / Inventory / Products / Notif)&lt;br&gt;• &lt;b&gt;1. Global Health:&lt;/b&gt; Core Microservices Online (5 Roles, Replica-Invariant), Global P95, Threat Level, Circuit Breakers&lt;br&gt;• &lt;b&gt;2. HTTP Golden Signals:&lt;/b&gt; Request Rate (RPS: 2xx/4xx/5xx) &amp; P95 Latency per Service&lt;br&gt;• &lt;b&gt;3. Distributed Resilience:&lt;/b&gt; Idempotency Hits, Saga Rollbacks &amp; Kafka Streaming Rate&lt;br&gt;• &lt;b&gt;4. Platform Saturation:&lt;/b&gt; JVM Heap Memory, CPU &amp; HikariCP Database Connection Pools (Active vs Total Pool Size)&lt;br&gt;• &lt;b&gt;5. Security &amp; Diagnostics:&lt;/b&gt; Blocked Attacks (HTTP 429) &amp; Incident Logs Stream (Loki)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="840" y="520" width="680" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
