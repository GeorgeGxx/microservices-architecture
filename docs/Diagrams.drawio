        <mxCell id="app_kiali" parent="1" value="&lt;b&gt;🧭 Kiali Visual Mesh&lt;/b&gt;&lt;br&gt;Port 20001 (/kiali)&lt;br&gt;Real-time Traffic Graph&lt;br&gt;mTLS Encryption Health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;" vertex="1">
