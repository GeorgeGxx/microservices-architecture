  <diagram id="page_enterprise_checkout" name="10. Enterprise E-Commerce, Logistics &amp; Social Proof Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t10" parent="1" value="&lt;b style=&#39;font-size:22px;color:#1E293B;&#39;&gt;ENTERPRISE E-COMMERCE, LOGISTICS &amp;amp; SOCIAL PROOF ARCHITECTURE (Amazon &amp;amp; Mercado Libre Alignment)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px;color:#64748B;&#39;&gt;Multi-Step Checkout • Address Persistence • Tiered Shipping • Real-Time Card Brand Detection • Logistics Stepper • DHL Tracking Engine • Catalog Ratings &amp;amp; Social Proof&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="250" y="30" width="1420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_fe_checkout" parent="1" value="&lt;b&gt;🛒 STOREFRONT CHECKOUT &amp;amp; LOGISTICS UI (Angular 21)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="60" y="110" width="460" height="680" as="geometry" />
        </mxCell>
        <mxCell id="n_step1" parent="1" value="&lt;b&gt;Step 1: Shipping Address &amp;amp; Profile&lt;/b&gt;&lt;br&gt;• Customer Name, Email, Phone, Address, City, Zip&lt;br&gt;• Persistent LocalStorage (msa_shipping_address)&lt;br&gt;• 1-Click Instant Address Auto-Fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="90" y="160" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n_step2" parent="1" value="&lt;b&gt;Step 2: Tiered Delivery Speed Selection&lt;/b&gt;&lt;br&gt;• Free Standard Shipping (3-5 Business Days, $0.00)&lt;br&gt;• ⚡ DHL Express Priority (24-48 Hours, $9.99)&lt;br&gt;• Real-time estimated delivery date calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="90" y="255" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n_step3" parent="1" value="&lt;b&gt;Step 3: Secure Payment &amp;amp; Card Brand Detection&lt;/b&gt;&lt;br&gt;• Real-time IIN/BIN recognition (Visa, Mastercard, AMEX)&lt;br&gt;• Cardholder, Card Number, MM/YY, CVV Validation&lt;br&gt;• 256-Bit SSL Encryption &amp;amp; PCI-DSS Compliance Badges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="90" y="350" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_sidebar" parent="1" value="&lt;b&gt;Sticky Financial Order Summary&lt;/b&gt;&lt;br&gt;• Subtotal Amount&lt;br&gt;• Dynamic Shipping Fee ($0.00 / $9.99)&lt;br&gt;• Estimated Tax (8%)&lt;br&gt;• Calculated Total Amount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="90" y="450" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_stepper_ui" parent="1" value="&lt;b&gt;Consumer Logistics Stepper (order-stepper)&lt;/b&gt;&lt;br&gt;• 1. Placed ➔ 2. Preparing in Hub ➔ 3. In Transit (DHL)&lt;br&gt;• 4. Out for Delivery ➔ 5. Delivered&lt;br&gt;• Live Tracking Pill (DHL-XXXXXXXX) &amp;amp; Express Badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="90" y="560" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n_catalog_ui" parent="1" value="&lt;b&gt;Catalog Social Proof &amp;amp; Star Ratings&lt;/b&gt;&lt;br&gt;• Star Rating (★ 4.8) &amp;amp; Review Count (1,240)&lt;br&gt;• #1 Best Seller Tag in Ecommerce Amber (#e67a00)&lt;br&gt;• Product Category Tag &amp;amp; ⚡ Fast Delivery Indicator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;fontColor=#831843;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="90" y="665" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_backend_ms" parent="1" value="&lt;b&gt;⚙️ CORE MICROSERVICES DOMAIN LOGIC (Spring Boot 3.4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=13;dashed=1;" vertex="1">
          <mxGeometry x="570" y="110" width="480" height="680" as="geometry" />
        </mxCell>
        <mxCell id="n_orders_logic" parent="1" value="&lt;b&gt;Orders Service (Port 8003)&lt;/b&gt;&lt;br&gt;• Generates Tracking Number: DHL-XXXXXXXX&lt;br&gt;• Assigns Carrier: &#39;DHL Express&#39;&lt;br&gt;• Computes: subtotalAmount, shippingFee, taxAmount, totalAmount&lt;br&gt;• Stores recipient: customerName, email, shippingAddress, city, postalCode, phone&lt;br&gt;• Emits enriched OrderEvent to Kafka orders-topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="600" y="160" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_db_orders_ext" parent="1" value="&lt;b&gt;PostgreSQL db-orders&lt;/b&gt;&lt;br&gt;Table: t_orders (Enriched schema)&lt;br&gt;Columns: tracking_number, carrier,&lt;br&gt;shipping_fee, tax_amount, total_amount,&lt;br&gt;customer_name, shipping_address, etc." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1">
          <mxGeometry x="710" y="300" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_products_logic" parent="1" value="&lt;b&gt;Products Service (Port 8004)&lt;/b&gt;&lt;br&gt;• Product Metadata: category, rating, reviewCount, isBestSeller&lt;br&gt;• Seeded in DataLoader with 4.6 - 4.9 ratings &amp;amp; 420 - 2,450 reviews&lt;br&gt;• Redis Cache Caching Layer: products-cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=12;" vertex="1">
          <mxGeometry x="600" y="420" width="420" height="85" as="geometry" />
        </mxCell>
