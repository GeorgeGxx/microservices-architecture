        <mxCell id="app_react" parent="1" value="&lt;b&gt;🌐 Frontend React 19&lt;/b&gt;&lt;br&gt;Vite dev :5173 • Nginx :8080&lt;br&gt;Tactical DDD &amp; Clean Arch&lt;br&gt;Compound UI &amp; Checkout FSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
