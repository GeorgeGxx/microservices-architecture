        </mxCell>
        <mxCell id="app_kc" parent="1" value="&lt;b&gt;🔑 Keycloak 26 IAM&lt;/b&gt;&lt;br&gt;Port 8181 (admin/admin)&lt;br&gt;Realm: microservices-realm&lt;br&gt;OIDC &amp; User Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=2;fontColor=#831843;fontSize=11;" vertex="1">
