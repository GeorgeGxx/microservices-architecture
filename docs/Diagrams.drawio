  <diagram id="page_vault_arch" name="2. HashiCorp Vault - Zero-Touch Security Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" value="&lt;b style=&#39;font-size:22px;color:#1E293B;&#39;&gt;HASHICORP VAULT - ZERO-TOUCH ENTERPRISE SECURITY ARCHITECTURE&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px;color:#64748B;&#39;&gt;Automated provisioning, least-privilege policy isolation, and advanced cryptographic engines&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=0;" vertex="1">
          <mxGeometry x="300" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v_box_init" parent="1" value="&lt;b&gt;1. STARTUP PHASE (Zero-Touch)&lt;/b&gt;&lt;br&gt;compose.yaml: vault-init container&lt;br&gt;• Waits for Vault to be healthy&lt;br&gt;• Enables KV-v2, Transit, Database, Audit&lt;br&gt;• Seeds microservices credentials&lt;br&gt;• Exits cleanly (exit 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;fontSize=12;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="100" y="120" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v_box_server" parent="1" value="&lt;b&gt;2. HASHICORP VAULT SERVER&lt;/b&gt;&lt;br&gt;Core Security Engine (Port 8200)&lt;br&gt;• Token &amp; Kubernetes Authentication&lt;br&gt;• Policy Enforcement Engine&lt;br&gt;• Telemetry &amp; Prometheus metrics&lt;br&gt;• Real-time Audit logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=12;align=left;spacingLeft=15;" vertex="1">
          <mxGeometry x="580" y="120" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_kv" parent="1" value="&lt;b&gt;KV-v2 Secrets Engine&lt;/b&gt;&lt;br&gt;secret/application&lt;br&gt;secret/products-service&lt;br&gt;secret/orders-service&lt;br&gt;secret/inventory-service&lt;br&gt;secret/notification-service&lt;br&gt;secret/api-gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="100" y="320" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_db" parent="1" value="&lt;b&gt;Dynamic Database Engine&lt;/b&gt;&lt;br&gt;database/config/postgres-products&lt;br&gt;database/roles/products-db-role&lt;br&gt;• On-the-fly user creation&lt;br&gt;• Automatic 1h TTL&lt;br&gt;• Auto-drop on expiration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="380" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_tr" parent="1" value="&lt;b&gt;Transit Encryption Engine&lt;/b&gt;&lt;br&gt;transit/keys/microservices-data-key&lt;br&gt;• Encryption as a Service&lt;br&gt;• AES256-GCM96&lt;br&gt;• Protects Credit Cards &amp; PII&lt;br&gt;• Zero app key storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="700" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e_pki" parent="1" value="&lt;b&gt;PKI Certificate Engine&lt;/b&gt;&lt;br&gt;pki_int (Intermediate CA)&lt;br&gt;• Emits ca-cert.pem / root-cert.pem&lt;br&gt;• Signs istio-system/cacerts&lt;br&gt;• Zero-Trust mTLS Mesh Trust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.5;fontColor=#831843;fontSize=11;align=left;spacingLeft=10;" vertex="1">
          <mxGeometry x="1020" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="app_compose" parent="1" value="&lt;b&gt;Approach A: Docker Compose&lt;/b&gt;&lt;br&gt;Default fast startup via .env&lt;br&gt;Zero friction, fallback guaranteed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="100" y="520" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_spring" parent="1" value="&lt;b&gt;Approach B: Native Spring Boot&lt;/b&gt;&lt;br&gt;--spring.profiles.active=vault&lt;br&gt;application-vault.yml in all 5 apps&lt;br&gt;Spring Cloud Vault direct connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="420" y="520" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_eso" parent="1" value="&lt;b&gt;Approach C: External Secrets (ESO)&lt;/b&gt;&lt;br&gt;K8s SecretStore &amp; ExternalSecret&lt;br&gt;Syncs to microservices-secrets&lt;br&gt;Zero sidecar RAM footprint (Recommended)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="760" y="520" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_sidecar" parent="1" value="&lt;b&gt;Approach D: Vault Agent Sidecar&lt;/b&gt;&lt;br&gt;vault.hashicorp.com/agent-inject&lt;br&gt;Injects /vault/secrets/database.env&lt;br&gt;Multi-Cloud production standard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=12;" vertex="1">
          <mxGeometry x="1120" y="520" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pol_box" parent="1" value="&lt;b&gt;LEAST-PRIVILEGE ACCESS POLICIES (Service-Level Isolation)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;products-service-policy:&lt;/b&gt; READ secret/data/products-service + secret/data/application&lt;br&gt;• &lt;b&gt;orders-service-policy:&lt;/b&gt; READ secret/data/orders-service + secret/data/application&lt;br&gt;• &lt;b&gt;inventory-service-policy:&lt;/b&gt; READ secret/data/inventory-service + secret/data/application&lt;br&gt;• &lt;b&gt;notification-service-policy:&lt;/b&gt; READ secret/data/notification-service + secret/data/application&lt;br&gt;• &lt;b&gt;api-gateway-policy:&lt;/b&gt; READ secret/data/api-gateway + secret/data/application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=12;align=left;spacingLeft=20;" vertex="1">
          <mxGeometry x="100" y="660" width="1320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ve1" parent="1" value="Seeds All Engines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A855F7;strokeWidth=2;" edge="1" source="v_box_init" target="v_box_server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve2" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_kv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve3" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ve4" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B5CF6;strokeWidth=1.5;" edge="1" source="v_box_server" target="e_tr">
          <mxGeometry relative="1" as="geometry" />
