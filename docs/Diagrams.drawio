        <mxCell id="e_dr_v1" parent="1" value="90% Weight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B981;strokeWidth=1.5;" edge="1" source="n_dr" target="n_v1">
