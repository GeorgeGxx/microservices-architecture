        <mxCell id="p_grafana" parent="1" value="&lt;b&gt;📊 Grafana Observability&lt;/b&gt;&lt;br&gt;Port 3000&lt;br&gt;Technical &amp; Business Dashboards&lt;br&gt;Prometheus + Loki + Tempo datasources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
          <mxGeometry x="1170" y="360" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_prom" parent="1" value="&lt;b&gt;📈 Prometheus Targets&lt;/b&gt;&lt;br&gt;Port 9090 (TSDB /targets)&lt;br&gt;15s Scrape Interval&lt;br&gt;Self/Loki/Tempo/Alloy health alerts&lt;br&gt;Persistent, bounded retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#064E3B;fontSize=10;" vertex="1">
          <mxGeometry x="1440" y="360" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="app_react" parent="1" value="&lt;b&gt;🌐 Frontend React 19&lt;/b&gt;&lt;br&gt;Vite dev :5173 • Nginx :8080&lt;br&gt;Tactical DDD &amp; Clean Arch&lt;br&gt;Compound UI &amp; Checkout FSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;" vertex="1">
