# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
ignore:
  'SNYK-GOLANG-STDCRYPTOX509-21400137':
    - '*':
        reason: 'CVE-2026-111943 / GO-2026-6809 (eMudhra CA denylist in crypto/x509) is patched in Go 1.26.10 (go.mod and Dockerfile). Ignored for Snyk IDE host runtime compatibility when host Go is 1.26.7.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-1':
    - '*':
        reason: 'Scoped to devsecops/policies/conftest/tests/invalid-workloads.yaml negative test fixture used to validate Conftest OPA Rego policy rejection.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-4':
    - '*':
        reason: 'Scoped to negative Conftest test fixture and local Minikube development exporter.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-5':
    - '*':
        reason: 'Scoped to negative Conftest test fixture.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-6':
    - '*':
        reason: 'Scoped to devsecops/policies/conftest/tests/invalid-workloads.yaml negative test fixture (all production workloads drop ALL capabilities).'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-8':
    - '*':
        reason: 'Scoped to negative Conftest test fixture and stateful local Minikube infrastructure pods.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-9':
    - '*':
        reason: 'Scoped to devsecops/policies/conftest/tests/invalid-workloads.yaml negative test fixture (all production workloads set allowPrivilegeEscalation: false).'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-10':
    - '*':
        reason: 'Scoped to negative Conftest test fixture and Grafana Alloy DaemonSet requiring root access to read /var/log/pods on Minikube.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-11':
    - '*':
        reason: 'Local development and upstream vendor manifests use standard non-root UIDs (1000).'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-37':
    - '*':
        reason: 'Grafana Alloy log collection DaemonSet requires hostPath mount for /var/log.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-K8S-47':
    - '*':
        reason: 'Stakater Reloader ClusterRole requires patch/update on workload controllers to trigger rolling restarts on Secret/ConfigMap rotation.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-TF-1':
    - '*':
        reason: 'Public ingress on 80/443 is intentional on internet-facing ingress load balancers.'
        expires: 2030-01-01T00:00:00.000Z
  'SNYK-CC-TF-215':
    - '*':
        reason: 'ElastiCache Redis is isolated inside private subnets with SG ingress restricted to EKS worker nodes and TLS transit encryption enabled.'
        expires: 2030-01-01T00:00:00.000Z
patch: {}
