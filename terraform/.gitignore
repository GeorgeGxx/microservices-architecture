# ==============================================================================
# TERRAFORM IGNORED FILES & LOCAL STATE
# ==============================================================================

# Local .terraform directories and plugin caches
**/.terraform/*
.terraform/
.terraform.lock.hcl

# Local state and backup files (Remote backend in AWS S3 is used)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars
!*.example.tfvars

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration files
.terraformrc
terraform.rc

# Execution plan files
*.tfplan
