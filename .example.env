# Microservice Service Discovery Endpoints (Direct Container DNS)
INVENTORY_SERVICE_URI=http://inventory-service:8001
ORDERS_SERVICE_URI=http://orders-service:8003
PRODUCTS_SERVICE_URI=http://products-service:8004
NOTIFICATION_SERVICE_URI=http://notification-service:8002

# Keycloak
# APP
KEYCLOAK_VERSION=26.7.3
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<password>
KC_HTTP_PORT=8181
KEYCLOAK_ISSUER_URI=http://keycloak:8181/realms/microservices-realm
KEYCLOAK_JWT_URI=http://keycloak:8181/realms/microservices-realm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_SECRET=<TU_CLIENT_SECRET>
# DataBase
KEYCLOAK_POSTGRES_VERSION=16-alpine
KEYCLOAK_POSTGRES_DB=db_keycloak

# api-gateway
# APP
GATEWAY_SERVICE_NAME=api-gateway
GATEWAY_PORT=8080

# frontend (Angular 19)
# APP
FRONTEND_PORT=4200
FRONTEND_PORT_INTERNAL=80

# inventory-service
# APP
INVENTORY_SERVICE_NAME=inventory-service
POSTGRES_VERSION=16-alpine
POSTGRES_PORT=5432
INVENTORY_SPRING_DATASOURCE_JDBC_URL=jdbc:postgresql://db-inventory:5432/ms_inventory
POSTGRES_DB=ms_inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>

# notification-service
# APP
NOTIFICATION_SERVICE_NAME=notification-service

# orders-service
# APP
ORDERS_SERVICE_NAME=orders-service
# DataBase
ORDERS_POSTGRES_VERSION=16-alpine
ORDERS_POSTGRES_DB=ms_orders
ORDERS_SPRING_DATASOURCE_JDBC_URL=jdbc:postgresql://db-orders:5432/ms_orders

# products-service
# APP
PRODUCTS_SERVICE_NAME=products-service
PRODUCTS_SPRING_DATASOURCE_JDBC_URL=jdbc:postgresql://db-products:5432/ms_products
# DataBase
PRODUCTS_POSTGRES_VERSION=16-alpine
PRODUCTS_POSTGRES_DB=ms_products

# KAFKA
KAFKA_VERSION=7.8.0
KAFKA_BOOTSTRAP_SERVERS=kafka:9094
KAFKA_CLUSTER_ID=GKDx6mu6RsOTU1ErbSukuQ
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,SASL_PLAINTEXT://0.0.0.0:9094,PLAINTEXT_HOST://0.0.0.0:29092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,SASL_PLAINTEXT://kafka:9094,PLAINTEXT_HOST://localhost:29092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SASL_PLAINTEXT:SASL_PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# KAFKA CREDENTIALS & SECURITY
KAFKA_APP_USER=app
KAFKA_APP_PASSWORD=<password>
KAFKA_ADMIN_USER=admin
KAFKA_ADMIN_PASSWORD=<password>

# Broker SASL JAAS Configuration (Kafka server-side user registry)
KAFKA_BROKER_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="admin" password="<password>" user_admin="<password>" user_app="<password>";

# Client SASL JAAS Configuration (Consumed by Spring Boot microservices)
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="app" password="<password>";
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=PLAIN
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="app" password="<password>";
KAFKA_OPTS=-Djava.security.auth.login.config=/dev/null
# JVM Performance Tuning (Optimized for Local Dev with 12 CPUs / 12GB RAM)
JAVA_TOOL_OPTIONS=-XX:+ExitOnOutOfMemoryError -XX:InitialRAMPercentage=40.0 -XX:MaxRAMPercentage=75.0 -XX:+TieredCompilation -XX:TieredStopAtLevel=1

# Redis
REDIS_VERSION=8.8.1-alpine
REDIS_PASSWORD=<password>
REDIS_PORT=6379
# Redis Exporter
REDIS_EXPORTER_VERSION=v1.82.0

# Prometheus / Grafana / Loki / Tempo / Alloy
PROM_VERSION=v3.13.1
GRAFANA_VERSION=13.0.7
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<password>
LOKI_VERSION=3.7.4
TEMPO_VERSION=3.0.3
TEMPO_PORT=3200
ALLOY_VERSION=v1.18.1

# OpenTelemetry (OTel)
# APP
OTEL_COLLECTOR_VERSION=0.159.0
OTEL_GRCP_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES=service.namespace=microservices

# HashiCorp Vault
VAULT_VERSION=2.0.4
VAULT_PORT=8200
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_ENABLED=false
VAULT_BACKEND=secret

# ArgoCD GitOps
ARGOCD_VERSION=3.5.2
ARGOCD_HELM_CHART_VERSION=10.8.0

# Security & Governance (OPA)
GATEKEEPER_VERSION=3.23.1

# Observability & Tracing Ecosystem
KUBE_PROMETHEUS_STACK_VERSION=89.2.2
TEMPO_FALLBACK_VERSION=2.7.0