{
  "title": "🔍 Grafana Alloy · Telemetry & Log Collector Pipeline",
  "uid": "grafana-alloy",
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "alloy",
    "observability",
    "lgtm",
    "logs",
    "metrics",
    "pipeline"
  ],
  "links": [
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "⚡ Open Native Alloy UI (Port 3300)",
      "tooltip": "Open the live Grafana Alloy interactive component dependency graph and controller state",
      "type": "link",
      "url": "http://localhost:3300/"
    },
    {
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "🛡️ Technical Operations Dashboard",
      "tooltip": "Switch to SRE Technical & Security Operations Dashboard",
      "type": "link",
      "url": "/d/technical-security"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "uid": "prometheus-ds",
          "type": "prometheus"
        },
        "definition": "label_values(up{job=~\"alloy.*\"}, job)",
        "query": {
          "query": "label_values(up{job=~\"alloy.*\"}, job)",
          "refId": "AlloyJobQuery"
        },
        "label": "Job",
        "includeAll": false,
        "current": {
          "text": "alloy",
          "value": "alloy"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "⚡ [EXECUTIVE STATUS & COLLECTOR HEALTH] Live Pipeline & Controller KPIs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Alloy Health Status",
      "description": "Scrape status of Grafana Alloy daemon from Prometheus TSDB.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "up{job=\"$job\"}",
          "legendFormat": "Status"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alloy Version",
      "description": "Version information emitted by alloy_build_info metric.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^version$/"
        },
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "alloy_build_info{job=\"$job\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Collector Uptime",
      "description": "Continuous process uptime of Grafana Alloy.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10b981"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "time() - process_start_time_seconds{job=\"$job\"}",
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Running Components",
      "description": "Total active healthy components managed by the Alloy pipeline controller.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{job=\"$job\", health_type=\"healthy\"}) or vector(0)",
          "legendFormat": "Healthy Components"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Config Load State",
      "description": "Status of the current loaded config.alloy file (1 = Success, 0 = Failed).",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "LOAD ERROR",
                  "color": "red"
                },
                "1": {
                  "text": "VALID & APPLIED",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "alloy_config_last_load_successful{job=\"$job\"} or vector(1)",
          "legendFormat": "Config State"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "📊 [RESOURCE SATURATION & RUNTIME PERFORMANCE] CPU, Memory & Go Runtime",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "CPU Usage Rate",
      "description": "User and system CPU utilization rate of the Alloy process.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "gradientMode": "opacity"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"$job\"}[1m])",
          "legendFormat": "CPU Usage"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Resident Memory (RSS) vs Container Limit (256MB)",
      "description": "Resident set size (RAM) consumed by Alloy compared to container limit.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "gradientMode": "opacity"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 150000000
              },
              {
                "color": "red",
                "value": 240000000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"$job\"}",
          "legendFormat": "RSS Memory"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "vector(268435456)",
          "legendFormat": "256MB Compose Limit"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Go Runtime Goroutines & GC Frequency",
      "description": "Active Go runtime concurrency threads (goroutines) and garbage collector frequency.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "go_goroutines{job=\"$job\"}",
          "legendFormat": "Goroutines"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "rate(go_gc_duration_seconds_count{job=\"$job\"}[1m]) * 60",
          "legendFormat": "GC Cycles/min"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "📈 [LOG PIPELINE & INGESTION THROUGHPUT] Docker / Kubernetes Log Forwarding to Loki",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Container Log Entries Ingestion Rate (lines/sec)",
      "description": "Rate of log records captured and forwarded from Docker / Pod containers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "gradientMode": "opacity"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(rate(loki_source_docker_target_entries_total{job=\"$job\"}[1m])) or sum(rate(loki_source_file_read_lines_total{job=\"$job\"}[1m])) or vector(0)",
          "legendFormat": "Ingested Log Entries/s"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Log Parsing Errors & Forwarding Drops",
      "description": "Errors encountered while reading container log streams or pushing to Loki.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(rate(loki_source_docker_target_parsing_errors_total{job=\"$job\"}[1m])) or vector(0)",
          "legendFormat": "Parsing Errors/s"
        }
      ]
    },
    {
      "id": 40,
      "type": "row",
      "title": "📑 [LIVE LOG STREAMS] Telemetry Records Collected by Alloy & Shipped to Loki",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 41,
      "type": "logs",
      "title": "Live Container Logs (Captured via Alloy & Shipped to Loki)",
      "description": "Live LogQL query across containers collected by Grafana Alloy with correlated service tags.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "uid": "loki-ds",
        "type": "loki"
      },
      "options": {
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "uid": "loki-ds",
            "type": "loki"
          },
          "expr": "{container=~\".+\"}",
          "legendFormat": "{{container}}"
        }
      ]
    }
  ]
}
