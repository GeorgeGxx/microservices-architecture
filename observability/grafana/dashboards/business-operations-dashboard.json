    {
      "id": 13,
      "type": "bargauge",
      "title": "\ud83c\udfaf Order Fulfillment Rate & Retention SLA Audit",
      "description": "Fulfillment efficiency & order retention audit: Delivery completion rate of dispatched shipments vs net order retention and cancellation rate (OCR).",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "round((sum(ecommerce_shipments_delivered_total) / clamp_min(sum(ecommerce_shipments_dispatched_total), 1)) * 100, 0.1)",
          "legendFormat": "Fulfillment Delivery Success Rate %"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "round((1 - ((max(ecommerce_orders{status=\"CANCELLED\"}) or vector(0)) / clamp_min((max(ecommerce_orders{status=\"COMPLETED\"}) or vector(0)) + (max(ecommerce_orders{status=\"CANCELLED\"}) or vector(0)), 1))) * 100, 0.1)",
          "legendFormat": "Net Order Retention Rate %"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "round(((max(ecommerce_orders{status=\"CANCELLED\"}) or vector(0)) / clamp_min((max(ecommerce_orders{status=\"COMPLETED\"}) or vector(0)) + (max(ecommerce_orders{status=\"CANCELLED\"}) or vector(0)), 1)) * 100, 0.1)",
          "legendFormat": "Order Cancellation Rate % (OCR)"
        }
      ]
    },
