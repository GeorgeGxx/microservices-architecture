{
  "title": "\ud83c\udfe2 E-Commerce Business Intelligence & Inventory Operations",
  "uid": "business-operations",
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
