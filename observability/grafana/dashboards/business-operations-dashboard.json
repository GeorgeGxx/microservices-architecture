  "tags": [
    "business",
    "ecommerce",
    "orders",
    "inventory",
    "revenue",
    "kpis"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "uid": "prometheus-ds",
          "type": "prometheus"
        },
        "definition": "label_values(up{service=~\"cosmo-router|orders-service|inventory-service|products-service|notification-service|payments-service|fulfillment-service|analytics-service|demand-forecast-service\"}, service)",
        "query": "label_values(up{service=~\"cosmo-router|orders-service|inventory-service|products-service|notification-service|payments-service|fulfillment-service|analytics-service|demand-forecast-service\"}, service)",
        "label": "Filter Microservice",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "\ud83d\udcb0 [EXECUTIVE BUSINESS SUMMARY] Top Financial & Operational KPIs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "\ud83d\udcb5 Net Sales Revenue",
      "description": "Total net monetary volume generated from active completed orders.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b82f6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "max(ecommerce_revenue_usd) or sum(ecommerce_revenue_usd_total) or vector(0)",
          "legendFormat": "Net Revenue USD"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "\ud83d\udce6 Resolved Orders (Completed + Cancelled)",
      "description": "Total terminal orders recorded by Analytics: completed plus cancelled. Pending orders are not included.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#60a5fa"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#60a5fa",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(max by (status) (ecommerce_orders{status=~\"COMPLETED|CANCELLED\"})) or sum(ecommerce_orders_total{status=~\"COMPLETED|CANCELLED\"}) or vector(0)",
          "legendFormat": "Resolved Orders"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "\ud83d\udcb8 Estimated Revenue at Risk from Cancellations ($)",
      "description": "Estimate: cancelled orders multiplied by the average completed-order revenue. It is a proxy, not the recorded value of cancelled orders.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 500
              },
              {
                "color": "#ef4444",
                "value": 1500
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "round((max(ecommerce_orders{status=\"CANCELLED\"}) or sum(ecommerce_orders_total{status=\"CANCELLED\"}) or vector(0)) * ((max(ecommerce_revenue_usd) or sum(ecommerce_revenue_usd_total) or vector(0)) / clamp_min(max(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(1), 1)), 0.01)",
          "legendFormat": "Estimated Lost Revenue"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "\ud83d\udecd\ufe0f Completed Orders",
      "description": "Completed order count from Analytics. Completed and cancelled are separate terminal statuses, so cancellations are not subtracted from this count.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10b981"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "max(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)",
          "legendFormat": "Completed Orders"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "\ud83c\udff7\ufe0f Average Order Value (AOV)",
      "description": "Average completed-order revenue: net sales revenue divided by completed orders.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8b5cf6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8b5cf6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "(max(ecommerce_revenue_usd) or sum(ecommerce_revenue_usd_total)) / clamp_min(max(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0), 1) or vector(0)",
          "legendFormat": "AOV"
        }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "\ud83d\udcc9 Cart Abandonment Rate",
      "description": "Percentage of created shopping carts not converted into finished purchases.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 50
              },
              {
                "color": "#ef4444",
                "value": 75
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "max(ecommerce_cart_abandonment_rate) or clamp_max(clamp_min((1 - (clamp_max(max(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0), scalar(sum(ecommerce_funnel_events_total{event_type=~\"(?i)cart_add.*\"}) or sum(ecommerce_cart_additions) or sum(ecommerce_cart_additions_total) or vector(0))) / clamp_min(sum(ecommerce_funnel_events_total{event_type=~\"(?i)cart_add.*\"}) or sum(ecommerce_cart_additions) or sum(ecommerce_cart_additions_total), 1))) * 100, 0), 100) or vector(0)",
          "legendFormat": "Abandonment"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "\ud83d\uded2 [CONVERSION FUNNEL & ORDER FULFILLMENT] Buyer Journey & Fulfillment Flow",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "\ud83d\uded2 E-Commerce Conversion Funnel Stages",
      "description": "Customer progression from Cart Additions -> Checkout Started -> Payment Step -> Completed Order.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b82f6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_funnel_events_total{event_type=~\"(?i)cart_add.*\"}) or sum(ecommerce_cart_additions) or sum(ecommerce_cart_additions_total) or vector(0)",
          "legendFormat": "Cart Additions"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_funnel_events_total{event_type=~\"(?i)checkout_start.*\"}) or sum(ecommerce_checkout_started) or sum(ecommerce_checkout_started_total) or vector(0)",
          "legendFormat": "Checkout Started"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_funnel_events_total{event_type=~\"(?i)checkout_step.*\",step=~\"(?i)payment.*|cart|\"}) or sum(ecommerce_funnel_events_total{event_type=~\"(?i)checkout_step.*\"}) or sum(ecommerce_checkout_step_reached{step=\"PAYMENT\"}) or sum(ecommerce_checkout_step_reached_total{step=\"PAYMENT\"}) or vector(0)",
          "legendFormat": "Payment Step"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "max(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)",
          "legendFormat": "Completed Orders"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "\ud83d\ude9a Active Orders Across Logistics Pipeline",
