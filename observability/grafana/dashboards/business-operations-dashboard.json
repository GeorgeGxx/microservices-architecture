{
  "title": "🏢 E-Commerce Business Intelligence & Inventory Operations",
  "uid": "business-operations",
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 40,
  "tags": [
    "business",
    "ecommerce",
    "orders",
    "inventory",
    "revenue",
    "kpis"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "uid": "prometheus-ds",
          "type": "prometheus"
        },
        "definition": "label_values(up{service=~\"orders-service|inventory-service|products-service|analytics-service|payments-service|fulfillment-service\"}, service)",
        "query": {
          "query": "label_values(up{service=~\"orders-service|inventory-service|products-service|analytics-service|payments-service|fulfillment-service\"}, service)",
          "refId": "StandardVariableQuery"
        },
        "label": "Filter Microservice",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "💰 [EXECUTIVE BUSINESS SUMMARY] Top Financial & Operational KPIs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "💵 Net Sales Revenue",
      "description": "Total net monetary volume generated from active completed orders.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b82f6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_revenue_usd) or sum(ecommerce_revenue_usd_total) or vector(0)",
          "legendFormat": "Net Revenue USD"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "📦 Gross Orders Placed",
      "description": "Total gross purchase orders placed and completed before cancellations.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#60a5fa"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#60a5fa",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)",
          "legendFormat": "Gross Orders"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "❌ Cancelled Orders & Loss",
      "description": "Total customer and administrator cancellations (revenue leakage audit).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 1
              },
              {
                "color": "#ef4444",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_orders{status=\"CANCELLED\"}) or sum(ecommerce_orders_total{status=\"CANCELLED\"}) or vector(0)",
          "legendFormat": "Cancelled Orders"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "🛍️ Net Completed Orders",
      "description": "True net purchase orders actively retained and fulfilled (Gross - Cancelled).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#10b981"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "clamp_min((sum(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)) - (sum(ecommerce_orders{status=\"CANCELLED\"}) or sum(ecommerce_orders_total{status=\"CANCELLED\"}) or vector(0)), 0)",
          "legendFormat": "Net Orders"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "🏷️ Average Order Value (AOV)",
      "description": "Average spend per net completed order ticket (Revenue / Net Orders).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8b5cf6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8b5cf6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "(sum(ecommerce_revenue_usd) or sum(ecommerce_revenue_usd_total)) / clamp_min(clamp_min((sum(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)) - (sum(ecommerce_orders{status=\"CANCELLED\"}) or sum(ecommerce_orders_total{status=\"CANCELLED\"}) or vector(0)), 0), 1) or vector(0)",
          "legendFormat": "AOV"
        }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "📉 Cart Abandonment Rate",
      "description": "Percentage of created shopping carts not converted into finished purchases.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 50
              },
              {
                "color": "#ef4444",
                "value": 75
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "(max(ecommerce_cart_abandonment_rate) > 0) or (((sum(ecommerce_funnel_events_total{event_type=~\"(?i)cart_add.*\"}) or sum(ecommerce_cart_additions) or sum(ecommerce_cart_additions_total) or vector(0)) > bool 0) * clamp_max(clamp_min((1 - ((sum(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)) / clamp_min((sum(ecommerce_funnel_events_total{event_type=~\"(?i)cart_add.*\"}) or sum(ecommerce_cart_additions) or sum(ecommerce_cart_additions_total)), 1))) * 100, 0), 100)) or vector(0)",
          "legendFormat": "Abandonment"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "🛒 [CONVERSION FUNNEL & ORDER FULFILLMENT] Buyer Journey & Fulfillment Flow",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "🛒 E-Commerce Conversion Funnel Stages",
      "description": "Customer progression from Cart Additions -> Checkout Started -> Payment Step -> Completed Order.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b82f6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_funnel_events_total{event_type=~\"(?i)cart_add.*\"}) or sum(ecommerce_cart_additions) or sum(ecommerce_cart_additions_total) or vector(0)",
          "legendFormat": "1. Cart Additions"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_funnel_events_total{event_type=~\"(?i)checkout_start.*\"}) or sum(ecommerce_checkout_started) or sum(ecommerce_checkout_started_total) or vector(0)",
          "legendFormat": "2. Checkout Started"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_funnel_events_total{event_type=~\"(?i)checkout_step.*\",step=~\"(?i)payment.*|cart|\"}) or sum(ecommerce_funnel_events_total{event_type=~\"(?i)checkout_step.*\"}) or sum(ecommerce_checkout_step_reached{step=\"PAYMENT\"}) or sum(ecommerce_checkout_step_reached_total{step=\"PAYMENT\"}) or vector(0)",
          "legendFormat": "3. Reached Payment"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(ecommerce_orders{status=\"COMPLETED\"}) or sum(ecommerce_orders_total{status=\"COMPLETED\"}) or vector(0)",
          "legendFormat": "4. Order Completed"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "🚚 Active Orders Across Logistics Pipeline",
