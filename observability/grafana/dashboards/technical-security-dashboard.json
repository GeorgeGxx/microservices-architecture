{
  "title": "🛡️ Microservices Architecture · Technical & Security Operations (SRE)",
  "uid": "technical-security",
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 10,
  "tags": [
    "spring-boot",
    "java21",
    "docker",
    "compose",
    "microservices",
    "security",
    "ddos",
    "sre",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "uid": "prometheus-ds",
          "type": "prometheus"
        },
        "definition": "label_values(up, service)",
        "query": {
          "query": "label_values(up, service)",
          "refId": "StandardVariableQuery"
        },
        "label": "Filter Microservice",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 50,
      "type": "row",
      "title": "🛡️ [SECURITY & DDoS ATTACK DETECTION] Real-Time Threat Analysis & Rate Limiting",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 51,
      "type": "stat",
      "title": "🚨 Security Attack Status & Threat Level",
      "description": "Monitors rate-limit rejections (HTTP 429) and error spikes. Switches to RED during DDoS simulation attacks.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 1
              },
              {
                "color": "#ef4444",
                "value": 5
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "text": "🛡️ SECURE · NORMAL",
                  "color": "#10b981"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 4.9,
                "result": {
                  "text": "⚠️ ELEVATED TRAFFIC",
                  "color": "#f59e0b"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 5,
                "to": 999999,
                "result": {
                  "text": "🚨 UNDER ATTACK · DDoS SURGE",
                  "color": "#ef4444"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"429|5..\"}[1m])) or vector(0))",
          "legendFormat": "Attack Rate"
        }
      ]
    },
    {
      "id": 52,
      "type": "stat",
      "title": "🛑 Blocked Attack Requests (HTTP 429)",
      "description": "Total botnet flood requests throttled and blocked by Spring Cloud Gateway / Redis Token Bucket.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#f59e0b",
                "value": 1
              },
              {
                "color": "#ef4444",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "(sum(increase(http_server_requests_seconds_count{status=\"429\"}[15m])) or vector(0))",
          "legendFormat": "Blocked 429s"
        }
      ]
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Gateway Attack & Rate-Limit Traffic Distribution",
      "description": "Real-time comparison between legitimate traffic (2xx), rate-limited attacks (429), and errors (5xx).",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"2..\"}[1m])) by (status)",
          "legendFormat": "Legitimate (2xx)"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\"}[1m])) by (status)",
          "legendFormat": "Throttled (429)"
        },
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (status)",
          "legendFormat": "Errors (5xx)"
        }
      ]
    },
    {
      "id": 54,
      "type": "bargauge",
      "title": "🏴‍☠️ Captured Attacker IPs (DDoS Botnet Interceptions)",
      "description": "Real-time count of blocked flood requests per attacker IP intercepted by Spring Cloud Gateway & Redis Tarpit.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#f59e0b",
                "value": null
              },
              {
                "color": "#ef4444",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "topk(10, sum by (ip, reason) (security_blocked_ip_total) or sum by (ip) (security_blocked_ip_total))",
          "legendFormat": "{{ip}} ({{reason}})"
        }
      ]
    },
    {
      "id": 55,
      "type": "logs",
      "title": "📜 DDoS Security & Auto-Ban Audit Stream (Loki)",
      "description": "Live audit logs capturing AUTO-BAN events and blocked attacker IP requests from Gateway filter.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "uid": "loki-ds",
        "type": "loki"
      },
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "uid": "loki-ds",
            "type": "loki"
          },
          "expr": "{container=~\".+\"} |= \"SECURITY-AUDIT\"",
          "legendFormat": "{{container}}"
        }
      ]
    },
