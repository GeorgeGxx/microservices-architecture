    {
      "id": 202,
      "type": "timeseries",
      "title": "P95 & Average Request Latency (ms)",
      "description": "Response time per microservice in milliseconds.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 9,
        "y": 17
