    {
      "id": 203,
      "type": "stat",
      "title": "⚡ Circuit Breakers State",
      "description": "Fault tolerance state per downstream service: CLOSED (Green / Healthy), OPEN (Red / Tripped), HALF_OPEN (Yellow / Testing).",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 17
      },
      "datasource": {
        "uid": "prometheus-ds",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.name}",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "#10b981"
                },
                "1": {
                  "text": "OPEN",
                  "color": "#ef4444"
                },
                "2": {
                  "text": "HALF_OPEN",
                  "color": "#f59e0b"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#10b981",
                "value": null
              },
              {
                "color": "#ef4444",
                "value": 1
              },
              {
                "color": "#f59e0b",
                "value": 2
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "sum by (name) ((resilience4j_circuitbreaker_state{state=\"open\"} == 1) * 1 or (resilience4j_circuitbreaker_state{state=\"half_open\"} == 1) * 2 or (resilience4j_circuitbreaker_state{state=\"closed\"} == 1) * 0)",
          "legendFormat": "{{name}}"
        }
      ]
    },
