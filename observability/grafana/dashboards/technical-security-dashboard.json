        "graphMode": "none",
        "noValue": "No data"
      },
      "targets": [
        {
          "datasource": {
            "uid": "prometheus-ds",
            "type": "prometheus"
          },
          "expr": "max(up{service=\"demand-forecast-service\"}) or vector(0)",
          "legendFormat": "Forecast API"
        }
