          },
          "expr": "((sum(rate(http_server_requests_seconds_sum[1m])) by (service) / sum(rate(http_server_requests_seconds_count[1m])) by (service)) * 1000) or (histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, service)) * 1000)",
          "legendFormat": "{{service}} Latency"
        }
